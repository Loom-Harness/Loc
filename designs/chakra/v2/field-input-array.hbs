{{#if rowFields}}<VStack align="stretch" spacing={2}>
          <Text fontWeight="medium">{{label}}</Text>
          { {{path}}Fields.map((field, index) => (
            <HStack key={field.id} align="flex-end">
{{#each rowFields}}{{#if (eq template "field-input-id-select")}}              <Controller control={control} name={`{{../path}}.${index}.{{path}}`} render={({ field, fieldState }) => (
                <FormControl isInvalid={!!fieldState.error}>
                  <FormLabel>{{label}}</FormLabel>
                  <Select data-testid={`{{../testId}}-${index}-{{path}}`} value={field.value as string ?? ""} onChange={(e) => field.onChange(e.target.value)}>
                    <option value="">{{{chrome "selectEmptyOption"}}}</option>
                    {({{{hookVar}}}.data?.items ?? []).map((__o) => (
                      <option key={__o.id} value={__o.id} data-testid={`{{../testId}}-${index}-{{path}}-option-${__o.id}`}>{__o["{{displayField}}"]}</option>
                    ))}
                  </Select>
                  <FormErrorMessage>{fieldState.error?.message}</FormErrorMessage>
                </FormControl>
              )} />
{{else}}              <FormControl isInvalid={!!({{rowErrorExpr}})}>
                <Input placeholder="{{label}}"{{#if (eq template "field-input-money")}} inputMode="decimal"{{/if}} {{#if (eq template "field-input-datetime")}}type="datetime-local" {{/if}}{...register(`{{../path}}.${index}.{{path}}`{{#if valueAsNumber}}, { valueAsNumber: true }{{/if}}{{#if (eq template "field-input-money")}}, { setValueAs: (v: string) => { try { return new Decimal(v || "0"); } catch { return new Decimal("0"); } } }{{/if}})} data-testid={`{{../testId}}-${index}-{{path}}`} />
                <FormErrorMessage>{ {{rowErrorExpr}} }</FormErrorMessage>
              </FormControl>
{{/if}}{{/each}}              <Button colorScheme="red" size="sm" onClick={() => remove{{arrayPascal}}(index)}>{{{chrome "removeItem"}}}</Button>
            </HStack>
          )) }
          <Button size="sm" onClick={() => append{{arrayPascal}}({{{defaultRowJson}}})}>{{{chrome "addItem" item=elementLabel}}}</Button>
        </VStack>{{else}}<FormControl isInvalid={!!( {{errorExpr}} )}>
          <FormLabel>{{label}}</FormLabel>
          <Input {...register("{{path}}")} data-testid="{{testId}}" {{{chromeAttr "placeholder" "arrayUnsupported"}}} disabled />
          <FormErrorMessage>{ {{errorExpr}} }</FormErrorMessage>
        </FormControl>{{/if}}
