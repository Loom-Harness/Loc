{{#if rowFields}}<VStack align="stretch" gap={2}>
          <Text fontWeight="medium">{{#if labelExpr}}{ {{{labelExpr}}} }{{else}}{{label}}{{/if}}</Text>
          { {{path}}Fields.map((field, index) => (
            <HStack key={field.id} align="flex-end">
{{{rowHtml}}}
              <Button colorPalette="red" size="sm" onClick={() => remove{{arrayPascal}}(index)}>{{{chrome "removeItem"}}}</Button>
            </HStack>
          )) }
          <Button size="sm" onClick={() => append{{arrayPascal}}({{{defaultRowJson}}})}>{{{addItemLabel}}}</Button>
        </VStack>{{else}}<Field.Root invalid={!!( {{errorExpr}} )}>
          <Field.Label>{{#if labelExpr}}{ {{{labelExpr}}} }{{else}}{{label}}{{/if}}</Field.Label>
          <Input {...register("{{path}}")} data-testid="{{testId}}" {{{chromeAttr "placeholder" "arrayUnsupported"}}} disabled />
          <Field.ErrorText>{ {{errorExpr}} }</Field.ErrorText>
        </Field.Root>{{/if}}
