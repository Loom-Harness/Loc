<Controller
          control={control}
          name="{{path}}"
          render={({ field, fieldState }) => (
            <Field.Root invalid={!!fieldState.error}>
              <Field.Label>{{#if labelExpr}}{ {{{labelExpr}}} }{{else}}{{label}}{{/if}}</Field.Label>
              <Input type="text" inputMode="decimal" value={field.value == null ? "" : String(field.value)} onChange={(e) => field.onChange(e.target.value)} onBlur={field.onBlur} data-testid="{{testId}}" />
              <Field.ErrorText>{{expr errorExpr}}</Field.ErrorText>
            </Field.Root>
          )}
        />
