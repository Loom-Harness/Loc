<Controller
          control={control}
          name="{{path}}"
          render={({ field, fieldState }) => (
            <Field.Root invalid={!!fieldState.error}>
              <Field.Label>{{#if labelExpr}}{ {{{labelExpr}}} }{{else}}{{label}}{{/if}}</Field.Label>
              <NativeSelect.Root data-testid="{{testId}}">
                <NativeSelect.Field value={field.value as string ?? ""} onChange={(e) => field.onChange(e.target.value)}>
                  <option value="">{{{chrome "selectEmptyOption"}}}</option>
                  { ({{{enumValuesJson}}}).map((v) => <option key={v} value={v}>{{#if enumLabelFn}}{ ({{{enumLabelFn}}})(v) }{{else}}{v}{{/if}}</option>) }
                </NativeSelect.Field>
                <NativeSelect.Indicator />
              </NativeSelect.Root>
              <Field.ErrorText>{fieldState.error?.message}</Field.ErrorText>
            </Field.Root>
          )}
        />