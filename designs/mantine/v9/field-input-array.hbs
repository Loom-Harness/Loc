{{#if rowFields}}<Stack gap="xs">
          <Text fw={500} size="sm">{{#if labelExpr}}{ {{{labelExpr}}} }{{else}}{{label}}{{/if}}</Text>
          { {{path}}Fields.map((field, index) => (
            <Group key={field.id} align="flex-end" wrap="nowrap">
{{{rowHtml}}}
              <Button variant="subtle" color="red" size="xs" onClick={() => remove{{arrayPascal}}(index)}>{{{chrome "removeItem"}}}</Button>
            </Group>
          )) }
          <Button variant="light" size="xs" onClick={() => append{{arrayPascal}}({{{defaultRowJson}}})}>{{{addItemLabel}}}</Button>
        </Stack>{{else}}<TextInput {{#if labelExpr}}label={ {{{labelExpr}}} }{{else}}label="{{label}}"{{/if}} {...register("{{path}}")} data-testid="{{testId}}" {{{chromeAttr "placeholder" "arrayUnsupported"}}} disabled error={{expr errorExpr}} />{{/if}}
