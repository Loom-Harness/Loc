<Controller
          control={control}
          name="{{path}}"
          render={({ field, fieldState }) => (
            <Select {{#if labelExpr}}label={ {{{labelExpr}}} }{{else}}label="{{label}}"{{/if}} data-testid="{{testId}}" data={ {{#if enumLabelFn}}({{{enumValuesJson}}}).map((v) => ({ value: v, label: ({{{enumLabelFn}}})(v) })){{else}}{{{enumValuesJson}}}{{/if}} } allowDeselect={false} value={field.value as string} onChange={(v) => field.onChange(v)} error={fieldState.error?.message} />
          )}
        />
