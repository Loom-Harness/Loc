<Controller
          control={control}
          name="{{path}}"
          render={({ field, fieldState }) => (
            <TextInput {{#if labelExpr}}label={ {{{labelExpr}}} }{{else}}label="{{label}}"{{/if}} data-testid="{{testId}}" inputMode="numeric" value={field.value == null ? "" : String(field.value)} onChange={(e) => field.onChange(e.currentTarget.value)} onBlur={field.onBlur} error={{expr errorExpr}} />
          )}
        />
