<FormField
          control={form.control}
          name="{{path}}"
          render={({ field }) => (
            <FormItem>
              <FormLabel>{{#if labelExpr}}{ {{{labelExpr}}} }{{else}}{{label}}{{/if}}</FormLabel>
              <Select onValueChange={field.onChange} value={(field.value as string) ?? ""}>
                <FormControl>
                  <SelectTrigger data-testid="{{testId}}">
                    <SelectValue {{{selectPlaceholderAttr}}} />
                  </SelectTrigger>
                </FormControl>
                <SelectContent>
                  {({{{enumValuesJson}}}).map((__v: string) => (
                    <SelectItem key={__v} value={__v}>{{#if enumLabelFn}}{ ({{{enumLabelFn}}})(__v) }{{else}}{__v}{{/if}}</SelectItem>
                  ))}
                </SelectContent>
              </Select>
              <FormMessage />
            </FormItem>
          )}
        />
