{{#if rowFields}}<div className="space-y-2">
          <div className="text-sm font-medium">{{#if labelExpr}}{ {{{labelExpr}}} }{{else}}{{label}}{{/if}}</div>
          { {{path}}Fields.map((field, index) => (
            <div key={field.id} className="flex items-end gap-2">
{{{rowHtml}}}
              <Button type="button" variant="ghost" size="sm" onClick={() => remove{{arrayPascal}}(index)}>{{{chrome "removeItem"}}}</Button>
            </div>
          )) }
          <Button type="button" variant="outline" size="sm" onClick={() => append{{arrayPascal}}({{{defaultRowJson}}})}>{{{addItemLabel}}}</Button>
        </div>{{else}}<FormField
          control={form.control}
          name="{{path}}"
          render={() => (
            <FormItem>
              <FormLabel>{{#if labelExpr}}{ {{{labelExpr}}} }{{else}}{{label}}{{/if}}</FormLabel>
              <FormControl>
                <Input data-testid="{{testId}}" {{{chromeAttr "placeholder" "arrayUnsupported"}}} disabled />
              </FormControl>
              <FormMessage />
            </FormItem>
          )}
        />{{/if}}
