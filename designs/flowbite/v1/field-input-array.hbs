{{#if rowFields}}
<div class="flex flex-col gap-2">
          <Label>{{#if labelExpr}}{ {{{labelExpr}}} }{{else}}{{label}}{{/if}}</Label>
          {#each form.values.{{path}} as row, index}
          <div class="flex gap-2 items-end">
            {{#each rowFields}}{{#if (eq template "field-input-int")}}<Input type="number" step="1" {{#if labelExpr}}placeholder={ {{{labelExpr}}} }{{else}}placeholder="{{label}}"{{/if}} value={form.values.{{../path}}[index].{{path}} } oninput={(e) => { form.values.{{../path}}[index].{{path}} = (e.currentTarget as HTMLInputElement).value === "" ? 0 : parseInt((e.currentTarget as HTMLInputElement).value, 10) || 0; }} />{{else}}{{#if (eq template "field-input-decimal")}}<Input type="number" step="0.01" {{#if labelExpr}}placeholder={ {{{labelExpr}}} }{{else}}placeholder="{{label}}"{{/if}} value={form.values.{{../path}}[index].{{path}} } oninput={(e) => { form.values.{{../path}}[index].{{path}} = Number((e.currentTarget as HTMLInputElement).value) || 0; }} />{{else}}{{#if (eq template "field-input-money")}}<Input type="text" inputmode="decimal" {{#if labelExpr}}placeholder={ {{{labelExpr}}} }{{else}}placeholder="{{label}}"{{/if}} value={form.values.{{../path}}[index].{{path}} instanceof Decimal ? form.values.{{../path}}[index].{{path}}.toString() : String(form.values.{{../path}}[index].{{path}} ?? "0")} oninput={(e) => { try { form.values.{{../path}}[index].{{path}} = new Decimal((e.currentTarget as HTMLInputElement).value || "0"); } catch { form.values.{{../path}}[index].{{path}} = new Decimal("0"); } }} />{{else}}<Input {{#if labelExpr}}placeholder={ {{{labelExpr}}} }{{else}}placeholder="{{label}}"{{/if}} bind:value={form.values.{{../path}}[index].{{path}} } />{{/if}}{{/if}}{{/if}}{{/each}}<Button type="button" color="red" size="xs" onclick={() => form.values.{{path}}.splice(index, 1)}>{{{chrome "removeItem"}}}</Button>
          </div>
          {/each}
          <Button type="button" size="xs" onclick={() => form.values.{{path}}.push({{{defaultRowJson}}})}>{{{addItemLabel}}}</Button>
        </div>
{{else}}
<div class="flex flex-col gap-2">
          <Label for="{{testId}}">{{#if labelExpr}}{ {{{labelExpr}}} }{{else}}{{label}}{{/if}}</Label>
          <Input id="{{testId}}" data-testid="{{testId}}" {{{chromeAttr "placeholder" "arrayUnsupported"}}} disabled />
        </div>
{{/if}}
