<div class="flex flex-col gap-2">
          <Label for="{{testId}}">{{#if labelExpr}}{ {{{labelExpr}}} }{{else}}{{label}}{{/if}}</Label>
          <Input id="{{testId}}" type="text" inputmode="decimal" data-testid="{{testId}}" value={form.values.{{path}} == null ? "" : String(form.values.{{path}})} oninput={(e) => { form.values.{{path}} = (e.currentTarget as HTMLInputElement).value; }} />
          {#if form.errors["{{path}}"]}<Helper color="red">{form.errors["{{path}}"]}</Helper>{/if}
        </div>