<v-text-field label="{{label}}" data-testid="{{testId}}" inputmode="decimal" :model-value="form.values.{{path}} instanceof Decimal ? form.values.{{path}}.toString() : String(form.values.{{path}} ?? '0')" @update:model-value="(v) => { try { form.values.{{path}} = new Decimal(String(v ?? '0') || '0') } catch { form.values.{{path}} = new Decimal('0') } }" :error-messages='form.errors["{{path}}"]' />

