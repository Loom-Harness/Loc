<v-text-field {{#if labelExpr}}:label='{{{labelExpr}}}'{{else}}label="{{label}}"{{/if}} data-testid="{{testId}}" inputmode="decimal" :model-value="form.values.{{path}} == null ? '' : String(form.values.{{path}})" @update:model-value="(v) => form.values.{{path}} = String(v ?? '')" :error-messages='form.errors["{{path}}"]' />
