{{#if rowFields}}
<div class="d-flex flex-column ga-2">
<div class="text-subtitle-2">{{#if labelExpr}}\{{ {{{labelExpr}}} }}{{else}}{{label}}{{/if}}</div>
<div v-for="(row, index) in form.values.{{path}}" :key="index" class="d-flex ga-2 align-end">
{{{rowHtml}}}
<v-btn size="small" color="error" variant="text" @click="form.values.{{path}}.splice(index, 1)">{{{chrome "removeItem"}}}</v-btn>
</div>
<v-btn size="small" variant="tonal" @click='form.values.{{path}}.push({{{defaultRowJson}}})'>{{{addItemLabel}}}</v-btn>
</div>
{{else}}
<v-text-field {{#if labelExpr}}:label='{{{labelExpr}}}'{{else}}label="{{label}}"{{/if}} v-model="form.values.{{path}}" data-testid="{{testId}}" {{{chromeAttr "placeholder" "arrayUnsupported"}}} disabled :error-messages='form.errors["{{path}}"]' />
{{/if}}
