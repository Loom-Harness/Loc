<v-file-input {{#if labelExpr}}:label='{{{labelExpr}}}'{{else}}label="{{label}}"{{/if}} data-testid="{{testId}}" clearable :placeholder='form.values.{{path}}?.key ?? {{{chromeValue "chooseFile"}}}' @update:model-value="async (f) => { const file = Array.isArray(f) ? f[0] : f; if (!file) { form.values.{{path}} = null; return; } form.values.{{path}} = (await api.uploadFile(file)) as typeof form.values.{{path}}; }" :error-messages='form.errors["{{path}}"]' />
