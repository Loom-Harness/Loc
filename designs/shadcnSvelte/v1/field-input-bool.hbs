<div class="flex flex-row items-center justify-between rounded-lg border p-3">
          <label class="app-label" for="{{testId}}">{{#if labelExpr}}{ {{{labelExpr}}} }{{else}}{{label}}{{/if}}</label>
          <input id="{{testId}}" type="checkbox" role="switch" class="app-switch" data-testid="{{testId}}" bind:checked={form.values.{{path}} } />
          {#if form.errors["{{path}}"]}<p class="text-sm text-destructive">{form.errors["{{path}}"]}</p>{/if}
        </div>