{{#if rowFields}}
<div class="flex flex-col gap-2">
          <span class="loom-label">{{#if labelExpr}}{ {{{labelExpr}}} }{{else}}{{label}}{{/if}}</span>
          {#each form.values.{{path}} as row, index}
          <div class="flex gap-2 items-end">
            {{#each rowFields}}{{#if (eq template "field-input-int")}}<input type="number" step="1" class="loom-input" {{#if labelExpr}}placeholder={ {{{labelExpr}}} }{{else}}placeholder="{{label}}"{{/if}} value={form.values.{{../path}}[index].{{path}} } oninput={(e) => { form.values.{{../path}}[index].{{path}} = e.currentTarget.value === "" ? 0 : parseInt(e.currentTarget.value, 10) || 0; }} />{{else}}{{#if (eq template "field-input-decimal")}}<input type="number" step="0.01" class="loom-input" {{#if labelExpr}}placeholder={ {{{labelExpr}}} }{{else}}placeholder="{{label}}"{{/if}} value={form.values.{{../path}}[index].{{path}} } oninput={(e) => { form.values.{{../path}}[index].{{path}} = Number(e.currentTarget.value) || 0; }} />{{else}}{{#if (eq template "field-input-money")}}<input type="text" inputmode="decimal" class="loom-input" {{#if labelExpr}}placeholder={ {{{labelExpr}}} }{{else}}placeholder="{{label}}"{{/if}} value={form.values.{{../path}}[index].{{path}} instanceof Decimal ? form.values.{{../path}}[index].{{path}}.toString() : String(form.values.{{../path}}[index].{{path}} ?? "0")} oninput={(e) => { try { form.values.{{../path}}[index].{{path}} = new Decimal(e.currentTarget.value || "0"); } catch { form.values.{{../path}}[index].{{path}} = new Decimal("0"); } }} />{{else}}<input class="loom-input" {{#if labelExpr}}placeholder={ {{{labelExpr}}} }{{else}}placeholder="{{label}}"{{/if}} bind:value={form.values.{{../path}}[index].{{path}} } />{{/if}}{{/if}}{{/if}}{{/each}}<button type="button" class="loom-btn" onclick={() => form.values.{{path}}.splice(index, 1)}>{{{chrome "removeItem"}}}</button>
          </div>
          {/each}
          <button type="button" class="loom-btn" onclick={() => form.values.{{path}}.push({{{defaultRowJson}}})}>{{{addItemLabel}}}</button>
        </div>
{{else}}
<div class="flex flex-col gap-2">
          <label class="loom-label" for="{{testId}}">{{#if labelExpr}}{ {{{labelExpr}}} }{{else}}{{label}}{{/if}}</label>
          <input id="{{testId}}" class="loom-input" data-testid="{{testId}}" {{{chromeAttr "placeholder" "arrayUnsupported"}}} disabled />
        </div>
{{/if}}
