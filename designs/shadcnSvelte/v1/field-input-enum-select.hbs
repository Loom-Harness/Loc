<div class="flex flex-col gap-2">
          <label class="loom-label" for="{{testId}}">{{#if labelExpr}}{ {{{labelExpr}}} }{{else}}{{label}}{{/if}}</label>
          <select id="{{testId}}" class="loom-input" data-testid="{{testId}}" bind:value={form.values.{{path}} }>{#each ({{{enumValuesJson}}}) as __v (__v)}<option value={__v}>{{#if enumLabelFn}}{({{{enumLabelFn}}})(__v)}{{else}}{__v}{{/if}}</option>{/each}</select>
          {#if form.errors["{{path}}"]}<p class="text-sm text-destructive">{form.errors["{{path}}"]}</p>{/if}
        </div>