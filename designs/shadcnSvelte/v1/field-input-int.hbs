<div class="flex flex-col gap-2">
          <label class="app-label" for="{{testId}}">{{#if labelExpr}}{ {{{labelExpr}}} }{{else}}{{label}}{{/if}}</label>
          <input id="{{testId}}" type="text" inputmode="numeric" class="app-input" data-testid="{{testId}}" value={form.values.{{path}} == null ? "" : String(form.values.{{path}})} oninput={(e) => { form.values.{{path}} = e.currentTarget.value; }} />
          {#if form.errors["{{path}}"]}<p class="text-sm text-destructive">{form.errors["{{path}}"]}</p>{/if}
        </div>