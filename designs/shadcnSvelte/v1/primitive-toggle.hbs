{{#if hasBind}}<label class="flex items-center gap-2"><input type="checkbox" role="switch" class="app-switch" checked={{expr bind}} onchange={(e) => { {{bind}} = e.currentTarget.checked; }}{{{testidAttr}}} /><span class="app-label">{{{labelText}}}</span></label>{{else}}<label class="flex items-center gap-2"><input type="checkbox" role="switch" class="app-switch"{{{testidAttr}}} /><span class="app-label">{{{labelText}}}</span></label>{{/if}}