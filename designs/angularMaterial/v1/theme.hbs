/* Auto-generated.  Do not edit by hand.
   Base resets + the design tokens projected from the system's
   `theme { … }` block.  The Material palette itself rides the prebuilt
   theme listed first in angular.json `styles`. */
html,
body {
  height: 100%;
}
body {
  margin: 0;
  font-family: {{{fontFamily}}};
}
:root {
  --app-primary: {{brandShades.[6]}};
  --app-accent: {{accentShades.[6]}};
}
mat-card {
  padding: 16px;
}
.app-nav-section {
  font-size: 0.75rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: rgba(0, 0, 0, 0.6);
  margin: 8px 0 4px;
}
.app-stack {
  display: flex;
  flex-direction: column;
  gap: 16px;
}
.app-group {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8px;
}
.app-toolbar {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
}
.app-container {
  max-width: 960px;
  margin: 0 auto;
  width: 100%;
}
.app-paper {
  padding: 16px;
  border: 1px solid rgba(0, 0, 0, 0.12);
  border-radius: 8px;
  background: #fff;
}
.app-stat {
  display: flex;
  flex-direction: column;
  gap: 2px;
}
.app-stat-label {
  font-size: 0.8rem;
  color: rgba(0, 0, 0, 0.6);
}
.app-stat-value {
  font-size: 1.4rem;
  font-weight: 600;
}
.app-badge {
  display: inline-flex;
  align-items: center;
  padding: 2px 8px;
  border-radius: 12px;
  font-size: 0.75rem;
  font-weight: 600;
  background: var(--app-primary);
  color: #fff;
}
.app-alert {
  padding: 12px 16px;
  border-radius: 8px;
  border: 1px solid transparent;
}
.app-alert-title {
  font-weight: 600;
  margin-bottom: 4px;
}
.app-alert-red {
  background: #fdecea;
  border-color: #f5c6cb;
  color: #842029;
}
.app-alert-green {
  background: #eafaf1;
  border-color: #c3e6cb;
  color: #0f5132;
}
.app-alert-yellow {
  background: #fff8e1;
  border-color: #ffe8a1;
  color: #664d03;
}
.app-alert-blue {
  background: #e7f1ff;
  border-color: #b6d4fe;
  color: #084298;
}
.app-inline-code {
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 0.875em;
  background: rgba(0, 0, 0, 0.06);
  padding: 1px 5px;
  border-radius: 4px;
}
.app-key-value-row {
  display: flex;
  align-items: flex-start;
  gap: 8px;
  padding: 4px 0;
}
.app-kv-label {
  color: rgba(0, 0, 0, 0.6);
  min-width: 140px;
  flex-shrink: 0;
}
.app-kv-value {
  min-width: 0;
  flex: 1;
}
.app-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 160px;
  color: rgba(0, 0, 0, 0.6);
}
.app-skeleton {
  background: linear-gradient(90deg, #eee 25%, #f5f5f5 37%, #eee 63%);
  background-size: 400% 100%;
  border-radius: 4px;
  animation: app-skeleton-pulse 1.4s ease infinite;
}
.app-skeleton-group {
  display: flex;
  flex-direction: column;
  gap: 8px;
}
@keyframes app-skeleton-pulse {
  0% {
    background-position: 100% 50%;
  }
  100% {
    background-position: 0 50%;
  }
}
.app-avatar {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  object-fit: cover;
  display: inline-block;
}
.app-avatar-empty {
  background: rgba(0, 0, 0, 0.12);
}
.app-image {
  max-width: 100%;
  height: auto;
}
.app-icon {
  display: inline-flex;
  align-items: center;
  width: 24px;
  height: 24px;
}
.app-icon svg {
  width: 100%;
  height: 100%;
}
.app-icon-xs {
  width: 16px;
  height: 16px;
}
.app-icon-sm {
  width: 20px;
  height: 20px;
}
.app-icon-lg {
  width: 32px;
  height: 32px;
}
.app-icon-xl {
  width: 48px;
  height: 48px;
}
.app-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 16px;
}
.app-anchor {
  color: var(--app-primary);
  text-decoration: none;
}
.app-anchor:hover {
  text-decoration: underline;
}
.app-breadcrumbs > *:not(:last-child)::after {
  content: "/";
  margin-inline-start: 8px;
  opacity: 0.5;
}
.app-breadcrumbs {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8px;
  font-size: 0.875rem;
}
.app-code-block {
  background: #1e1e1e;
  color: #d4d4d4;
  border-radius: 8px;
  padding: 12px 16px;
  overflow: auto;
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 0.85rem;
}
.app-code-block-title {
  font-size: 0.8rem;
  color: rgba(255, 255, 255, 0.6);
  margin-bottom: 8px;
}
.app-code-block pre {
  margin: 0;
}
.app-table-scroll {
  width: 100%;
  overflow-x: auto;
}
.app-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.9rem;
}
.app-table th,
.app-table td {
  text-align: left;
  padding: 8px 12px;
  border-bottom: 1px solid rgba(0, 0, 0, 0.12);
}
.app-table th {
  font-weight: 600;
  color: rgba(0, 0, 0, 0.6);
}
.app-table-striped tbody tr:nth-child(even) {
  background: rgba(0, 0, 0, 0.03);
}
.app-table-highlight tbody tr:hover {
  background: rgba(0, 0, 0, 0.06);
}
.app-table-sticky thead th {
  position: sticky;
  top: 0;
  background: #fff;
  z-index: 1;
}
.app-field {
  width: 100%;
}
/* Labelled Divider — `Divider { label: "…" }` renders rule-text-rule (neither
   mat-divider, p-divider nor a bare <hr> carries a label slot of its own). */
.app-divider-labelled {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  margin: 1rem 0;
}
.app-divider-labelled .app-divider-rule {
  flex: 1;
}
.app-divider-label {
  font-size: 0.875rem;
  opacity: 0.7;
  white-space: nowrap;
}
/* State-controlled Modal (`Modal { …, open: <state bool> }`). */
.app-modal-backdrop {
  position: fixed;
  inset: 0;
  z-index: 40;
  background: rgba(0, 0, 0, 0.5);
}
.app-modal-box {
  position: fixed;
  z-index: 50;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 100%;
  max-width: 32rem;
  border-radius: 0.75rem;
  padding: 1.5rem;
  background: canvas;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
}
.app-modal-title {
  margin: 0 0 1rem;
  font-size: 1.125rem;
  font-weight: 600;
}
