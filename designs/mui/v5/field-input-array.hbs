{{#if rowFields}}<Stack spacing={1}>
          <Typography variant="subtitle2">{{label}}</Typography>
          { {{path}}Fields.map((field, index) => (
            <Stack key={field.id} direction="row" spacing={1} alignItems="flex-end">
{{#each rowFields}}{{#if (eq template "field-input-id-select")}}              <Controller control={control} name={`{{../path}}.${index}.{{path}}`} render={({ field, fieldState }) => (
                <FormControl fullWidth size="small" error={!!fieldState.error}>
                  <InputLabel>{{label}}</InputLabel>
                  <Select label="{{label}}" data-testid={`{{../testId}}-${index}-{{path}}`} value={field.value as string ?? ""} onChange={(e) => field.onChange(e.target.value)}>
                    {({{{hookVar}}}.data?.items ?? []).map((__o) => (
                      <MenuItem key={__o.id} value={__o.id} data-testid={`{{../testId}}-${index}-{{path}}-option-${__o.id}`}>{__o["{{displayField}}"]}</MenuItem>
                    ))}
                  </Select>
                  {fieldState.error && <FormHelperText>{fieldState.error.message}</FormHelperText>}
                </FormControl>
              )} />
{{else}}              <TextField label="{{label}}" InputLabelProps=\{{ shrink: true }}{{#if (eq template "field-input-money")}} inputProps=\{{ inputMode: "decimal" }}{{/if}} {{#if (eq template "field-input-datetime")}}type="datetime-local" {{/if}}{...register(`{{../path}}.${index}.{{path}}`{{#if valueAsNumber}}, { valueAsNumber: true }{{/if}}{{#if (eq template "field-input-money")}}, { setValueAs: (v: string) => { try { return new Decimal(v || "0"); } catch { return new Decimal("0"); } } }{{/if}})} data-testid={`{{../testId}}-${index}-{{path}}`} error={!!({{rowErrorExpr}})} helperText={{expr rowErrorExpr}} />
{{/if}}{{/each}}              <Button color="error" size="small" onClick={() => remove{{arrayPascal}}(index)}>{{{chrome "removeItem"}}}</Button>
            </Stack>
          )) }
          <Button size="small" onClick={() => append{{arrayPascal}}({{{defaultRowJson}}})}>{{{chrome "addItem" item=elementLabel}}}</Button>
        </Stack>{{else}}<TextField label="{{label}}" InputLabelProps=\{{ shrink: true }} {...register("{{path}}")} data-testid="{{testId}}" {{{chromeAttr "placeholder" "arrayUnsupported"}}} disabled error={!!( {{errorExpr}} )} helperText={ {{errorExpr}} } />{{/if}}
