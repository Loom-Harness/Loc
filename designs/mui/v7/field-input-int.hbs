<Controller
          control={control}
          name="{{path}}"
          render={({ field, fieldState }) => (
            <TextField {{#if labelExpr}}label={ {{{labelExpr}}} }{{else}}label="{{label}}"{{/if}} InputLabelProps=\{{ shrink: true }} type="text" data-testid="{{testId}}" value={field.value == null ? "" : String(field.value)} onChange={(e) => field.onChange(e.target.value)} onBlur={field.onBlur} error={!!fieldState.error} helperText={{expr errorExpr}} inputProps=\{{ inputMode: "numeric" }} />
          )}
        />
