{{#if rowFields}}<Stack spacing={1}>
          <Typography variant="subtitle2">{{#if labelExpr}}{ {{{labelExpr}}} }{{else}}{{label}}{{/if}}</Typography>
          { {{path}}Fields.map((field, index) => (
            <Stack key={field.id} direction="row" spacing={1} alignItems="flex-end">
{{{rowHtml}}}
              <Button color="error" size="small" onClick={() => remove{{arrayPascal}}(index)}>{{{chrome "removeItem"}}}</Button>
            </Stack>
          )) }
          <Button size="small" onClick={() => append{{arrayPascal}}({{{defaultRowJson}}})}>{{{addItemLabel}}}</Button>
        </Stack>{{else}}<TextField {{#if labelExpr}}label={ {{{labelExpr}}} }{{else}}label="{{label}}"{{/if}} InputLabelProps=\{{ shrink: true }} {...register("{{path}}")} data-testid="{{testId}}" {{{chromeAttr "placeholder" "arrayUnsupported"}}} disabled error={!!( {{errorExpr}} )} helperText={ {{errorExpr}} } />{{/if}}
