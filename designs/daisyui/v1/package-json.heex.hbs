{
  "name": "{{appName}}-assets",
  "private": true,
  "scripts": {
    "build": "{{#if buildFonts}}npm run build:fonts && {{/if}}npm run build:css && npm run build:js",{{#if buildFonts}}
    "build:fonts": "{{{buildFonts}}}",{{/if}}
    "build:css": "tailwindcss --config tailwind.config.js -i css/app.css -o ../priv/static/assets/app.css --minify",
    "build:js": "esbuild js/app.js --bundle --target=es2022 --outfile=../priv/static/assets/app.js --minify"
  },
  "dependencies": {
    "phoenix": "1.8.16",
    "phoenix_html": "4.3.0",
    "phoenix_live_view": "1.2.13"{{#each fontPackages}},
    "{{{name}}}": "{{{version}}}"{{/each}}
  },
  "devDependencies": {
    "daisyui": "4.12.24",
    "esbuild": "0.25.12",
    "tailwindcss": "3.4.19"
  }
}
