<div class="flex flex-col gap-2"><Label for="{{testId}}">{{label}}</Label><Input id="{{testId}}" inputmode="decimal" data-testid="{{testId}}" :model-value="form.values.{{path}} instanceof Decimal ? form.values.{{path}}.toString() : String(form.values.{{path}} ?? '0')" @update:model-value="(v) => { try { form.values.{{path}} = new Decimal(String(v ?? '0') || '0') } catch { form.values.{{path}} = new Decimal('0') } }" /><p v-if='form.errors["{{path}}"]' class="text-sm text-destructive">\{{ form.errors["{{path}}"] }}</p></div>
