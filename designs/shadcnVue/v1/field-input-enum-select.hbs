<div class="flex flex-col gap-2"><Label for="{{testId}}">{{#if labelExpr}}\{{ {{{labelExpr}}} }}{{else}}{{label}}{{/if}}</Label><Select :model-value="form.values.{{path}}" @update:model-value="(v) => form.values.{{path}} = String(v ?? '') as typeof form.values.{{path}}"><SelectTrigger id="{{testId}}" data-testid="{{testId}}"><SelectValue {{{selectPlaceholderAttr}}} /></SelectTrigger><SelectContent><SelectItem v-for='__v in {{{enumValuesJson}}}' :key="__v" :value="__v">\{{ {{#if enumLabelFn}}({{{enumLabelFn}}})(__v){{else}}__v{{/if}} }}</SelectItem></SelectContent></Select><p v-if='form.errors["{{path}}"]' class="text-sm text-destructive">\{{ form.errors["{{path}}"] }}</p></div>
