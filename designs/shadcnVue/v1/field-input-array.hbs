{{#if rowFields}}
<div class="flex flex-col gap-2"><Label>{{#if labelExpr}}\{{ {{{labelExpr}}} }}{{else}}{{label}}{{/if}}</Label>
<div v-for="(row, index) in form.values.{{path}}" :key="index" class="flex gap-2 items-end">
{{#each rowFields}}{{#if (eq template "field-input-int")}}<Input type="number" step="1" {{#if labelExpr}}:placeholder='{{{labelExpr}}}'{{else}}placeholder="{{label}}"{{/if}} :model-value="form.values.{{../path}}[index].{{path}}" @update:model-value="(v) => form.values.{{../path}}[index].{{path}} = Math.trunc(Number(v)) || 0" />{{else}}{{#if (eq template "field-input-decimal")}}<Input type="number" step="0.01" {{#if labelExpr}}:placeholder='{{{labelExpr}}}'{{else}}placeholder="{{label}}"{{/if}} :model-value="form.values.{{../path}}[index].{{path}}" @update:model-value="(v) => form.values.{{../path}}[index].{{path}} = Number(v) || 0" />{{else}}{{#if (eq template "field-input-money")}}<Input inputmode="decimal" {{#if labelExpr}}:placeholder='{{{labelExpr}}}'{{else}}placeholder="{{label}}"{{/if}} :model-value="form.values.{{../path}}[index].{{path}} instanceof Decimal ? form.values.{{../path}}[index].{{path}}.toString() : String(form.values.{{../path}}[index].{{path}} ?? '0')" @update:model-value="(v) => { try { form.values.{{../path}}[index].{{path}} = new Decimal(String(v ?? '0') || '0') } catch { form.values.{{../path}}[index].{{path}} = new Decimal('0') } }" />{{else}}<Input {{#if labelExpr}}:placeholder='{{{labelExpr}}}'{{else}}placeholder="{{label}}"{{/if}} :model-value="form.values.{{../path}}[index].{{path}}" @update:model-value="(v) => form.values.{{../path}}[index].{{path}} = String(v ?? '')" />{{/if}}{{/if}}{{/if}}{{/each}}<Button type="button" variant="ghost" size="sm" @click="form.values.{{path}}.splice(index, 1)">{{{chrome "removeItem"}}}</Button>
</div>
<Button type="button" variant="outline" size="sm" @click='form.values.{{path}}.push({{{defaultRowJson}}})'>{{{addItemLabel}}}</Button>
</div>
{{else}}
<div class="flex flex-col gap-2"><Label for="{{testId}}">{{#if labelExpr}}\{{ {{{labelExpr}}} }}{{else}}{{label}}{{/if}}</Label><Input id="{{testId}}" data-testid="{{testId}}" {{{chromeAttr "placeholder" "arrayUnsupported"}}} disabled /></div>
{{/if}}
