{{#if rowFields}}
<div class="flex flex-col gap-2"><Label>{{#if labelExpr}}\{{ {{{labelExpr}}} }}{{else}}{{label}}{{/if}}</Label>
<div v-for="(row, index) in form.values.{{path}}" :key="index" class="flex gap-2 items-end">
{{{rowHtml}}}
<Button type="button" variant="ghost" size="sm" @click="form.values.{{path}}.splice(index, 1)">{{{chrome "removeItem"}}}</Button>
</div>
<Button type="button" variant="outline" size="sm" @click='form.values.{{path}}.push({{{defaultRowJson}}})'>{{{addItemLabel}}}</Button>
</div>
{{else}}
<div class="flex flex-col gap-2"><Label for="{{testId}}">{{#if labelExpr}}\{{ {{{labelExpr}}} }}{{else}}{{label}}{{/if}}</Label><Input id="{{testId}}" data-testid="{{testId}}" {{{chromeAttr "placeholder" "arrayUnsupported"}}} disabled /></div>
{{/if}}
