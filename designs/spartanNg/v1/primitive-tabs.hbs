{{#if hasTabs}}<div class="app-tabs"{{{testidAttr}}}{{{styleAttr}}}>
{{indent}}{{#each tabs}}<section class="app-tab-panel">
{{../innerIndent}}<div class="app-tab-trigger" aria-selected="true">{{{this.label}}}</div>
{{../innerIndent}}{{{this.bodyJsx}}}
{{../indent}}</section>{{#unless @last}}
{{../indent}}{{/unless}}{{/each}}
{{closeIndent}}</div>{{else}}<div class="app-tabs"{{{testidAttr}}}></div>{{/if}}
