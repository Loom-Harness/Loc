<label class="app-field">{{#if labelText}}<span class="app-label">{{{labelText}}}</span>{{/if}}<select class="app-input"{{{testidAttr}}}{{#if hasBind}} [value]="{{bind}}()" (change)="{{bind}}.set($any($event.target).value)"{{/if}}>@for (opt of {{{optionsExpr}}}; track opt) {<option [value]="opt">\{{ opt }}</option>}</select>{{#if hasError}}@if ( {{{error}}} ) {<span class="app-error">\{{ {{{error}}} }}</span>}{{/if}}</label>
