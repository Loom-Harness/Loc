// Auto-generated.  The app shell — a standalone component (selector
// app-root) rendering PrimeNG chrome (a p-toolbar brand bar + a styled
// sidebar) around the router outlet.  No Angular Material: the toolbar is
// PrimeNG's `p-toolbar` and the sidebar is plain styled markup keyed by the
// same nav testids the other Angular shells use.  Nav labels/links are baked
// at generation time.
import { Component, inject } from "@angular/core";
import { ToolbarModule } from "primeng/toolbar";
{{#if authUi}}import { ButtonModule } from "primeng/button";
{{/if}}import { RouterLink,{{#if hasNav}} RouterLinkActive,{{/if}} RouterOutlet } from "@angular/router";
import { LoomErrorHandler } from "./error-handler";
{{#if authUi}}import { AuthGateComponent } from "./auth/auth-gate.component";
{{/if}}{{#if shellUsesSession}}import { SessionService } from "./auth/session.service";
{{/if}}{{#if hasRealtimeHandlers}}import { RealtimeHandlersComponent } from "./realtime-handlers.component";
{{/if}}{{#if i18nEnabled}}import { t } from "../lib/locale";
{{/if}}{{#if localeSwitchable}}import { LocaleSwitcher } from "../lib/locale-switcher";
{{/if}}
@Component({
  selector: "app-root",
  imports: [
    RouterOutlet,
    RouterLink,
{{#if hasNav}}    RouterLinkActive,
{{/if}}    ToolbarModule,
{{#if authUi}}    ButtonModule,
    AuthGateComponent,
{{/if}}{{#if hasRealtimeHandlers}}    RealtimeHandlersComponent,
{{/if}}{{#if localeSwitchable}}    LocaleSwitcher,
{{/if}}  ],
  template: `
{{{errorBanner}}}    <a href="#main-content" class="app-skip-link">{{{skipToContentText}}}</a>
{{#if hasRealtimeHandlers}}    <app-realtime-handlers />
{{/if}}    <p-toolbar styleClass="app-toolbar">
      <ng-template pTemplate="start">
        <a routerLink="/" class="app-brand">{{systemNameHuman}}</a>
      </ng-template>
{{#if localeSwitchable}}      <ng-template pTemplate="end">
        <app-locale-switcher />
{{#if authUi}}        @if (session.snapshot().kind === "authed") {
          <button pButton type="button" [text]="true" data-testid="sign-out" (click)="session.signOut()">{{{chrome "signOut"}}}</button>
        }
{{/if}}      </ng-template>
{{else}}{{#if authUi}}      <ng-template pTemplate="end">
        @if (session.snapshot().kind === "authed") {
          <button pButton type="button" [text]="true" data-testid="sign-out" (click)="session.signOut()">{{{chrome "signOut"}}}</button>
        }
      </ng-template>
{{/if}}{{/if}}    </p-toolbar>
    <div class="app-shell">
      <aside class="app-sidebar" data-testid="nav-sidebar">
        <nav class="app-nav" {{{primaryNavAria}}}>
{{#each navSections}}          <div class="app-nav-section">{{{labelText}}}</div>
{{#each entries}}{{#if href}}          <a href="{{href}}"{{#if external}} target="_blank" rel="noreferrer"{{/if}} class="app-nav-link" data-testid="{{testId}}">{{{labelText}}}</a>
{{else}}{{#if requiresJs}}          @if ({{{requiresJs}}}) { <a routerLink="{{to}}" routerLinkActive="app-active" class="app-nav-link" data-testid="{{testId}}">{{{labelText}}}</a> }
{{else}}          <a routerLink="{{to}}" routerLinkActive="app-active" class="app-nav-link" data-testid="{{testId}}">{{{labelText}}}</a>
{{/if}}{{/if}}{{/each}}{{/each}}        </nav>
      </aside>
      <main class="app-main" id="main-content">
{{#if authUi}}        <app-auth-gate>
          <router-outlet />
        </app-auth-gate>
{{else}}        <router-outlet />
{{/if}}      </main>
    </div>
  `,
  styles: [
    `
    .app-toolbar { border-radius: 0; }
    .app-brand { color: inherit; text-decoration: none; font-weight: 700; font-size: 1.125rem; }
    .app-shell { display: flex; min-height: calc(100vh - 4rem); }
    .app-sidebar {
      width: 16rem;
      flex-shrink: 0;
      border-right: 1px solid var(--p-content-border-color, #e5e7eb);
      padding: 1rem;
    }
    .app-nav { display: flex; flex-direction: column; gap: 0.125rem; }
    .app-nav-section {
      font-size: 0.75rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--p-text-muted-color, #6b7280);
      margin: 0.5rem 0 0.25rem;
    }
    .app-nav-link {
      display: block;
      padding: 0.5rem 0.75rem;
      border-radius: var(--p-border-radius, 6px);
      color: inherit;
      text-decoration: none;
      font-size: 0.875rem;
      font-weight: 500;
    }
    .app-nav-link:hover { background: var(--p-highlight-bg, rgba(0, 0, 0, 0.04)); }
    .app-active {
      background: var(--p-highlight-bg, rgba(0, 0, 0, 0.06));
      color: var(--p-primary-color, inherit);
    }
    .app-main { flex: 1; padding: 1rem; min-width: 0; }
    @media (min-width: 1024px) { .app-main { padding: 1.5rem; } }
    .app-skip-link { position: absolute; left: -9999px; top: 0; z-index: 3000; padding: 8px 16px; background: Canvas; color: CanvasText; border: 1px solid; border-radius: 4px; }
    .app-skip-link:focus { left: 8px; top: 8px; }
  `,
  ],
})
{{{appClass}}}
