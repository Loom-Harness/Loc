        "lastName": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "version": {
          "type": "integer"
        },
        "display": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "firstName",
        "lastName",
        "email",
        "version",
        "display"
      ],
      "additionalProperties": false
    },
    "Account": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "number": {
          "type": "string"
