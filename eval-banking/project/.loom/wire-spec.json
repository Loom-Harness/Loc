          "type": "string",
          "format": "uuid"
        },
        "startedAt": {
          "type": "string",
          "format": "date-time"
        },
        "version": {
          "type": "integer"
        }
      },
      "required": [
        "id",
        "startedAt",
        "version"
      ],
      "additionalProperties": false
