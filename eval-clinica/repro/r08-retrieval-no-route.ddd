// Probe: a declared `retrieval` (the non-deprecated list-read form) produces no
// HTTP route, while the deprecated `find` does.
system R08 {
  subdomain S { context C {
    aggregate Appt { startAt: datetime  practitioner: string }
    repository Appts for Appt {
      find byPrac(p: string): Appt[] where practitioner == p     // DEPRECATED form
    }
    criterion ForPrac(p: string) of Appt = practitioner == p
    retrieval PracDay(p: string) of Appt { where: ForPrac(p)  sort: [startAt asc] }
  } }
  storage primary { type: postgres }
  resource st { for: C, kind: state, use: primary }
  deployable api { platform: node, contexts: [C], dataSources: [st], port: 3000 }
}
