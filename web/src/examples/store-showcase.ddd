// Store showcase — exercises the `store` surface end-to-end (named-actions-
// and-stores.md §3, Stage 5) so the React build matrix tsc-validates it:
//
//   - a top-level `store Cart { state { … } action … }` shared client-side
//     container with in-memory state + named actions that `:=`/`+=` it;
//   - a page that READS store state by dotted name (`Cart.lines`, `Cart.count`)
//     and CALLS a store action from a page action (`discard() { Cart.clear() }`);
//   - a component that adds to the store (`Cart.add(...)` via a store action);
//   - a `derived` whose initialiser reads a store field, and a `toast(...)`
//     page effect in an action body (2026-09-03 audit F3/F9 — both emitted
//     identifiers the generated project never declared).
//
// The store lowers to a Zustand module at `src/stores/cart.ts`; the page/
// component shells import the `useCart` hook + bind one selector per used
// member.  Pack-neutral: the matrix injects `design: <pack>` per shard.

system StoreShowcase {

  subdomain Sales {
    context Sales {
      aggregate Order with crudish {
        customerId: string
      }
      repository Orders for Order { }
    }
  }

  api SalesApi from Sales

  ui WebApp {
    api Sales: SalesApi

    // Shared client-side state container.  In-memory (no persist:/sync:).
    store Cart {
      state {
        // An array field omits its `= []` initializer — the zero value for an
        // array IS the empty list (and a bare `[]` literal is lexed as the
        // array-type marker, a pre-existing grammar limitation).
        lines: string[]
        count: int = 0
      }
      action add(sku: string) {
        lines += sku
        count += 1
      }
      action clear() {
        // `[ ]` (spaced) is the empty-list literal — `[]` (adjacent) lexes as
        // the array-type marker.  Pre-existing grammar quirk, not store-specific.
        lines := [ ]
        count := 0
      }
    }

    // Lifetime ladder (frontend-state-management.md §3.1) — `persist:` picks
    // where the state lives.  These exercise the persisted + URL-synced emit
    // paths so the build matrix tsc-validates them.

    // URL-synced filter state — shareable, deep-linkable, back/forward-safe.
    // Scalar fields only (a `persist: url` store rejects array/entity fields).
    store Filters persist: url {
      state {
        term: string = ""
        pageNo: int = 0
      }
      action setTerm(q: string) { term := q }
      action setPage(n: int) { pageNo := n }
    }

    // Browser-persisted draft — survives a full reload / restart (localStorage).
    store Draft persist: local {
      state { note: string = "" }
      action write(t: string) { note := t }
    }

    // A component also reads the store (dotted) and calls a store action from
    // its own action — store wiring works uniformly for pages AND components.
    component CartSummary() {
      action addOne() { Cart.add("SKU-1") }
      body: Stack {
        Heading { Cart.count, level: 3 },
        Button { "Add item", onClick: addOne }
      }
    }

    // A page reads the store (dotted) and calls a store action from its own
    // page action.  `confirming` is page-local state, side by side with the
    // shared store reads.
    page CartPage {
      route: "/cart"
      state { confirming: bool = false }
      // A `derived` whose initialiser reads a STORE field.  Nothing in the
      // body mentions `Cart.count`, so the selector binding exists ONLY
      // because the derived asked for it — the shape that used to emit
      // `const itemCount = useMemo(() => count, [])` against an undeclared
      // `count` (2026-09-03 audit F3/F9, packet W1.2).
      derived itemCount: int = Cart.count
      action discard() { Cart.clear() }
      // The `toast(<msg>)` page effect in a named action body — the OTHER
      // half of that packet.  It renders as a bare `toast(...)` call, so the
      // project has to declare the symbol.
      action save() { toast("Draft saved") }
      body: Stack {
        Heading { "Your cart", level: 1 },
        CartSummary(),
        Heading { itemCount, level: 3 },
        For { each: Cart.lines, line => Card { line } },
        Button { "Discard", onClick: discard },
        Button { "Save", onClick: save }
      }
    }

    page Home {
      route: "/"
      body: Stack {
        Heading { "Store showcase", level: 1 },
        // Reads across the lifetime ladder — in-memory, URL-synced, persisted.
        Heading { Filters.term, level: 3 },
        Heading { Draft.note, level: 3 }
      }
    }
  }

  storage primary { type: postgres }
  resource salesState { for: Sales, kind: state, use: primary }

  deployable api {
    platform: node
    contexts: [Sales]
    dataSources: [salesState]
    serves: SalesApi
    port: 3000
  }

  deployable webApp {
    platform: react
    targets: api
    ui: WebApp { Sales: api }
    port: 3001
  }
}
