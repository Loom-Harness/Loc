// Root-level value object — ambient across every context in the
// project.  Lives in its own file so multiple bounded contexts can
// share the same Money shape without copying it.

valueobject Money {
  amount: decimal
  currency: string
  invariant amountCannotBeNegative: amount >= 0
  invariant currencyMustBeThreeUppercaseLetters: currency.matches("^[A-Z]{3}$")
}
