// Storefront on fullstack .NET — the same domain as
// `storefront-system.ddd` (Hono + React) and `storefront-elixir.ddd`
// (Phoenix LiveView), deployed as a single .NET service that hosts the
// React SPA from wwwroot/.
//
// Three-way diff target: pick this, `storefront-system`, and
// `storefront-elixir` from the dropdown to compare how the identical
// aggregate tree (Order → OrderLine), Money value-object and
// transactional `checkout` saga lower across Drizzle + Hono, EF Core +
// Mediator (.NET), and Phoenix LiveView on plain Ecto (Elixir).
//
// Files-only in the playground (.NET doesn't boot in-browser).

system StorefrontDotnet {

  theme {
    primary: "#7c3aed"
    neutral: "#64748b"
    radius: "md"
    fontFamily: "Inter, system-ui, sans-serif"
  }

  subdomain Storefront {
    context Storefront {

      enum OrderStatus { Draft, Confirmed, Shipped, Cancelled }
      enum WalletStatus { Open, Frozen, Closed }

      valueobject Money {
        amount: decimal
        currency: string
        invariant amountCannotBeNegative: amount >= 0
        invariant currencyMustBeThreeUppercaseLetters: currency.matches("^[A-Z]{3}$")
      }

      event OrderConfirmed { order: Order id, at: datetime }
      event WalletToppedUp { wallet: Wallet id, amount: Money, at: datetime }
      event WalletDebited { wallet: Wallet id, amount: Money, at: datetime }

      aggregate Customer with crudish {
        name: string check nameIsRequired: name.trim().length > 0
        email: string
        invariant emailMustBeValid: email.matches("^[^@]+@[^@]+\\.[^@]+$")
        invariant nameIsTooLong: name.length <= 100
        derived display: string = name
      }

      aggregate Product with crudish {
        sku: string
        price: Money
        invariant skuMustUseUppercaseLettersDigitsAndDashes: sku.matches("^[A-Z0-9][A-Z0-9-]{0,31}$")
        derived display: string = sku
      }

      aggregate Wallet with crudish {
        ownerId: Customer id
        status: WalletStatus
        balance: Money
        openedAt: datetime
        closedAt: datetime?

        function isMutable(): bool = status == Open

        invariant balanceCannotBeNegative: balance.amount >= 0
        invariant closedAtCannotPrecedeOpenedAt: closedAt == null || closedAt >= openedAt

        operation topUp(amount: Money) {
          precondition walletMustBeOpenToTopUp: isMutable()
          precondition topUpAmountMustBePositive: amount.amount > 0
          precondition topUpCurrencyMustMatchWallet: amount.currency == balance.currency
          balance := Money { amount: balance.amount + amount.amount, currency: balance.currency }
          emit WalletToppedUp { wallet: id, amount: amount, at: now() }
        }

        operation debit(amount: Money) {
          precondition walletMustBeOpenToDebit: isMutable()
          precondition debitAmountMustBePositive: amount.amount > 0
          precondition debitCurrencyMustMatchWallet: amount.currency == balance.currency
          precondition balanceMustCoverTheDebit: balance.amount >= amount.amount
          balance := Money { amount: balance.amount - amount.amount, currency: balance.currency }
          emit WalletDebited { wallet: id, amount: amount, at: now() }
        }

        operation freeze(reason: string) {
          precondition onlyOpenWalletsCanBeFrozen: status == Open
          precondition freezeReasonIsRequired: reason.trim().length > 0
          status := Frozen
        }
      }

      aggregate Order with crudish {
        customerId: Customer id
        status: OrderStatus
        placedAt: datetime
        contains lines: OrderLine[]

        derived lineCount: int = lines.count

        invariant confirmedOrderMustHaveAtLeastOneLine: lines.count > 0 when status == Confirmed

        function isMutable(): bool = status == Draft

        operation addLine(productId: Product id, unitPrice: Money, qty: int) {
          precondition onlyDraftOrdersCanTakeNewLines: isMutable()
          precondition quantityMustBePositive: qty > 0
          lines += OrderLine {
            productId: productId,
            unitPrice: unitPrice,
            quantity: qty
          }
        }

        operation confirm() {
          precondition onlyDraftOrdersCanBeConfirmed: isMutable()
          precondition orderMustHaveAtLeastOneLine: lines.count > 0
          status := Confirmed
          emit OrderConfirmed { order: id, at: now() }
        }

        entity OrderLine {
          productId: Product id
          unitPrice: Money
          quantity: int
          invariant lineQuantityMustBePositive: quantity > 0
        }
      }

      repository Customers for Customer { }
      criterion CustomersByEmail(email: string) of Customer = this.email == email
      repository Products for Product { }
      repository Wallets for Wallet { }
      criterion WalletsByOwner(owner: Customer id) of Wallet = this.ownerId == owner
      criterion WalletsOpenByOwner(owner: Customer id) of Wallet = this.ownerId == owner && this.status == Open
      repository Orders for Order { }

      // EF Core's pipeline keeps the order creation + wallet debit in
      // one DB transaction; a failing precondition throws
      // DomainException → 400 with the violated rule, and the
      // transaction rolls back.
      workflow checkout transactional {
        create(customerId: Customer id, walletId: Wallet id, productId: Product id, unitPrice: Money, qty: int) {
          precondition quantityMustBePositive: qty > 0
          let wallet = Wallets.get(walletId)
          let order = Order.create(
            customerId: customerId,
            status: Draft,
            placedAt: now()
          )
          order.addLine(productId, unitPrice, qty)
          order.confirm()
          wallet.debit(unitPrice)
        }
      }
    }
  }

  ui WebApp with scaffold(subdomains: [Storefront]) {
  }

  storage primary { type: postgres }
  resource storefrontState { for: Storefront, kind: state, use: primary }

  // Single fullstack .NET deployable — backend on /api/*, SPA
  // (shadcn pack for variety) served from wwwroot/ at /.
  deployable app {
    platform: dotnet
    contexts: [Storefront]
    dataSources: [storefrontState]
    ui: WebApp
    port: 8080
    design: shadcn
  }
}
