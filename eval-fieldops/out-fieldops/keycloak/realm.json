{
  "realm": "field_ops",
  "enabled": true,
  "sslRequired": "none",
  "roles": {
    "realm": [
      {
        "name": "user"
      },
      {
        "name": "agent"
      },
      {
        "name": "admin"
      }
    ]
  },
  "clients": [
    {
      "clientId": "field_ops-app",
