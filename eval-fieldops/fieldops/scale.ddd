  // --- infrastructure ---
  storage primary { type: postgres }
  storage bus     { type: redis }
  storage photos  { type: s3, config: { bucket: "fieldops-photos", region: "eu-central-1" } }
  storage mail    { type: smtp, config: { from: "no-reply@fieldops.example" } }

  resource fieldState { for: Field, kind: state,       use: primary }
  resource ctx1State { for: Ctx1, kind: state, use: primary }
  resource ctx2State { for: Ctx2, kind: state, use: primary }
  resource ctx3State { for: Ctx3, kind: state, use: primary }
  resource ctx4State { for: Ctx4, kind: state, use: primary }

  resource fieldPhotos{ for: Field, kind: objectStore, use: photos }
  resource fieldMail  { for: Field, kind: mailer,      use: mail }
  channelSource woBus { for: WorkOrderEvents, use: bus }

  ui WebApp with scaffold(subdomains: [Ops, Extra1, Extra2, Extra3, Extra4]) { }

  deployable api {
    platform: node,
    contexts: [Field, Ctx1, Ctx2, Ctx3, Ctx4],
    dataSources: [fieldState, ctx1State, ctx2State, ctx3State, ctx4State, fieldPhotos, fieldMail],
    channels: [woBus],
    auth: required,
    port: 3000
  }

  deployable webApp {
    platform: react,
    targets: api,
    ui: WebApp,
    design: mantine,
    port: 3001
  }
}

solution SOL-001 for AC-001 {
  title: "Skill matching enforced in the scheduleWorkOrder workflow"
  entitles [ Ops.Field.scheduleWorkOrder ]
}
