// Inventory bounded context — smaller demo with nested parts.
context Inventory {

  enum ReservationStatus { Held, Released, Consumed }

  valueobject Quantity {
    value: int
    invariant quantityCannotBeNegative: value >= 0
  }

  event ItemReserved {
    warehouse: Warehouse id,
    sku: string,
    qty: int
  }

  aggregate Warehouse with crudish {
    code: string check warehouseCodeMustBeUppercaseLettersDigitsOrDashes: code.matches("^[A-Z0-9][A-Z0-9-]*$") && code.length <= 20
    contains stocks: Stock[]

    function totalUnits(): int = stocks.sum(s => s.onHand.value)

    operation reserve(sku: string, qty: int) {
      precondition reservedQuantityMustBePositive: qty > 0
      precondition skuIsRequired: sku.trim().length > 0
      emit ItemReserved { warehouse: id, sku: sku, qty: qty }
    }

    entity Stock {
      sku: string check stockSkuIsRequired: sku.trim().length > 0
      onHand: Quantity
      reserved: Quantity
      derived available: Quantity = Quantity { value: onHand.value - reserved.value }
      invariant reservedCannotExceedOnHand: onHand.value >= reserved.value
    }
  }

  repository Warehouses for Warehouse { }
  criterion WarehousesByCode(code: string) of Warehouse = this.code == code
}

// The deployment: one node backend hosting the context, persisted to postgres.
system Inventory {
  storage db { type: postgres }
  resource inventoryState { for: Inventory, kind: state, use: db, index: [Warehouse.code] }
  deployable inventory { platform: node, contexts: [Inventory], dataSources: [inventoryState] }
}
