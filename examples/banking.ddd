// Banking bounded context — exercises optional fields, multiple
// aggregates with cross-references, and a richer `where` filter.
context Banking {

  enum AccountStatus { Open, Frozen, Closed }

  valueobject Money {
    amount: decimal
    currency: string
    invariant amountCannotBeNegative: amount >= 0
    invariant currencyMustBeThreeUppercaseLetters: currency.matches("^[A-Z]{3}$")
  }

  event AccountOpened {
    account: Account id,
    holder: Customer id,
    at: datetime
  }

  event AccountFrozen { account: Account id, reason: string, at: datetime }

  event MoneyDeposited { account: Account id, amount: Money, at: datetime }
  event MoneyWithdrawn { account: Account id, amount: Money, at: datetime }

  aggregate Customer with crudish {
    name: string check nameMustBeAtMostOneHundredCharacters: name.length <= 100
    email: string check emailMustBeAtMostOneHundredTwentyCharacters: email.length <= 120
    invariant nameIsRequired: name.trim().length > 0
    invariant emailMustBeValid: email.matches("^[^@]+@[^@]+\\.[^@]+$")
  }

  aggregate Account with crudish {
    holder: Customer id
    status: AccountStatus immutable
    balance: Money
    openedAt: datetime
    closedAt: datetime?
    contains transactions: AccountTransaction[]

    function isMutable(): bool = status == Open

    derived transactionCount: int = transactions.count

    invariant balanceCannotBeNegative: balance.amount >= 0
    invariant everyTransactionAmountMustBePositive: transactions.all(t => t.amount.amount > 0)

    operation deposit(amount: Money) {
      precondition onlyOpenAccountsAcceptDeposits: isMutable()
      precondition depositMustBePositive: amount.amount > 0
      precondition depositCurrencyMustMatchTheAccount: amount.currency == balance.currency
      balance := Money { amount: balance.amount + amount.amount, currency: balance.currency }
      transactions += AccountTransaction {
        amount: amount,
        kind: "Deposit",
        at: now()
      }
      emit MoneyDeposited { account: id, amount: amount, at: now() }
    }

    operation withdraw(amount: Money) {
      precondition onlyOpenAccountsAllowWithdrawals: isMutable()
      precondition withdrawalMustBePositive: amount.amount > 0
      precondition withdrawalCurrencyMustMatchTheAccount: amount.currency == balance.currency
      precondition balanceMustCoverTheWithdrawal: balance.amount >= amount.amount
      balance := Money { amount: balance.amount - amount.amount, currency: balance.currency }
      transactions += AccountTransaction {
        amount: amount,
        kind: "Withdrawal",
        at: now()
      }
      emit MoneyWithdrawn { account: id, amount: amount, at: now() }
    }

    // A zero-balance account has nothing left to protect, so freezing it
    // closes it outright.  The corpus's hand-written witness for the `if`
    // statement and the `??` operator (clause census).
    operation freeze(reason: string) {
      precondition onlyOpenAccountsCanBeFrozen: status == Open
      precondition freezeReasonIsRequired: reason.trim().length > 0
      if balance.amount > 0 {
        status := Frozen
      } else {
        status := Closed
        // `??` keeps an already-recorded close time rather than overwriting it.
        closedAt := closedAt ?? now()
      }
      emit AccountFrozen { account: id, reason: reason, at: now() }
    }

    entity AccountTransaction {
      amount: Money
      kind: string
      at: datetime
      invariant transactionAmountMustBePositive: amount.amount > 0
      invariant transactionKindIsRequired: kind.trim().length > 0
    }
  }

  repository Customers for Customer { }
  criterion CustomersByEmail(email: string) of Customer = this.email == email

  repository Accounts for Account { }
  criterion AccountsByHolder(holder: Customer id) of Account = this.holder == holder
  criterion AccountsOpenByHolder(holder: Customer id) of Account = this.holder == holder && this.status == Open
}

// The deployment: one node backend hosting the context, persisted to postgres.
system Banking {
  storage db { type: postgres }
  resource bankingState { for: Banking, kind: state, use: db, index: [Customer.email, Account.status] }
  deployable banking { platform: node, contexts: [Banking], dataSources: [bankingState] }
}
