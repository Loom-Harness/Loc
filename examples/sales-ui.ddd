// Sales — the page language as shipped, on the examples/sales.ddd domain.
//
// Reads alongside examples/sales.ddd (the bounded context, repeated here so
// the file is a whole system) and examples/acme.ddd (the system + deployable
// shell).  The page surface is documented in docs/page-metamodel.md.
//
// Shown:
//   1. `with scaffold(...)`   — List / New / Detail pages for aggregates,
//                               plus a Form page for the placeOrder workflow
//   2. `component`            — a typed region tree with instance actions
//   3. a query page           — QueryView over a repository read
//   4. a wizard by composition — `state` + `action` + `match`, no wizard keyword
//   5. a dashboard            — `Stat` / `Card` tiles over repository reads
//   6. `match` in a component — a predicate-arms expression
//   7. an explicit `menu`     — regroups the derived sidebar

system SalesAdminApp {

  subdomain Sales {
    context Sales {

      enum OrderStatus { Draft, Confirmed, Shipped, Cancelled }

      valueobject Money {
        amount: decimal
        currency: string
        invariant amount >= 0
        invariant currency.length == 3
      }

      event OrderConfirmed { order: Order id, at: datetime }

      aggregate Customer with crudish {
        name: string
        email: string
        invariant email.length > 0
        derived display: string = name
      }

      aggregate Product with crudish {
        sku: string
        price: Money
        derived display: string = sku
      }

      aggregate Order with crudish {
        customerId: Customer id
        status: OrderStatus
        placedAt: datetime
        contains lines: OrderLine[]

        invariant lines.count > 0 when status == Confirmed
        derived display: string = string(status)

        function isMutable(): bool = status == Draft

        operation confirm() {
          precondition isMutable()
          precondition lines.count > 0
          status := Confirmed
          emit OrderConfirmed { order: id, at: now() }
        }

        operation cancel() {
          status := Cancelled
        }

        entity OrderLine {
          productId: Product id
          quantity: int
          invariant quantity > 0
        }
      }

      repository Customers for Customer { }
      repository Products for Product { }
      repository Orders for Order { }

      workflow placeOrder {
        create(customerId: Customer id, placedAt: datetime) {
          let customer = Customers.getById(customerId)
          let order = Order.create(
            customerId: customerId,
            status: Draft,
            placedAt: placedAt
          )
        }
      }
    }
  }

  api SalesApi from Sales

  ui SalesAdmin with scaffold(aggregates: [Customer, Product], workflows: [placeOrder]) {
    api Sales: SalesApi

    // ── 2. Reusable component ──────────────────────────────────────
    // A typed function from params to a body.  No route, no menu.
    component OrderPanel(order: Order) {
      body: Stack {
        Heading { order.display, level: 2 },
        Toolbar {
          Action { order.confirm, then: toast("Confirmed") },
          Action { order.cancel, then: toast("Cancelled") }
        }
      }
    }

    // ── 3. A query page ────────────────────────────────────────────
    // Orders list with the panel mounted per row.
    page OrderConsole {
      route: "/orders"
      title: "Orders"
      body: QueryView {
        of: Sales.Order.all,
        loading: Loader {},
        empty: Empty { "No orders yet" },
        data: rows => Stack { For { each: rows, o => OrderPanel(order: o) } }
      }
      menu { section: "Sales", label: "Order console" }
    }

    // ── 4. Wizard via composition ──────────────────────────────────
    // `step` drives the body `match`; no special wizard machinery.
    page PlaceOrderWizard {
      route: "/orders/new"
      title: "New order"
      state { step: int = 0 }
      action toReview() { step := 1 }
      action back() { step := 0 }
      action done() { toast("Order placed") navigate(Home) }
      body: Stack { match {
        step == 0 => Stack {
          WorkflowForm { runs: placeOrder },
          Button { "Review", onClick: toReview }
        }
        step == 1 => Stack {
          Text { "Ready to place the order?" },
          Button { "Back", onClick: back },
          Button { "Done", onClick: done }
        }
        else => Empty { "Unknown step" }
      } }
      menu { section: "Sales", label: "New order" }
    }

    // ── 5. Dashboard ───────────────────────────────────────────────
    page Home {
      route: "/"
      title: "Sales dashboard"
      body: Stack {
        Heading { "Sales dashboard", level: 1 },
        QueryView {
          of: Sales.Order.all,
          loading: Loader {},
          empty: Empty { "No orders yet" },
          data: rows => Grid {
            Card { Stat { "Orders", rows.count } }
          }
        }
      }
      menu { section: "Reports", label: "Dashboard", order: 0 }
    }

    // ── 6. `match` inside a component ──────────────────────────────
    component RiskBadge(amount: int) {
      body: Badge { match {
        amount > 10000 => "high"
        amount > 1000 => "medium"
        else => "low"
      } }
    }

    // ── 7. Explicit menu ───────────────────────────────────────────
    menu {
      section "Sales" {
        link Home,
        link OrderConsole,
        link PlaceOrderWizard
      }
      section "External" {
        link "Loom docs" -> "https://docs.acme.com"
      }
    }
  }

  storage primary { type: postgres }
  resource salesState { for: Sales, kind: state, use: primary }

  deployable api {
    platform: node
    contexts: [Sales]
    dataSources: [salesState]
    serves: SalesApi
    port: 3000
  }

  deployable webApp {
    platform: react
    targets: api
    ui: SalesAdmin { Sales: api }
    port: 3001
  }
}
