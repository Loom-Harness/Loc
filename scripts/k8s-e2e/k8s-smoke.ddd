// Minimal, auth-free system used ONLY by the Kubernetes cluster smoke
// (scripts/k8s-e2e-smoke.sh).  One trivial CRUD aggregate served by every
// backend platform, so the nightly k8s-e2e matrix can fan the chart install +
// read/write round-trip across all backends with a SINGLE fixture (Loom's wire
// shape is identical across backends — scripts/k8s-e2e/k8s-smoke.smoke.json).
//
// Deliberately no auth / permissions / rich types: those make a generic write
// round-trip fragile (showcase needs an injected dev-claims header, a heavy
// datetime/decimal create body, and per-backend parsing parity).  A bare
// `Widget { name, quantity }` keeps the create body trivial and uniform.  The
// vanilla-Elixir backend is covered by a separate matrix cell over the proven
// examples/tasks-vanilla.ddd, so this system stays single-foundation.
system K8sSmoke {
  subdomain Catalog {
    context Inventory {
      aggregate Widget with crudish {
        name: string
        quantity: int
      }
      repository Widgets for Widget { }
    }
  }

  api InventoryApi from Catalog
  // One storage per backend: the matrix installs one chart at a time, and a
  // deployable sharing a storage leaves the migrations to the first deployable
  // on it — so each backend binds a database of its own and migrates it.
  storage honoDb    { type: postgres }
  storage dotnetDb  { type: postgres }
  storage pythonDb  { type: postgres }
  storage javaDb    { type: postgres }
  storage phoenixDb { type: postgres }
  resource honoState    { for: Inventory, kind: state, use: honoDb }
  resource dotnetState  { for: Inventory, kind: state, use: dotnetDb }
  resource pythonState  { for: Inventory, kind: state, use: pythonDb }
  resource javaState    { for: Inventory, kind: state, use: javaDb }
  resource phoenixState { for: Inventory, kind: state, use: phoenixDb }

  // One deployable per backend platform — same context for OpenAPI parity, so
  // the matrix installs exactly one at a time via the chart's `enabled` toggle.
  deployable honoApi    { platform: node   contexts: [Inventory] dataSources: [honoState]    serves: InventoryApi port: 3000 }
  deployable dotnetApi  { platform: dotnet contexts: [Inventory] dataSources: [dotnetState]  serves: InventoryApi port: 8080 }
  deployable pythonApi  { platform: python contexts: [Inventory] dataSources: [pythonState]  serves: InventoryApi port: 8000 }
  deployable javaApi    { platform: java   contexts: [Inventory] dataSources: [javaState]    serves: InventoryApi port: 8081 }
  deployable phoenixApi { platform: elixir contexts: [Inventory] dataSources: [phoenixState] serves: InventoryApi port: 4000 }
}
