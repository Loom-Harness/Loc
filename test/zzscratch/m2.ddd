system P {
  subdomain O {
    context Projects {
      enum Status { Draft, Done }
      aggregate Task with crudish {
        title: string
        status: Status
        operation complete() { status := Done }
      }
      repository Tasks for Task { }
    }
  }
  api A from O { }
  ui Web {
    page Home {
      route: "/"
      body: Stack {
        Heading { plural(Task) },
        Text { label(Task.title) },
        Text { label(Projects.Task.complete) },
        Button { label(Status.Draft) },
        Text { label(Task) }
      }
    }
  }
  storage primary { type: postgres }
  resource st { for: Projects, kind: state, use: primary }
  deployable api { platform: node, contexts: [Projects], dataSources: [st], serves: A, port: 3000 }
  deployable web { platform: react, targets: api, ui: Web, port: 3001, design: mantine }
}
