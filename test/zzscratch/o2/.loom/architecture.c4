// Loom architecture model (LikeC4) — generated from the IR, do not edit by hand.
// System: P

specification {
  element system
  element container
  element component
  element database
}

model {
  P = system 'P' {
    description 'Loom-generated system'
    api = container 'api' {
      technology 'node'
      Projects = component 'Projects'
    }
    web = container 'web' {
      technology 'react'
    }
    db = database 'PostgreSQL'

    api -> db 'reads / writes'
    web -> api 'calls'
  }
}

views {
  view index {
    title 'P — landscape'
    include *
  }
  view of P {
    title 'P — containers'
    include *
  }
}
