{
  "openapi": "3.0.3",
  "paths": {
    "/things/{id}/act": {
      "post": {
        "operationId": "act",
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Result"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Result": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/Result_Thing"
          },
          {
            "$ref": "#/components/schemas/Result_Other"
          }
        ]
      },
      "Result_Thing": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "Thing"
            ]
          },
          "name": {
            "type": "integer"
          }
        },
        "required": [
          "type",
          "name"
        ]
      },
      "Result_Other": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "Other"
            ]
          },
          "code": {
            "type": "integer"
          }
        },
        "required": [
          "type",
          "code"
        ]
      }
    }
  }
}
