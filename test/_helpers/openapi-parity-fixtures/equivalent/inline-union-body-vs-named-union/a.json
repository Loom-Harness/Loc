{
  "openapi": "3.0.3",
  "paths": {
    "/shapes/{id}": {
      "get": {
        "operationId": "op",
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/Circle"
                    },
                    {
                      "$ref": "#/components/schemas/Square"
                    }
                  ],
                  "discriminator": {
                    "propertyName": "type"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Circle": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "circle"
            ]
          },
          "radius": {
            "type": "number"
          }
        },
        "required": [
          "type",
          "radius"
        ]
      },
      "Square": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "square"
            ]
          },
          "side": {
            "type": "number"
          }
        },
        "required": [
          "type",
          "side"
        ]
      }
    }
  }
}
