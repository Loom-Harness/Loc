{
  "openapi": "3.0.3",
  "paths": {
    "/things/{id}/act": {
      "post": {
        "operationId": "act",
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Result"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Result": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "Thing"
                ]
              },
              "name": {
                "type": "string"
              }
            },
            "required": [
              "type",
              "name"
            ]
          }
        ]
      }
    }
  }
}
