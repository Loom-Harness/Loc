// THE OVER-FIRE GUARD for `src/language/validators/stmt-placement.ts`.
//
// All three gated statements in the homes that DO lower them, in one source:
// `for` and `if let` in a workflow `create` body and in a `commandHandler`;
// the statement form of `match` in a page `action` (through `match await`), an
// operation, a domain-service operation, a workflow `create` and a
// `commandHandler`; and the value form of `match` in an operation body.
// A gate that fires here is refusing valid programs — which is the failure mode
// a placement rule is most likely to have, so the test asserts the three
// placement codes are ABSENT rather than that the file is diagnostic-free.
system AllowedPlacement {
  subdomain D {
    context Shop {
      error NotAllowed { reason: string }
      aggregate Order with crudish {
        code: string
        reserved: bool
        operation place(): Order or NotAllowed { reserved := true  return this }
        operation reserve() { reserved := true }
        // The VALUE form of a variant `match` over an `or`-returning
        // operation's result.
        operation describe(): string {
          let r = place()
          let t = match r { Order o => o.code, NotAllowed e => e.reason }
          return t
        }
        // The STATEMENT form in an operation body, over the same result.
        operation settle() {
          let r = place()
          match r {
            Order o => { code := o.code }
            NotAllowed e => { code := e.reason }
          }
        }
      }
      domainService Vetting {
        operation vet(code: string): string or NotAllowed {
          return code
        }
        // A `T?` subject: the arm runs on present, `else` on absent.
        operation explain(code: string?): string {
          match code {
            string s => { return s }
            else => { return "none" }
          }
        }
      }
      criterion ByCode(code: string) of Order = this.code == code
      retrieval Coded(code: string) of Order { where: ByCode(code) }
      repository Orders for Order { }

      // `for` + `if let` in a workflow body — the `for-each` / `if-let`
      // WorkflowStmtIR kinds.
      workflow sweep {
        create(code: string) {
          let matched = Orders.all(Coded(code), page: { offset: 0, limit: 100 })
          for o in matched { o.reserve() }
          if let hit = Orders.find(ByCode(code)) { hit.reserve() }
          let verdict = Vetting.vet(code)
          match verdict {
            string s => { }
            NotAllowed e => { }
          }
        }
      }

      // …and in a top-level handler, which shares the workflow lowering.
      commandHandler sweepAgain(code: string) {
        let more = Orders.all(Coded(code), page: { offset: 0, limit: 100 })
        for o in more { o.reserve() }
        if let hit = Orders.find(ByCode(code)) { hit.reserve() }
        let one = Orders.find(ByCode(code))
        match one {
          Order o => { o.reserve() }
          else => { notFound }
        }
      }
    }
  }
  api A from D
  storage primary { type: postgres }
  resource st { for: Shop, kind: state, use: primary }

  ui Console {
    api Orders: A
    page OrderPage(id: Order id) {
      route: "/orders/:id"
      state { message: string = "" }
      // The effect form of `match` in its one legal home.
      action place() {
        match await Orders.Order.place() {
          Order o => { message := "placed" }
          NotAllowed e => { message := e.reason }
        }
      }
      body: Stack { Text { message }, Button { "Place", onClick: place } }
    }
  }

  deployable d { platform: node, contexts: [Shop], dataSources: [st], serves: A, port: 4000 }
  deployable web { platform: react, targets: d, ui: Console { Orders: d }, port: 3000 }
}
