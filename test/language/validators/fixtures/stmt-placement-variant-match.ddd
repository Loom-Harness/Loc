// REFUSED SHAPE — `loom.variant-match-placement`.
//
// The statement form of `match` (arms that run statements) in a block-bodied
// `function`.  A function computes a value, so it has no statement form of
// `match` on any backend; the value form (`let t = match r { … }`) is the one
// that fits.  The same statement in an operation, a workflow or a handler is
// legal (`stmt-placement-allowed.ddd`).
//
// It lives here rather than in `test/fixtures/corpus/` because that corpus is a
// POSITIVE matrix: every `<id>.ddd` there must generate cleanly on each backend
// its manifest row declares, so a source the compiler refuses has no row shape
// to take.  Refusal fixtures live beside their validator test.
system VariantMatchPlacement {
  subdomain D {
    context Shop {
      aggregate Order {
        code: string
        note: string?
        function noteLabel(): string {
          match note {
            string s => { let shown = s }
            else => { let shown = code }
          }
          return code
        }
      }
      repository Orders for Order { }
    }
  }
  api A from D
  storage primary { type: postgres }
  resource st { for: Shop, kind: state, use: primary }
  deployable d { platform: node, contexts: [Shop], dataSources: [st], serves: A, port: 4000 }
}
