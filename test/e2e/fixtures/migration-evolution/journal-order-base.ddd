// Journal-ordering gate (F-012) — the BASE model (v1).
//
// Paired with journal-order-evolved.ddd (v2).  The sibling base/evolved pair
// is SINGLE-MODULE and non-provenanced, so a journal key derived from position
// or version comes out monotonic there by accident.  Two things make this pair
// reach a mis-ordered journal:
//
//   • TWO subdomains, so the chain records two Initials, and the v2 delta can
//     number below an entry already applied.  Any journal key derived from the
//     version would sort it behind one already applied, and Drizzle's watermark
//     migrator (`lastApplied.created_at < entry.when`) would skip it in silence.
//
//   • a `provenanced` field, whose `total_provenance` lineage column ships in
//     Billing's Initial.  An entry that re-added it on the second boot would
//     kill the process on `column "total_provenance" … already exists`.
//
// v1 → v2 is the most ordinary evolution there is: one nullable field added to
// the FIRST module's aggregate.  `__PLATFORM__` is substituted by the harness,
// but only node/Drizzle is wired to this gate — it is the one backend whose
// migrator is a watermark rather than an applied-set (EF, Flyway, Alembic and
// Ecto all track each migration by identity, so none of them can renumber).
system ShopJournal {
  subdomain Catalog {
    context Catalog {
      aggregate Product with crudish {
        name: string
        price: money
      }
      repository Products for Product { }
    }
  }
  subdomain Billing {
    context Billing {
      aggregate Invoice with crudish {
        ref: string
        total: int provenanced
      }
      repository Invoices for Invoice { }
    }
  }
  api CatalogApi from Catalog
  api BillingApi from Billing
  storage primary { type: postgres }
  resource catalogState { for: Catalog, kind: state, use: primary }
  resource billingState { for: Billing, kind: state, use: primary }
  deployable d {
    platform: __PLATFORM__
    contexts: [Catalog, Billing]
    dataSources: [catalogState, billingState]
    serves: CatalogApi, BillingApi
    port: 4000
  }
}
