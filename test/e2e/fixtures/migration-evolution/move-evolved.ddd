// Cross-context move gate — the EVOLVED model (v2).  See move-base.ddd.
//
// `Note` and `Ledger` now live in context `B` of the new module Archive; the
// migration block declares the move, so their tables (and the `a_events` log,
// which no stream is left in) move schema instead of dropping and recreating.
system MoveEvo {
  subdomain Notes {
    context A {
      aggregate Keep with crudish { name: string }
      repository Keeps for Keep { }
    }
  }
  subdomain Archive {
    context B {
      aggregate Note with crudish {
        text: string
        contains lines: Line[]
        entity Line { sku: string }
      }
      repository Notes for Note { }
      event Charged { ledgerId: Ledger id, amount: int }
      aggregate Ledger persistedAs: eventLog {
        balance: int
        operation charge(amount: int) { emit Charged { ledgerId: id, amount: amount } }
        apply(e: Charged) { balance := balance + e.amount }
      }
      repository Ledgers for Ledger { }
    }
  }
  api NotesApi from Notes
  storage primary { type: postgres }
  resource aState { for: A, kind: state, use: primary }
  resource bState { for: B, kind: state, use: primary }
  resource bLog { for: B, kind: eventLog, use: primary }
  deployable d {
    platform: __PLATFORM__
    contexts: [A, B]
    dataSources: [aState, bState, bLog]
    serves: NotesApi
    port: 4000
  }
}

migration "move-to-archive" {
  A.Note -> B.Note
  A.Ledger -> B.Ledger
}
