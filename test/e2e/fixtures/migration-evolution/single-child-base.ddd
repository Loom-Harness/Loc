// Single-child uniqueness gate — BASE model (v1): `shipments` is a collection
// containment, so its parent FK carries a plain (non-unique) index.
system SingleChild {
  subdomain Ordering {
    context Ord {
      aggregate Order {
        code: string
        contains shipments: Shipment[]
        entity Shipment { carrier: string }
      }
      repository Orders for Order { }
    }
  }
  api OrdApi from Ordering
  storage primary { type: postgres }
  resource ordState { for: Ord, kind: state, use: primary }
  deployable d {
    platform: __PLATFORM__
    contexts: [Ord]
    dataSources: [ordState]
    serves: OrdApi
    port: 4000
  }
}
