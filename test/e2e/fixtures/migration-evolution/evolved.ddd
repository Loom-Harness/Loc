// Migration-evolution gate (M-T2.13) — the EVOLVED model (v2).  See base.ddd
// for the harness flow.  Every change is data-preserving and gate-clean (no
// `--allow-destructive` needed):
//
//   • `price` renamed to `unitPrice`  — explicit `migration` rename intent, so
//     the diff emits `renameColumn` (value preserved), not drop+add.
//   • `sku: string` added NOT NULL    — covered by the `Product.sku = "SEED"`
//     backfill, a constant, so the column is added `DEFAULT 'SEED'` and the
//     default dropped again (catalog-only on PG11+), no flag needed.
//   • `label: string` added NOT NULL  — covered by the `Product.label = name`
//     backfill, an expression, so the column is added nullable in the DDL
//     transaction and filled + proved NOT NULL in the generation's
//     non-transactional unit (no ACCESS EXCLUSIVE lock held over the UPDATE).
//   • `description: string?` added     — a plain nullable column.
//   • `shelf: Shelf?` added            — an optional value object holding an
//     enum, so the delta adds the enum's value-set CHECK on its leaf column.
//     A backend that stores the value object as one json column (Ecto, the
//     Dapper adapter) has no leaf column, and must add no CHECK naming one.
//   • `status: string` narrowed to `status: Status` — same TEXT column, new
//     value set.  Non-destructive: the constraint is added `NOT VALID`, so the
//     seeded v1 row survives whatever it holds (the harness seeds a value the
//     enum still admits, so the surviving-row assertion stays exact).
//   • `Stage.draft` renamed to `drafted` — the declared enum value rename
//     updates the stored `'draft'` to `'drafted'` after the CHECK is re-added.
//
// The `migration` block is ledger-style: permanent in source, inert once baked
// into the baseline snapshot.
system ShopEvo {
  subdomain Catalog {
    context Catalog {
      enum Status { draft, live }
      enum Stage { drafted, done }
      enum Aisle { front, back }
      valueobject Shelf { row: int  aisle: Aisle }
      aggregate Product with crudish {
        name: string
        unitPrice: money
        sku: string
        label: string
        description: string?
        shelf: Shelf?
        status: Status
        stage: Stage
      }
      repository Products for Product { }
    }
  }
  api CatalogApi from Catalog
  storage primary { type: postgres }
  resource catalogState { for: Catalog, kind: state, use: primary }
  deployable d {
    platform: __PLATFORM__
    contexts: [Catalog]
    dataSources: [catalogState]
    serves: CatalogApi
    port: 4000
  }
}

migration "evolve-catalog" {
  Product.price -> unitPrice
  Product.sku = "SEED"
  Product.label = name
  Stage.draft -> drafted
}
