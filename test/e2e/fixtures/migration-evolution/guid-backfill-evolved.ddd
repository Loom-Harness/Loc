// Guid backfill evolution gate — EVOLVED model (v2), paired with
// field-default-base.ddd (v1).  The ONE difference is a required `guid` field
// added to an aggregate already in the migration baseline, filled for the
// existing rows by a UUID written as a string literal.
//
// `__PLATFORM__` is swapped per backend by the harness.
system OrderDefaults {
  subdomain Ordering {
    context Ord {
      aggregate Order {
        note: string
        ref: guid
      }
      repository Orders for Order { }
    }
  }
  api OrdApi from Ordering
  storage primary { type: postgres }
  resource ordState { for: Ord, kind: state, use: primary }
  deployable d {
    platform: __PLATFORM__
    contexts: [Ord]
    dataSources: [ordState]
    serves: OrdApi
    port: 4000
  }
}

migration "fill-ref" { Order.ref = "22222222-2222-4222-8222-222222222222" }
