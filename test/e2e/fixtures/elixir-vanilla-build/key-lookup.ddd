// Natural-key reads (D-REPO-KEY-LOOKUP): `Repo.getBy(<col>: v, …)` and
// `Repo.findBy(…)` over the aggregate's declared `unique (…)` tuples.
//
// Every read shape a body can make is here, on all five backends:
//   - `getBy` bound by a `let` in a workflow, a commandHandler and a
//     queryHandler (a miss answers 404);
//   - `findBy` as an `if let` source (`T?`), in a workflow and a handler;
//   - a composite tuple `(region, name)` called with its arguments out of
//     declared order (both spellings reach ONE method, `findByRegionAndName`);
//   - `ignoring *` widening a read past the `softDeletable` filter (its own
//     method);
//   - a `domainService` reading op (`findBy(…) != null`, `find(C) == null`);
//   - a criterion read with `Repo.find(<Criterion>)`, the target for a key no
//     `unique (…)` declares;
//   - `ignoring …` on `find(C)` (an `if let` source in a workflow, a
//     commandHandler and a correlated event reactor; a domainService read) and on
//     `findById` (a domainService read) — each widened read calls a method of
//     its own that skips the `softDeletable` filter.
// Compiled by each backend's `LOOM_*_BUILD` gate.
system KeyShop {
  subdomain Sales {
    context Catalog {
      aggregate Product with crudish, softDeletable {
        sku: string
        name: string
        region: string
        price: int
        archived: bool
        unique (sku)
        unique (region, name)
        operation reprice(to: int) { price := to }
        operation archive() { archived := true }
      }
      repository Products for Product { }

      // A key no `unique (…)` declares is a criterion, read with `find(C)`
      // (the codemod's target for a non-unique single-row find).
      criterion ProductsInRegion(region: string) of Product = this.region == region

      domainService ProductQueries {
        operation skuTaken(sku: string): bool {
          return Products.findBy(sku: sku) != null
        }
        operation regionEmpty(region: string): bool {
          return Products.find(ProductsInRegion(region)) == null
        }
        operation regionEverUsed(region: string): bool {
          return Products.find(ProductsInRegion(region)) ignoring * != null
        }
        operation everExisted(id: Product id): bool {
          return Products.findById(id) ignoring softDeletable != null
        }
      }

      workflow repriceFirstInRegion {
        create(region: string, to: int) {
          if let p = Products.find(ProductsInRegion(region)) { p.reprice(to) }
        }
      }

      workflow repriceFirstInRegionEvenDeleted {
        create(region: string, to: int) {
          if let p = Products.find(ProductsInRegion(region)) ignoring softDeletable {
            p.reprice(to)
          }
        }
      }

      workflow archiveFirstInRegionEver {
        create(region: string) {
          if let p = Products.find(ProductsInRegion(region)) ignoring * { p.archive() }
        }
      }

      // A correlated reactor (`on(…) by …`) — its body renders through each
      // backend's event-dispatch path, not the command path.
      event ListingWatched { product: Product id, region: string }
      event ListingClosed { product: Product id, region: string }
      workflow ListingWatch {
        productId: Product id
        create(w: ListingWatched) by w.product { }
        on(c: ListingClosed) by c.product {
          if let p = Products.find(ProductsInRegion(c.region)) ignoring softDeletable {
            p.archive()
          }
        }
      }

      workflow repriceBySku {
        create(sku: string, to: int) {
          let p = Products.getBy(sku: sku)
          p.reprice(to)
        }
      }

      workflow archiveIfListed {
        create(region: string, name: string) {
          if let p = Products.findBy(name: name, region: region) {
            p.archive()
          }
        }
      }

      queryHandler ProductBySku(sku: string): Product {
        let p = Products.getBy(sku: sku)
        return p
      }

      queryHandler AnyProductBySku(sku: string): Product {
        let p = Products.getBy(sku: sku) ignoring *
        return p
      }

      commandHandler RepriceListing(region: string, name: string, to: int): Product id {
        let p = Products.getBy(region: region, name: name)
        p.reprice(to)
        return p.id
      }

      commandHandler ArchiveFirstInRegion(region: string): int {
        if let p = Products.find(ProductsInRegion(region)) ignoring softDeletable {
          p.archive()
        }
        return 0
      }

      commandHandler ArchiveListing(name: string, region: string): int {
        if let p = Products.findBy(region: region, name: name) {
          p.archive()
        }
        return 0
      }
    }
  }
  api CatalogApi from Sales {
    route GET  "/products/by-sku/{sku}"          -> Catalog.ProductBySku
    route GET  "/products/any-by-sku/{sku}"      -> Catalog.AnyProductBySku
    route POST "/products/listing/reprice"       -> Catalog.RepriceListing
    route POST "/products/listing/archive"       -> Catalog.ArchiveListing
    route POST "/products/region/archive"        -> Catalog.ArchiveFirstInRegion
  }
  storage pg { type: postgres }
  resource st { for: Catalog, kind: state, use: pg }
  deployable nodeApi   { platform: node,   contexts: [Catalog], dataSources: [st], serves: CatalogApi, port: 5001 }
  deployable dotnetApi { platform: dotnet, contexts: [Catalog], dataSources: [st], serves: CatalogApi, port: 5002 }
  deployable javaApi   { platform: java,   contexts: [Catalog], dataSources: [st], serves: CatalogApi, port: 5003 }
  deployable pythonApi { platform: python, contexts: [Catalog], dataSources: [st], serves: CatalogApi, port: 5004 }
  deployable elixirApi { platform: elixir, contexts: [Catalog], dataSources: [st], serves: CatalogApi, port: 5005 }
}
