// The LiveView twin of `vanilla-tenancy.ddd`: every LiveView read over a
// principal-filtered aggregate — the scaffolded paged list and by-id detail,
// and a hand-written page reading a criterion's paged find — threads the socket's
// `current_user` into its context function, so `mix compile
// --warnings-as-errors` checks every call against the arity the context
// module declares.
system TenancyShopLive {
  user {
    id: string
    tenantId: string
  }

  auth {
    enforcement: opt
    provider: keycloak
    oidc {
      issuer: env("OIDC_ISSUER")
      clientId: env("OIDC_CLIENT_ID")
    }
    claims: { tenantId: "tenant_id" }
  }

  subdomain Core {
    context Ledger with scaffoldPaged(of: AccountsWithMinBalance) {
      aggregate Account with crudish {
        tenantId: string
        balance: int
        // Always-on row scoping: every read is constrained to the principal's tenant.
        filter this.tenantId == currentUser.tenantId
      }
      repository Accounts for Account
      // A criterion read (its `scaffoldPaged` find) exercises the
      // threaded-actor find path.
      criterion AccountsWithMinBalance(min: int) of Account = this.balance >= min
    }
  }

  storage primary { type: postgres }
  resource ledgerState { for: Ledger, kind: state, use: primary, index: [Account.tenantId, Account.balance] }

  api LedgerApi with scaffoldPagedApi(of: AccountsWithMinBalance) from Core
  ui Web with scaffold(subdomains: [Core]) {
    page Rich {
      route: "/rich"
      state { min: int = 0 }
      body: QueryView {
        of: Account.findAllByAccountsWithMinBalance(min),
        data: rows => Stack { For { each: rows, a => Text { a.tenantId } } }
      }
    }
  }
  deployable api {
    platform: elixir
    contexts: [Ledger]
    serves: LedgerApi
    dataSources: [ledgerState]
    port: 4000
    auth: required
    ui: Web
  }
}
