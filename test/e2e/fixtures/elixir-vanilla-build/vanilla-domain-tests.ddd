// Domain `test "..."` blocks on the vanilla foundation — the parity gate for
// the pure-domain-core test emission (docs/audits/test-parity-generated-backends.md).
//
// The aggregate carries a pure domain core (`src/generator/elixir/vanilla/
// domain-core-emit.ts`): `create/1` validates via `apply_action` and `confirm/2`
// runs precondition + in-memory mutation, both Repo-free.  The emitted ExUnit
// suite (`vanilla/tests-emit.ts`) exercises create / op / toThrow / field reads
// and MUST pass `mix test` with no database — the build harness runs it whenever
// a generated project carries `test/test_helper.exs`.
//
// Also pins F6 (field defaults): `status` defaults to "open", so `create` may
// omit it and the validated struct still carries the default; and F5 (value-
// object invariant enforcement): `Money` has a validating constructor, so a
// negative amount is rejected both standalone and through the aggregate create.
system Shop {
  subdomain Sales {
    context Selling {
      valueobject Money {
        amount: money
        currency: string
        invariant amount >= 0.0
      }
      aggregate Clerk {
        name: string
      }
      aggregate Order {
        customer: string
        status: string = "open"
        total: int = 0
        price: Money?
        clerkId: Clerk id?
        dispatchedAt: datetime?
        invariant customer.length > 0
        operation confirm() {
          precondition status == "open"
          status := "confirmed"
        }
        operation dispatch(clerk: Clerk id, at: datetime) {
          clerkId := clerk
          dispatchedAt := at
        }

        // Create relying on the field default (F6) + an invariant rejection.
        test "a fresh order takes its defaults" {
          let o = Order.create({ customer: "acme" })
          expect(o.status).toBe("open")
          expect(o.total).toBe(0)
        }
        test "blank customer is rejected" {
          expect(Order.create({ customer: "" })).toThrow()
        }
        // Operation happy-path (state threaded) + precondition rejection.
        test "confirming an open order makes it confirmed" {
          let o = Order.create({ customer: "acme" })
          o.confirm()
          expect(o.status).toBe("confirmed")
        }
        test "confirming a confirmed order is rejected" {
          let o = Order.create({ customer: "acme", status: "confirmed" })
          expect(o.confirm()).toThrow()
        }
        // F5 — value-object invariant enforced at construction AND through the
        // aggregate create (validate_vo over the `:map` price field).
        test "a negative money is rejected" {
          expect(Money { amount: -1.0, currency: "USD" }).toThrow()
        }
        test "a valid money builds" {
          let m = Money { amount: 10.5, currency: "USD" }
          expect(m.currency).toBe("USD")
        }
        test "an order with a negative price is rejected" {
          expect(Order.create({ customer: "acme", price: Money { amount: -5.0, currency: "USD" } })).toThrow()
        }
        // F2 — an `<Agg> id` / `datetime` LITERAL passed to an operation
        // parameter.  The op's PURE CORE (the Repo-free entry point this suite
        // calls) reads the attrs map and assigns the value STRAIGHT onto the
        // struct, unlike its context-wrapper sibling `Core.dispatch_order/2`,
        // which coerces the same wire text first — so a bare ISO-8601 string
        // landed a BINARY in a `:utc_datetime` field.  An id stays raw: an
        // Ecto `:binary_id` IS the uuid string at runtime.  `mix test` here
        // asserts on the STORED value, so a binary fails the DateTime compare.
        test "an id and a datetime literal reach an operation parameter" {
          let o = Order.create({ customer: "acme" })
          o.dispatch("00000000-0000-0000-0000-000000000002", "2026-02-02T12:30:00Z")
          expect(o.clerkId).toBe("00000000-0000-0000-0000-000000000002")
          expect(o.dispatchedAt.year).toBe(2026)
        }
        test "an order with a valid price is created" {
          let o = Order.create({ customer: "acme", price: Money { amount: 5.0, currency: "USD" } })
          expect(o.customer).toBe("acme")
        }
      }
      repository Orders for Order { }
      repository Clerks for Clerk { }
    }
  }
  api SalesApi from Sales
  storage pg { type: postgres }
  resource sellingState { for: Selling, kind: state, use: pg }
  deployable api {
    platform: elixir
    contexts: [Selling]
    dataSources: [sellingState]
    serves: SalesApi
    port: 4000
  }
}
