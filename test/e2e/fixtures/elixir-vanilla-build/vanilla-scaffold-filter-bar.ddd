// The scaffolded list page's FILTER BAR (audit P10).  A bar-eligible
// `find byName(n: string): Item[]` makes `scaffold` grow the list page a text
// input plus a `match` arm, and that is the only shape in this corpus that
// emits three constructs `mix compile --warnings-as-errors` had never seen
// together:
//
//   - a `match`-arm-guarded load — `socket = if <pred> do … else socket end`
//     wrapping the `case <Ctx>.<find>(…) do` block, one per arm, with the `all`
//     fallback under the negation (`if not (…) do`);
//   - a state-bound `<.input … phx-change="update_<field>">` over a MULTI-WORD
//     assign (`by_name_n`), which used to render as a disabled `_unbound` stub;
//   - the write-back clause that re-runs those guarded loads, so the two live
//     side by side in one `handle_event/3` body.
//
// All three are emitted Elixir the compile tier can actually judge: an
// unbalanced `if`/`else`, a rebinding that leaves `socket` unused, or a guard
// referencing an assign `mount/3` never seeds all fail here rather than at
// request time.
system ScaffoldFilterBar {
  subdomain Retail {
    context Catalog {
      aggregate Item with crudish {
        name: string
        qty: int
      }
      repository Items for Item {
        find byName(n: string): Item[] where this.name == n
      }
    }
  }

  api CatalogApi from Retail
  storage primary { type: postgres }
  resource catalogState { for: Catalog, kind: state, use: primary }

  ui Live with scaffold(contexts: [Catalog]) {
    api Catalog: CatalogApi
  }

  deployable api {
    platform: elixir
    contexts: [Catalog]
    dataSources: [catalogState]
    serves: CatalogApi
    ui: Live { Catalog: api }
    port: 4000
  }
}
