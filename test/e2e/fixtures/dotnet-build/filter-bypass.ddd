// `ignoring` filter-bypass clause (named-filter-bypass.md §11) on .NET (the
// EF `IgnoreQueryFilters`).  Compiles every read site under
// `dotnet build /warnaserror`:
//   - a single-row `if let … = Repo.find(C) ignoring softDeletable` (a named
//     capability filter), which derives its own repository method
//   - a single-row `if let … = Repo.find(C) ignoring *` (ALL filters)
//   - an inline `Repo.findAll(...) ignoring …` in a workflow body, which passes
//     a runtime `FilterBypass` to the criterion's retrieval
//
// `softDeletable` contributes the EF `IsDeletedFilter` named query filter (via
// `HasQueryFilter("IsDeletedFilter", …)`); each bypass resolves to it and emits
// `.IgnoreQueryFilters(["IsDeletedFilter"])` (or the parameterless overload for
// `*`) on the IQueryable before the spec/WHERE composes.
system PS {
  capability softDeletable {
    isDeleted: bool
    filter this.isDeleted == false
  }
  subdomain D {
    context Shop {
      criterion BigOrders() of Order = this.total > 0
      aggregate Order with softDeletable {
        total: int
      }
      repository Orders for Order
      criterion OrdersRecent of Order = this.total > 0
      criterion OrdersNormal of Order = this.total > 0
      workflow Sweep {
        create(x: int) {
          let scoped = Orders.findAll(BigOrders()) ignoring softDeletable
          let everything = Orders.findAll(BigOrders()) ignoring *
          for o in scoped { }
          for o in everything { }
          if let recent = Orders.find(OrdersRecent()) ignoring softDeletable { }
          if let normal = Orders.find(OrdersNormal()) ignoring * { }
        }
      }
    }
  }
  api A from D
  storage primary { type: postgres }
  resource st { for: Shop, kind: state, use: primary }
  deployable api { platform: dotnet, contexts: [Shop], dataSources: [st], serves: A, port: 8081 }
}
