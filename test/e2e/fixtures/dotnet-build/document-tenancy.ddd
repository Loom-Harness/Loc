// `shape: document` × capability filters × the `policy` read/write ladder, on
// the .NET (EF Core) backend.
//
// `dapper-document.ddd` had the shape and `dapper-tenancy.ddd` had the filter;
// nothing crossed them on the EF adapter, and the java backend's sibling
// (`java-build/document-tenancy.ddd`) covered only java.  A document
// aggregate's persistence record is `(Id, Data jsonb, Version)`, so the
// filtered fields live INSIDE the blob: EF has no mapped column to hang a
// `HasQueryFilter` on, and before the fix .NET emitted NO filter at all while
// `validateContextFilterSupport` claimed it filters every shape.  The filter is
// now applied IN-APP over the rehydrated aggregate, mirroring node/java/python.
//
// `Ledger` is the RELATIONAL control carrying the identical capability +
// policy: it must keep its EF `HasQueryFilter`, so a fix that wrongly migrated
// the relational path to in-app filtering shows up as a diff here rather than
// as uniform silence.
system DotnetDocTenancy {
  user { id: guid  tenantId: string }

  tenancy by user.tenantId of Org

  subdomain Core {
    context Books {
      // The tenant floor on reads, and a `deny write` carve-out on both twins:
      // the narrowed write scope is what makes `GetByIdForWriteAsync` exist,
      // so the document repository has to implement it (CS0535 otherwise).
      policy {
        allow local on Note
        deny write on Note
        allow local on Ledger
        deny write on Ledger
      }

      // The DOCUMENT twin — one jsonb column, so its `tenantId` is inside the
      // blob and the floor must run in-app.  `crudish` gives it
      // the update/destroy command loads, which is what actually reaches the
      // write-scope seam.
      aggregate Note shape: document, with tenantOwned, crudish {
        title: string
        body: string
        contains tags: Tag[]
        entity Tag { label: string }
        operation retitle(t: string) { title := t }
      }

      // The RELATIONAL control — identical capability + policy, real columns.
      aggregate Ledger with tenantOwned, crudish {
        label: string
        amount: int
      }

      // The tenant registry, opted into the tree.
      aggregate Org with crudish {
        name: string
        implements tenantRegistry
      }

      repository Notes for Note { }
      // A named find on the document aggregate: the capability predicate has
      // to narrow the rehydrated set BEFORE the author's own `where` runs,
      // not just on the auto `findAll`.
      criterion NotesByTitle(t: string) of Note = this.title == t
      repository Ledgers for Ledger { }
      criterion LedgersByLabel(l: string) of Ledger = this.label == l
      repository Orgs for Org { }
    }
  }

  api BooksApi from Core
  storage primary { type: postgres }
  resource booksState { for: Books, kind: state, use: primary }
  deployable api {
    platform: dotnet
    contexts: [Books]
    dataSources: [booksState]
    serves: BooksApi
    port: 4000
    auth: required
  }
}
