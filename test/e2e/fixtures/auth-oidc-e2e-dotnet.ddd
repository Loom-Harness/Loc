// OIDC runtime e2e (D-AUTH-OIDC): a .NET backend behind a bundled dev
// Keycloak.  The .NET sibling of auth-oidc-e2e.ddd — same realm/client so
// one bundled dev Keycloak serves both.  The test gets a real token for the
// seeded `demo` user via the password grant and asserts the generated .NET
// OidcUserVerifier validates it (JWKS) and maps the claims onto User,
// including the dotted `realm_access.roles` path.
system Helpdesk {
  user {
    id: string
    roles: string[]
    email: string
  }

  auth {
    enforcement: opt
    provider: keycloak
    oidc {
      issuer: env("OIDC_ISSUER")
      clientId: env("OIDC_CLIENT_ID")
    }
    claims: { roles: "realm_access.roles", email: "email" }
  }

  subdomain Support {
    context Tickets {
      aggregate Ticket with crudish {
        subject: string
        open: bool
      }
      // Negative-authz runtime gate (M-T3.13): two gated reads let the e2e
      // prove the emitted 403 filter actually ENFORCES (not a no-op a compile
      // gate can't see).  The dev Keycloak `demo` user carries realm roles
      // [user, agent] (no admin), so the admin-gated `AdminScoped` projection
      // denies (403) while Ticket's agent-gated list (`GET /tickets`) passes (200 —
      // the gate-satisfied control).
      repository Tickets for Ticket { }
      policy { read Ticket requires currentUser.roles.contains("agent") }
      projection AdminScoped requires currentUser.roles.contains("admin") {
        subject: string
        from Ticket as t
        select subject = t.subject
      }
    }
  }

  storage primary { type: postgres }
  resource ticketState { for: Tickets, kind: state, use: primary }

  api SupportApi from Support
  deployable api {
    platform: dotnet
    contexts: [Tickets]
    serves: SupportApi
    dataSources: [ticketState]
    port: 8080
    auth: required
  }
}
