// Scaffolded-form semantics, one model on every frontend (#5212).
//
// `Policy` carries one field of every form-field kind the shared form model
// (`src/generator/_frontend/form-spec.ts`) classifies: scalars, money, date and
// datetime, a file, an enum, a required and an optional reference, a required
// and an OPTIONAL value object, and arrays of scalars, enums, references and
// value objects.  Its crudish `update` is a record-prefilled update form.
// `Account` is event-sourced: its create form is its `create` action's params.
// `Meter` is typed into: unparsable text is refused in its field, parsable text
// is sent as typed, and a blank optional number or amount is sent absent.
// `Tally`, `Claim` and `Badge` are submitted untouched: a blank required scalar
// is a value the server receives, a blank required reference holds the submit,
// and a rule on a required field judges its blank.
//
// `test/generator/_frontend/form-spec-census.test.ts` generates this system on
// every frontend and fails on a kind a target renders as a stub.  The behavioural
// UI runners boot it per frontend: `__FRONTEND__` and `__FRAMEWORK__` are filled
// per case (test/behavioral/frontend-fixture.mjs, from corpus.json → `frontend`).  Kept out of `systems/`, which
// every BACKEND leg iterates.
system FormSpecUi {
  subdomain Cover {
    context Cover {
      enum Usage { Private, Commercial }
      enum Peril { Fire, Flood, Theft }

      valueobject Vehicle {
        vin: string
        year: int
        usage: Usage
        invariant vinLength: vin.length == 17
      }

      valueobject Limit {
        amount: money
        note: string?
      }

      valueobject Rider {
        code: string
        premium: decimal
        peril: Peril
        insurer: Provider id?
        waived: bool
      }

      aggregate Provider with crudish {
        name: string
        derived display: string = name
      }

      aggregate Policy with crudish {
        holder: string
        region: string?
        priority: int
        rate: decimal
        premium: money
        active: bool
        startsOn: date
        reviewAt: datetime
        schedule: File?
        usage: Usage
        provider: Provider id
        backup: Provider id?
        limit: Limit
        vehicle: Vehicle?
        tags: string[]
        perils: Peril[]
        alternates: Provider id[]
        riders: Rider[]
        contains coverages: Coverage[]
        derived display: string = holder

        operation addCoverage(code: string, limit: Limit, premium: money) {
          coverages += Coverage { code: code, limit: limit, premium: premium }
        }

        entity Coverage {
          code: string
          limit: Limit
          premium: money
        }
      }
      repository Providers for Provider { }

      // A workflow whose start answers the created record's id: its form opens
      // that record.
      workflow openProvider {
        create(name: string): Provider id {
          let provider = Provider.create(name: name)
          return provider.id
        }
      }
      repository Policies for Policy { }

      // Submitted untouched, a required field is a value: the form posts
      // `{ label: "", count: 0, amount: "0" }` and the server decides.
      aggregate Tally with crudish {
        label: string
        count: int
        amount: money
      }
      repository Tallies for Tally { }

      // A required reference with nothing picked holds the submit: an
      // untouched create form never reaches the server.
      aggregate Claim with crudish {
        note: string
        provider: Provider id
      }
      repository Claims for Claim { }

      // Typed text is sent as typed or refused in its field (P-UI-5): a
      // reading of `12abc` and a fee of `abc` hold the create, `42` and
      // `120.50` are what the server receives.  An optional number or amount
      // cleared in the update dialog is sent absent (P-UI-6).
      aggregate Meter with crudish {
        reading: int
        fee: money
        rate: decimal?
        spare: int?
        surcharge: money?
        // A default the server fills: the create form shows "set when saved"
        // in its place and sends it absent.
        readAt: datetime = now()
      }
      repository Meters for Meter { }

      // A rule judges a required field's blank: `""` is a value, and too short.
      aggregate Badge with crudish {
        code: string
        invariant code.length >= 2
      }
      repository Badges for Badge { }

      // An event-sourced aggregate's create request is its `create` action's
      // params: the create form asks for `owner` alone, never the folded
      // `balance` the create command does not take.
      event AccountOpened { account: Account id, owner: string }
      aggregate Account persistedAs: eventLog {
        owner: string
        balance: int
        create(owner: string) {
          emit AccountOpened { account: id, owner: owner }
        }
        apply(e: AccountOpened) {
          owner := e.owner
          balance := 0
        }
      }
      repository Accounts for Account { }
    }
  }
  api CoverApi from Cover

  ui WebApp with scaffold(subdomains: [Cover]) { __FRAMEWORK__ }

  storage primary { type: postgres }
  storage uploads { type: localDisk }
  resource coverState { for: Cover, kind: state, use: primary }
  resource coverFiles { for: Cover, kind: objectStore, use: uploads }
  resource coverLog { for: Cover, kind: eventLog, use: primary }
  deployable api {
    platform: node
    contexts: [Cover]
    dataSources: [coverState, coverFiles, coverLog]
    serves: CoverApi
    port: 3000
  }
  deployable webApp {
    platform: __FRONTEND__
    targets: api
    ui: WebApp
    port: 3001
  }
}
