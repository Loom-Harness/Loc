// The translated-locale behavioural fixture (i18n-ui.mjs).
//
// One page per chrome claim the i18n runtime makes, shipped with a `fr`
// translator tree (`locales/fr/`) so the leg can assert the TRANSLATED text in
// a real browser, per JSX frontend:
//   - /admin       a page `requires` gate -> the Forbidden view
//                  (`chrome.forbiddenTitle` / `chrome.forbiddenBody`);
//   - /price       a `money` hole `{amount, number, ::currency/EUR}`;
//   - the nav      a titled page (`title:`) and an untitled page (`name` key);
//   - /invoices/:id  a `ProvenanceInfo` disclosure and an `Action { x.op }`.
// The backend registers its dev-stub verifier, so `x-loom-dev-claims` picks the
// principal; no IdP, nothing mocked.
system Ledgerfront {
  user { id: string  role: string }

  subdomain Billing {
    context Invoicing {
      aggregate Invoice with crudish {
        label: string
        amount: money
        total: int provenanced
        operation reprice() {
          total := 42
        }
      }
      repository Invoices for Invoice { }
    }
  }

  storage primary { type: postgres }
  resource invoiceState { for: Invoicing, kind: state, use: primary }

  api BillingApi from Billing
  deployable api {
    platform: node
    contexts: [Invoicing]
    serves: BillingApi
    dataSources: [invoiceState]
    port: 8080
    auth: required
  }

  ui WebApp {
    api B: BillingApi
    page Admin { route: "/admin" requires currentUser.role == "admin" body: Heading { "Admin Area" } }
    page Price {
      route: "/price"
      title: "Pricing"
      body: Heading { "Pricing page" }
    }
    page Plain { route: "/plain" body: Heading { "Plain Page" } }
    page Invoice {
      route: "/invoices/:id"
      body: QueryView {
        of: B.Invoice.byId(id),
        single: true,
        data: i => Stack {
          Text { i.label },
          Text { `Total {i.amount, number, ::currency/EUR}` },
          ProvenanceInfo(of: i, field: "total"),
          Action { i.reprice }
        }
      }
    }
    menu {
      section "Main" {
        link Price,
        link Plain
      }
    }
  }

  deployable web {
    platform: static
    targets: api
    ui: WebApp { B: api }
    port: 3001
    auth: ui
  }
}
