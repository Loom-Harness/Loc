// The HEEx/LiveView runtime round-trip fixture.
//
// `run-heex-ui.mjs` boots this system's generated Phoenix app against a real
// postgres and drives the EMITTED Playwright surface at it in a real browser:
// the `.ui.spec.ts` that `src/system/ui-e2e-render.ts` lowers from the
// `test e2e` block below, over the per-page page objects
// `src/generator/elixir/page-objects-emit.ts` emits.
//
// Deliberately the SMALLEST system that exercises the full scaffold archetype
// chain — `scaffold` grows Home + a list / new / detail page per aggregate —
// because the leg's cost is dominated by the hex dep tree and the Phoenix
// compile, not by how many aggregates it walks.
//
// `platform: elixir` is fullstack (see `lower.ts`, "Test-kind dispatch"), so
// the one `test e2e` block below lowers to BOTH a `.ui.spec.ts` (Playwright,
// through the rendered LiveView DOM) and an api spec (fetch).  This leg runs
// the UI half — the half nothing per-PR has ever executed.
//
// The field types are chosen to make the round-trip prove something about
// RENDERING rather than just about routing:
//   name  — a plain string, read back out of the detail page's value cell
//   rank  — an int, so a HEEx arm that stringified it wrongly (or dropped the
//           value entirely) shows up as a text mismatch, not a 200
//
// DELIBERATELY NO VALUE-OBJECT FIELD.  A `price: Money` field was the first
// draft and it 500s the generated `/widgets/new`: the HEEx CreateForm renders
// a VO as `<.inputs_for field={@form[:price]}>`, but the Ecto schema flattens
// the VO into `price_amount` / `price_currency` columns and declares no
// `embeds_one`, so `Phoenix.HTML.FormData.Ecto.Changeset` raises
// "could not generate inputs for :price".  That is a real, pre-existing bug on
// the HEEx create path (and one this leg is how we found — `mix compile` is
// clean and the route still answers, so the emitted `smoke.spec.ts` passes on
// the 500).  Fixing it is its own slice; keeping it out of the fixture keeps
// THIS gate green-when-correct instead of permanently red.

system HeexUiSystem {

  // The dev-stub principal.  `heex-ui-auth.pw.ts` drives the LiveView as three
  // roles through the `x-loom-dev-claims` header the dev-stub :browser pipeline
  // seeds the session from; with no header the page runs as the stub's built-in
  // principal (role "admin"), which is what the Widget legs use.
  user { id: guid  role: string }

  subdomain Catalog {
    context Catalog {

      aggregate Widget with crudish {
        name: string
        rank: int
        invariant name.length > 0

        operation bump() {
          rank := rank + 1
        }
      }

      repository Widgets for Widget { }

      // ── The authorization legs (heex-ui-auth.pw.ts) ────────────────────
      // A LiveView detail page must dispatch each operation form to the NAMED
      // operation with the session principal — exactly what the REST action
      // and the SPA frontends do — so the op's `requires`, its `when` state
      // gate and its `emit` all run.  A submit through the generic
      // `update_claim` would skip all three, and `severity` / `status` /
      // `reserve` are `immutable` so the generic update cannot set them at
      // all: the authorized submit's visible effect exists only on the named
      // path.
      enum ClaimStatus { Open, Settled }
      valueobject Reserve { amount: decimal  note: string }

      aggregate Claim with crudish {
        title: string
        severity: int immutable
        status: ClaimStatus immutable
        reserve: Reserve immutable

        operation triage(severity: int) requires currentUser.role == "adjuster" when status == Open {
          this.severity := severity
          emit Triaged { claim: id, severity: severity }
        }
        // A value-object param: its form renders the VO's leaves as plain
        // inputs (no `inputs_for`, which phoenix_ecto refuses on a VO).
        operation setReserve(reserve: Reserve) requires currentUser.role == "adjuster" {
          this.reserve := reserve
        }
        operation settle() requires currentUser.role == "adjuster" when status == Open {
          status := Settled
        }
      }
      repository Claims for Claim { }

      // Covers every read of Claim: the list LiveView, the detail LiveView,
      // and the REST list / by-id routes.  `admin` is the dev stub's built-in
      // principal, which the emitted smoke spec navigates as; the read-gate
      // leg reads as `clerk`.
      policy { read Claim requires currentUser.role == "adjuster" || currentUser.role == "viewer" || currentUser.role == "admin" }

      event Triaged { claim: Claim id  severity: int }
      channel ClaimEvents {
        carries: Triaged
        delivery: broadcast
        retention: ephemeral
      }

      // The workflow LiveView must hand `run/2` the session principal: the
      // body's `requires` reads it.
      workflow Escalate {
        create(title: string) {
          requires currentUser.role == "adjuster"
          let c = Claim.create(title: title, severity: 5, status: Open, reserve: Reserve { amount: 0, note: "none" })
        }
      }
    }
  }

  api CatalogApi from Catalog

  storage primary { type: postgres }
  resource catalogState { for: Catalog, kind: state, use: primary }

  ui Web with scaffold(subdomains: [Catalog]) {
    api C: CatalogApi
    // The `emit` is observable in the browser: the event reaches every
    // subscribed LiveView as this toast.
    channel Live: Catalog.ClaimEvents
    on Live.Triaged(e) { toast("Claim triaged") }

    // A hand-written detail page whose QueryView data lambda param is NOT
    // `data`: the bump form's validate/submit clauses must read the assign
    // the lambda param was bound to (`widget`), not a fixed `data` assign.
    page WidgetBump(id: Widget id) {
      route: "/widget-bumps/:id"
      title: "Bump widget"
      body: QueryView {
        of: C.Widget.byId(id),
        single: true,
        data: widget => Stack {
          Text { widget.rank, testid: "bump-rank" },
          Modal {
            OperationForm { widget.bump },
            trigger: Button { "Bump" },
            title: "Bump"
          }
        }
      }
    }
  }

  deployable phoenixApp {
    platform: elixir
    contexts: [Catalog]
    dataSources: [catalogState]
    serves: CatalogApi
    ui: Web { C: phoenixApp }
    port: 4000
    auth: required
  }

  // create -> (via the LIST page's create affordance) -> detail, then a
  // SECOND navigation back to detail by id.  Every step is a real click /
  // fill / navigation against the LiveView the generator emitted.
  // The assertions use `toHaveText` (a LOCATOR matcher — see
  // src/util/intrinsic-matchers.ts) rather than `toBe`, so they lower to
  // Playwright's auto-retrying `expect(locator).toHaveText(…)` against the
  // live DOM instead of a one-shot string snapshot.
  test e2e "create a widget through the LiveView and read it back" against phoenixApp {
    let w = ui.widgets.create({ name: "Sprocket", rank: 7 })
    let read = ui.widgets.getById(w)
    expect(read.name).toHaveText("Sprocket")
    expect(read.rank).toHaveText("7")
  }
}
