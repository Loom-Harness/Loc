// Query-time AGGREGATION over a `shape: document` source — the one cell the
// column gate (`loom.projection-columnless-source`) deliberately leaves open,
// pinned as a POSITIVE fixture so the four backends that emit it keep emitting
// it.
//
// A document aggregate persists as `(id, data, version)`, so `sum(o.total)` and
// every `group by o.<field>` are refused: the declared fields live inside the
// jsonb blob.  What survives is the ROW COUNT — `count(*)` over the `id` column
// — and that really does run: drizzle `count()` over `schema.articles`,
// mikroorm `raw("count(*)")` over `ArticleRow`, SQLAlchemy
// `func.count()` over `ArticleRow`, Ecto `count(record.id)` over the document
// schema, EF `_db.Articles.GroupBy(_ => 1).Count()` over
// `DbSet<ArticleDocument>`, Dapper `SELECT count(*)::int FROM articles`.
//
// NO `java`.  Java's aggregation runs JPQL through the `EntityManager`
// (`select count(e) from Article e`) and a document aggregate has NO JPA
// `@Entity` at all — it round-trips one jsonb column through a `JdbcTemplate`
// repository — so Hibernate fails the query with "could not resolve root
// entity" at request time.  That cell is refused honestly by
// `loom.projection-whole-table-aggregation-unsupported` (its `#document`
// message variant); the manifest row
// records the exclusion, and `test/ir/projection-document-aggregation.test.ts`
// carries the negative proof.
//
// NOTHING FILTERED HERE, deliberately.  The moment the source carries a
// read-filtering capability the aggregation becomes unemittable on every
// backend (the predicates name `tenant_id` / `is_deleted`, which the triple has
// not) and — worse — SILENT on .NET/EF, which registers no `HasQueryFilter` for
// a document aggregate and so counts every tenant's rows.  That crossing is
// refused by `loom.projection-document-source-capability-filtered` and lives in
// the same negative test; the filtered RELATIONAL crossing is
// `projection-agg-filters.ddd`.
//
// RUNTIME + COMPILE.  This header used to say "COMPILE-TIER ONLY … asserting the
// number needs seeded rows the behavioural runners set up per-fixture".  It does
// not: `Article` carries `crudish`, so the api mints its own rows and the block
// below counts what it just created.  The generation gate proved the read
// EMITS; nothing proved the number was RIGHT, which is the gap a `count(*)` over
// a jsonb triple is most likely to have — every backend reaches it differently
// (drizzle `count()`, mikroorm `raw("count(*)")`, SQLAlchemy `func.count()`,
// Ecto `count(record.id)`, EF `GroupBy(_ => 1).Count()`, Dapper
// `count(*)::int`), and a wrong one still compiles.
//
// The contrast the fixture was built for is what the block asserts: the SAME
// source read two ways, the table-level `count(*)` and the repository-hydrated
// per-row arm, must agree about how many rows exist.  A backend that routed the
// aggregation through the repository (or the row read through the table) breaks
// exactly one of them, and the two numbers diverge.
//
// Still NO java — `backends: DOCUMENT_TABLE_AGGREGATION` excludes it, so the
// behavioural java leg skips this case by construction, exactly as the compile
// legs do.
system ProjectionDocumentAggregation {
  subdomain Cms {
    context Cms {
      aggregate Article shape: document, with crudish {
        title: string
        viewCount: int
      }

      repository Articles for Article { }

      // The whole-table row count — the ONLY aggregation a document source can
      // express.  A backend that reached for a declared field here would name a
      // jsonb key as a column; a backend with no document table to select from
      // would not compile at all.
      projection ArticleVolume {
        articles: int
        from Article as a
        select articles = count()
      }

      // The PER-ROW arm over the same source, beside it: this one reads through
      // the aggregate's repository (which hydrates the blob), so it is not
      // shape-constrained and CAN name declared fields.  Keeping both in one
      // fixture is what makes the contrast a regression: a backend that routed
      // the aggregation through the repository, or the row read through the
      // table, breaks exactly one of the two.
      projection ArticleTitles {
        heading: string
        seen: int
        from Article as a
        select heading = a.title, seen = a.viewCount
      }
    }
  }
  api CmsApi from Cms
  storage primary { type: postgres }
  resource cmsState { for: Cms, kind: state, use: primary }
  deployable d {
    platform: __PLATFORM__
    contexts: [Cms]
    dataSources: [cmsState]
    serves: CmsApi
    port: 4000
  }

  test e2e "the document row count is the number of rows, and both reads of the same source agree" against d {
    // Empty table first: `count()` must zero-default rather than answer NULL —
    // the shape that 500s a backend mapping a NULL aggregate onto a
    // non-nullable response field.
    let empty = api.articleVolume.list()
    expect(empty.articles).toBe(0)
    let noRows = api.articleTitles.list()
    expect(noRows.count()).toBe(0)

    let a = api.articles.create({ title: "First", viewCount: 3 })
    api.articles.create({ title: "Second", viewCount: 7 })
    api.articles.create({ title: "Third", viewCount: 11 })

    // The table-level `count(*)` over `(id, data, version)`…
    let volume = api.articleVolume.list()
    expect(volume.articles).toBe(3)
    // …and the repository-hydrated per-row arm over the SAME source, which
    // reads declared fields OUT of the jsonb blob.  Same source, two emission
    // paths: they must agree on the row count, and the per-row arm must carry
    // real field values rather than nulls.
    let rows = api.articleTitles.list()
    expect(rows.count()).toBe(3)

    // NOTHING HERE ASSERTS WHICH ROW COMES FIRST.  Neither projection declares
    // `order by`, so row order is unspecified — and it genuinely varies: the
    // first draft of this block asserted `rows.first().heading` and passed on
    // the insertion order until an `update` rewrote a row, after which Postgres
    // returned the updated row last and `first()` was a different article.  The
    // per-ROW identity assertions therefore go through `getById`, which
    // addresses a row rather than a position; the projections are asserted on
    // what they actually promise, which is the COUNT.
    api.articles.update(a, { title: "First Revised", viewCount: 4 })
    expect(api.articleVolume.list().articles).toBe(3)
    expect(api.articleTitles.list().count()).toBe(3)

    // The blob round-trip, addressed by id: `update` rewrote the jsonb and the
    // hydrating read must see the new values.
    let readBack = api.articles.getById(a)
    expect(readBack.title).toBe("First Revised")
    expect(readBack.viewCount).toBe(4)
    // `all()` on this aggregate answers a BARE ARRAY, not the paged
    // `{ items, total }` envelope — nothing here declares `paged`, so the root
    // list read is the collection itself and `.count()` is how it is measured.
    let listed = api.articles.all()
    expect(listed.count()).toBe(3)

    // …and a delete moves it back, on BOTH reads.
    api.articles.destroy(a)
    let afterDelete = api.articleVolume.list()
    expect(afterDelete.articles).toBe(2)
    let rowsAfter = api.articleTitles.list()
    expect(rowsAfter.count()).toBe(2)
  }
}
