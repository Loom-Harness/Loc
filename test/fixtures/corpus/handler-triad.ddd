// The handler-body shapes #2652 measured and left unfixed, in one fixture
// (#2659).  Each was a SILENT emitter defect — valid `.ddd`, output that either
// vanished or did not compile:
//
//   A. a handler touching NO aggregate — .NET's `emitExplicitHandlers` dropped
//      it (`if (!primaryAgg(h)) continue`), so `Echo` / `Sum` AND their routes
//      were absent from the .NET project while the other four emitted them.
//      They now file under the neutral `Application/Handlers/` folder the
//      extern handlers already use.  The same shape on PYTHON emitted a
//      handler module importing `NoopDomainEventDispatcher` with no repository
//      to construct — ruff F821's twin, F401, which is that leg's compile gate.
//   B. a declared find named `byId` called with an already-typed `Agg id` —
//      java renamed it to `getById` AND wrapped the argument, emitting
//      `getById(new OrderId(orderId))` where `orderId` is an `OrderId`
//      (`incompatible types` at javac), against a method the declared find is
//      not.  The declared method is now rendered verbatim, as everywhere else.
//   C. an OPTIONAL find bound in a handler body — the shared workflow statement
//      vocabulary has no null-handling arm, so the binding was dereferenced
//      unguarded (TS18047 / CS8602).  That shape is REFUSED at phase ⑦ now
//      (`loom.handler-load-nullable-unsupported`), mirroring the workflow twin,
//      so it cannot appear in a corpus fixture at all: its pin is
//      `test/ir/handler-nullable-load.test.ts`.
//
// Every find here returns an ARRAY on purpose.  A NON-optional SINGLE find
// (`find byCode(c: string): Order`) is a shape no corpus fixture reaches, and
// when this fixture landed the five backends did not agree on it: node threw
// `AggregateNotFoundError`, .NET's `FirstAsync` threw an
// `InvalidOperationException` no filter arm matched (→ 500), and java / python /
// elixir returned null / None / nil (→ `200 null`, which the 200 schema forbids).
// F13 settled all five on the shared not-found rung, and `errorStatuses` now
// DECLARES the 404 that shape answers — see
// docs/audits/schemathesis-findings-2026-08.md.  The cross-backend pin is
// test/conformance/not-found-declaration-parity.test.ts, kept out of the corpus
// because reaching it from here would mean re-baselining every backend golden.
system HandlerTriad {
  subdomain D {
    context Sales {
      aggregate Order {
        code: string
        status: string
        // A self-reference, so a find can take an `Order id` and still filter
        // on a real column (the primary key is not a filterable field).
        replaces: Order id
        operation cancel() { status := "cancelled" }
      }
      repository Orders for Order {
        // B: named `byId` on purpose — the name java used to special-case,
        // renaming the call to `getById` and re-wrapping its argument.
        find byId(oid: Order id): Order[] where replaces == oid
      }

      // A, command leg: no repository, no aggregate — pure computation.
      commandHandler Echo(text: string): string {
        return text
      }
      // A, query leg: same, with two scalar params.
      queryHandler Sum(a: int, b: int): int {
        return a + b
      }
      // B: an `Agg id` path param flowing into the declared `byId` find.
      queryHandler CountReplacing(orderId: Order id): int {
        let matches = Orders.byId(orderId)
        return matches.count
      }

      // D (wave C2, M-T5.14): a handler calling a DOMAIN SERVICE.  The handle a
      // `reading` op needs is per-backend — leading read-port params on
      // node/python, an injected object on dotnet/java, nothing at all on elixir
      // (the ambient `Repo`, because the op is a context function there) — and
      // every WORKFLOW emitter wired its own shape while the explicit-handler
      // emitters wired NONE.  So this crossing did not compile on three of five:
      // `Registration.isHolderFree(...)` as a STATIC call into a DI'd class with
      // no using/import (CS0103 / "cannot find symbol"), and on elixir a call to
      // `D.Domain.Services.Registration`, a module that is only emitted for PURE
      // ops (`UndefinedFunctionError` at runtime, out of code that compiles).
      //
      // BOTH tiers are here because the PURE half was broken too on java/.NET —
      // for the import alone — and because a fix that routed every service call
      // through the injected handle would pass a reading-only fixture.
      domainService FeeQuote {
        // NOT named `doubled`: python emits the handler `Doubled` as
        // `app/application/doubled.py` with `async def doubled(...)` AND imports
        // the service fn by its own snake name, so a handler whose name matches
        // an op it calls is `F811 Redefinition of unused 'doubled'` under the
        // corpus-python leg's `ruff check`.  That collision is a separate row
        // (the `loom-eval` identifier-collision family, #2923) and this fixture
        // is not about it — it is about the HANDLE, so it sidesteps the name.
        operation twice(n: int): int {
          return n * 2
        }
      }
      domainService Reachability {
        operation anyReplacing(oid: Order id): bool {
          // The read is BOUND first: a repository read used as a member
          // receiver is refused by `loom.domain-service-read-unsupported`
          // (the read-port derivation only recognises a read that is the whole
          // expression).  This fixture takes the supported spelling on purpose
          // — its subject is the handler's handle, not that gate.
          let hits = Orders.byId(oid)
          return hits.count > 0
        }
      }
      queryHandler Reachable(orderId: Order id): bool {
        let hit = Reachability.anyReplacing(orderId)
        return hit
      }
      queryHandler Doubled(n: int): int {
        let d = FeeQuote.twice(n)
        return d
      }
    }
  }
  api A from D {
    route POST "/echo/{text}" -> Sales.Echo
    route GET  "/sum/{a}/{b}" -> Sales.Sum
    route GET  "/orders/{orderId}/replacements" -> Sales.CountReplacing
    route GET  "/orders/{orderId}/reachable" -> Sales.Reachable
    route GET  "/doubled/{n}" -> Sales.Doubled
  }
  storage pg { type: postgres }
  resource salesState { for: Sales, kind: state, use: pg }
  deployable d {
    platform: __PLATFORM__
    contexts: [Sales]
    dataSources: [salesState]
    serves: A
    port: 4000
  }

  // Every route in this api is a ROUTED HANDLER (`route <METHOD> <PATH> ->
  // <Ctx>.<Handler>`), and until this block landed none of them had a caller:
  // `api.<x>.<y>(…)` resolved to an aggregate or a projection only, so probing
  // one answered `loom.e2e-unknown-aggregate: unknown aggregate 'api.sales'`.
  // A routed handler is now addressable through the SAME two-level shape the
  // route arrow already spells — context in the slug position, handler in the
  // method position — with arguments bound POSITIONALLY to the declared params
  // and a `{token}` param substituted into the path.
  //
  // NO ROW IS MINTED and none is needed: `Order` declares no create (see the
  // `UNCALLED_PINS` entry for `corpus/handler-triad`), and every assertion here
  // is an EMPTY-TABLE answer, which is what makes the fixture drivable at all.
  // The find-backed handlers return a COUNT, so with no rows any syntactically
  // valid guid answers 0 / false — and that is a real oracle, not a trivial
  // one: the pre-fix .NET project did not contain `Echo` / `Sum` or their
  // routes, and java rewrote `CountReplacing`'s declared `byId` find into a
  // `getById` it re-wrapped the argument for.
  test e2e "routed handlers answer, on an empty table" against d {
    // A, command leg — a handler touching NO aggregate.  POST /api/echo/{text},
    // the path param echoed straight back.
    expect(api.sales.echo("hi")).toBe("hi")
    // A, query leg — two scalar path params, summed in the handler body.  A
    // backend that dropped either param, or bound them in the wrong ORDER,
    // answers something other than 5.
    expect(api.sales.sum(2, 3)).toBe(5)
    // B — an `Order id` path param flowing into the DECLARED `byId` find.  The
    // find filters on `replaces`, so an empty table answers 0 for any guid;
    // what is under test is that the declared find is called AS DECLARED.
    expect(api.sales.countReplacing("11111111-1111-4111-8111-111111111111")).toBe(0)
    // D, pure tier — a handler calling a `domainService` op with no read port.
    expect(api.sales.doubled(21)).toBe(42)
    // D, reading tier — the same crossing where the handle is per-backend
    // (leading read-port params on node/python, an injected object on
    // dotnet/java, the ambient Repo on elixir).  Emptiness makes it false.
    expect(api.sales.reachable("22222222-2222-4222-8222-222222222222")).toBe(false)

    // The aggregate's own two SEEDABLE-FREE reads, so the routed-handler lift
    // is not the only thing this fixture drives: the root list route and the
    // declared find, both over the same empty table the handlers read.
    let listing = api.orders.all()
    expect(listing.items.length).toBe(0)
    expect(listing.total).toBe(0)
    let rows = api.orders.byId({ oid: "33333333-3333-4333-8333-333333333333" })
    expect(rows.length).toBe(0)
  }
}
