// A value-object invariant that calls `.matches(<regex>)` — the shape that makes
// each backend lift a REGULAR EXPRESSION into a second emitted file (the wire /
// request validator) beside the domain class that already had one.
//
// Minted by the fixture-shape audit (https://github.com/Loom-Harness/Loc/blob/cadbe3ba12fb833565704cb9d628c8f41b2090a8/docs/audits/2026-09-29-fixture-shape-coverage.md).
// The corpus had NO regex invariant at all — zero of 89 fixtures — and only four
// models in the whole repo used `.matches(` anywhere (one elixir-vanilla-build
// fixture and three `examples/`).  So no compile gate on any backend ever saw a
// regex leave the domain emitter, and the evaluation's F-013 was exactly that:
// `Domain/ValueObjects/UnLocode.cs` emitted `using
// System.Text.RegularExpressions;` while
// `Application/…/Requests/…RequestValidators.cs` called `Regex.IsMatch` with no
// using at all, so `dotnet build` failed on ordinary modelling.
//
// The invariant is deliberately the PLAINEST possible: one `.matches` on one
// string field of one VO used by one aggregate.  The bug class is a missing
// IMPORT in a second file, so nothing more elaborate reaches it, and anything
// more elaborate would blur which emitter is under test.
//
// Where each backend puts the regex:
//
//   dotnet  `CodeRequestValidators.cs` carries `using
//           System.Text.RegularExpressions;` alongside the domain class's
//           (`dotnet build /warnaserror` is the gate).
//   node    an inline literal (`/^[A-Z]{5}$/.test(...)`), no import to forget.
//   java    `CodeValidator.java` imports `java.util.regex.Pattern` and hoists
//           `Pattern.compile(...)` to a static field.
//   elixir  `Regex`/`=~` are in Elixir's Kernel, nothing to import.
//   python  the renderer writes `re` through a `ref()` marker, so every module
//           that spells it (`app/http/wire_models.py` included) derives its own
//           import; a missing one is ruff F821.
//
// The compile legs gate the imports; the `test e2e` block gates the wire
// boundary — a bad value answers 422, never 500 and never silently stored, on
// create and on update alike.
system VoRegexInvariant {
  subdomain Registry {
    context Codes {
      valueobject Code {
        value: string
        invariant value.matches("^[A-Z]{5}$") message "must be five uppercase letters"
        derived label: string = value
      }

      aggregate Berth with crudish {
        name: string
        // The VO crosses the wire, so its invariant is lifted into the request
        // validator as well as the domain class — the two emitters whose import
        // lists must agree.
        code: Code
        derived display: string = name
      }

      repository Berths for Berth { }
    }
  }

  api CodesApi from Registry
  storage primary { type: postgres }
  resource codesState { for: Codes, kind: state, use: primary }

  deployable d {
    platform: __PLATFORM__
    contexts: [Codes]
    dataSources: [codesState]
    serves: CodesApi
    port: 4000
  }

  test e2e "a regex value-object invariant is enforced at the wire boundary" against d {
    let b = api.berths.create({ name: "B-1", code: { value: "DEHAM" } })
    expect(api.berths.getById(b).code.value).toBe("DEHAM")

    expect(api.berths.create({ name: "B-2", code: { value: "deham" } })).toThrow(422)
    expect(api.berths.create({ name: "B-3", code: { value: "DEHAMX" } })).toThrow(422)
    expect(api.berths.update(b, { name: "B-1", code: { value: "12345" } })).toThrow(422)

    // The rejected update left the stored value alone.
    expect(api.berths.getById(b).code.value).toBe("DEHAM")
    api.berths.update(b, { name: "B-1b", code: { value: "USNYC" } })
    expect(api.berths.getById(b).code.value).toBe("USNYC")
    expect(api.berths.all().items.length).toBe(1)
    api.berths.destroy(b)
    expect(api.berths.getById(b)).toThrow(404)
  }
}
