// `shareable` — a record shared beyond its org (D-SHARING, docs/auth.md →
// "Sharing").  A share row belongs to the SHARER's org and names a grantee by
// kind: an org, an org and every org below it (`Subtree`, matched through
// `organizationContext.ancestors`, so a move re-targets it on the next
// request), or one user.  A grantee reads the shared row; a write share also
// opens it to the grantee's writes; a `mask unless` field still redacts by the
// grantee's own principal.  Revoking a share closes the row again, and so
// does soft-deleting the row: its shares open nothing once it is hidden.
// Sharing or revoking needs write access to the row in the sharer's own org
// (`exists Category for write`): a manager writes only the categories they
// created (`own`), so a colleague cannot share them, and a grantee cannot
// re-share a row of another org, even with a write share.  An event raised on
// a shared row carries the row's tenant, so a grantee's write folds (and
// publishes) under the owner's org.
//
// Driven by the `tenancy-org-context` boot harness (`assertShareable`) on
// every backend, with real registry org ids as tenancy claims.  The deployable
// platform is substituted per leg (node/python/java/dotnet/elixir).
system Sharing {
  user { id: string  tenantId: string  role: string }

  tenancy by user.tenantId of Org

  subdomain Core {
    context Catalog {
      aggregate Org with crudish {
        name: string
        implements tenantRegistry
        operation move(to: Org id) {
          parent := to
        }
      }
      aggregate Category with tenantOwned, auditable, shareable, softDeletable, softDelete, crudish {
        name: string
        secret: string? mask unless currentUser.role == "manager"
        operation rename(to: string) {
          name := to
          emit CategoryRenamed { category: id, name: to }
        }
      }
      event CategoryRenamed { category: Category id  name: string }

      // A tenant-scoped fold: a rename made through a write share folds
      // under the ROW's org, the owner's, never the grantee's.
      projection Renames keyed by category {
        category: Category id
        name: string
        on(e: CategoryRenamed) {
          name := e.name
        }
      }

      // `with shareable` unfolds to CategoryShare (+ its events), the
      // ShareGranteeKind enum, GranteeIsMe / SharedWithMe and the
      // CategorySharing read/write rules; who may share is this rule.
      policy {
        allow share on Category when currentUser.role == "manager"
        allow write own on Category when currentUser.role == "manager"
      }
      repository Categories for Category { }
      repository Orgs for Org { }
    }
  }

  api CatalogApi from Core
  storage primary { type: postgres }
  resource catalogState { for: Catalog, kind: state, use: primary }
  deployable d {
    platform: __PLATFORM__
    contexts: [Catalog]
    dataSources: [catalogState]
    serves: CatalogApi
    port: 4000
    auth: required
  }
}
