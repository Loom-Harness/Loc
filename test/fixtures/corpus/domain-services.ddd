// Domain services (domain-services.md) — a stateless, context-level container of
// cross-aggregate `operation`s, across the full three-tier capability ladder:
//
//   FeeQuote     — PURE     (params only; a stateless static/module fn everywhere)
//   Registration — READING  (a read-only repo query `Accounts.byHolder`, orchestrated)
//   Transfer     — MUTATING (mutates the passed-in aggregate ARGS via their own ops)
//
// The reading + mutating tiers are application-orchestrator-only: the `MoveMoney`
// / `RegisterAccount` workflows LOAD the aggregates, the service reads/mutates
// them, and the workflow's auto-save-at-exit persists — the service never writes
// a repository and never commits.  Shapes mirror the proven generator/compile
// fixtures (test/e2e/fixtures/elixir-vanilla-build/vanilla-domain-service-mutating.ddd,
// web/src/examples/banking-reading-service.ddd).  Params are `source`/`dest`
// (`from`/`to` are reserved).
system DomainSvc {
  subdomain Accounts {
    context Accounts {

      valueobject Money {
        amount: decimal
        currency: string
        invariant amount >= 0
      }

      aggregate Account with crudish {
        holder: string
        balance: Money
        // The `requires` gate that calls a DOMAIN SERVICE (ledger row F2-CB-C7).
        // A gate is HOISTED out of the operation body to the CALLER
        // (`src/ir/util/op-gates.ts`), so it renders `FeeQuote.forAmount(...)`
        // into the route / service module — a DIFFERENT file from the entity
        // whose body sweep was every backend's only domain-service import
        // collector.  Four of five emitted the call with no import (TS2304 /
        // "cannot find symbol" / `F821` / CS0103) from a model that parses,
        // validates and generates clean.  Always true, so the e2e below still
        // reaches the operation: the point is the IMPORT, not the denial.
        operation withdraw(amount: Money) requires FeeQuote.forAmount(balance).amount >= 0 {
          balance := Money { amount: balance.amount - amount.amount, currency: balance.currency }
        }
        operation deposit(amount: Money) {
          balance := Money { amount: balance.amount + amount.amount, currency: balance.currency }
        }

        // A BLOCK-BODY `function` (domain-services.md rev. 4) whose only
        // `return`s sit inside an `if` — the shape no fixture carried, because
        // until this wave it did not parse anywhere: `checkFunction` counted
        // TOP-LEVEL `return`s only, so `loom.function-block-no-return` refused
        // it at phase ④ on all five backends while every one of them renders
        // it.  Four go through the generic `_stmt/target.ts` `if` arm; elixir
        // goes through `renderPureBlock`'s, whose own gate
        // (`elixirIfRefusal(…, "value")`) already admitted exactly this shape —
        // a TAIL `if` carrying an `else`, every `return` in tail position.
        // Called from the `MoveMoney` workflow below — a `function` declared on
        // ONE aggregate and used by an orchestrator holding an INSTANCE of it,
        // which is the ordinary "reuse a named domain rule" path and the second
        // caller shape that reaches a `function` from outside the class.  Every
        // backend broke on it differently: three emitted a call to a `private`
        // member, python's `def _tier` disagreed with the `t.tier(…)` the
        // workflow renders (AttributeError at request time), and elixir
        // rendered `s.tier(…)` — a remote call on a struct, which raises.
        function tier(threshold: decimal): string {
          if balance.amount > threshold { return "gold" } else { return "bronze" }
        }

        // Pure-domain (unit) test — decimal value-object ARITHMETIC through
        // operations (deposit `+`, withdraw `-`), a surface the existing corpus
        // domain tests (enum/containment/precondition/single-containment) don't
        // stress: a `Money` VO reconstructed from `balance.amount ± amount.amount`
        // and read back, exercising cross-backend decimal coercion in a pure op.
        test "deposit and withdraw adjust the decimal Money balance" {
          let a = Account.create({ holder: "alice", balance: Money { amount: 100.00, currency: "USD" } })
          expect(a.balance.amount).toBe(100.00)
          let credit = Money { amount: 50.00, currency: "USD" }
          a.deposit(credit)
          expect(a.balance.amount).toBe(150.00)
          let debit = Money { amount: 30.00, currency: "USD" }
          a.withdraw(debit)
          expect(a.balance.amount).toBe(120.00)
        }
      }

      repository Accounts for Account {
        find byHolder(holder: string): Account? where this.holder == holder
      }

      // ── pure tier ── params only; callable from anywhere, no infrastructure.
      domainService FeeQuote {
        operation forAmount(amount: Money): Money {
          // A `precondition` in a domainService operation's OWN body — the shape
          // docs/audits/2026-09-29-fixture-shape-coverage.md found in 0 of 406
          // models, and the evaluation's F-009 trigger.  It lowers to a
          // `throw`/`raise` of the domain-error type inside `domain/services.ts`
          // (and each backend's equivalent), whose import list is built by a
          // DIFFERENT sweep from the one that collects the service's own calls —
          // so node emitted `throw new DomainError(...)` with `DomainError`
          // imported nowhere: a `precondition` that should answer 422 answered
          // 500, and `tsup`/esbuild shipped it because it strips types without
          // checking them.
          //
          // Note this fixture ALREADY had two preconditions — `Registration.
          // isHolderFree(holder)` and `s.tier(0.00) != ""` — and neither reaches
          // the shape: both sit in WORKFLOW bodies, emitted into the workflow
          // module, which already collected its service imports.  One level in,
          // different emitter, different import sweep.  That near-miss is why
          // the gap survived a fixture that looks like it covers this.
          //
          // It sits on `FeeQuote` on purpose.  `forAmount` is the service the
          // `Account.withdraw` `requires` gate calls, and the `test e2e` block
          // below CALLS `withdraw` — so this guard is on a path the behavioural
          // tier actually executes, rather than compile-only.  The predicate
          // HOLDS for every value the e2e passes (a balance is never negative),
          // so no response changes and the reviewed wire golden
          // (`test/behavioral/wire-golden/domain-services.json`) stays valid.
          // Keep it true: a precondition that fires here rewrites the golden.
          precondition amount.amount >= 0 message "a fee quote needs a non-negative amount"
          return Money { amount: amount.amount, currency: amount.currency }
        }
      }

      // ── reading tier ── a read-only repository query; the RegisterAccount
      // workflow orchestrates it as a precondition.
      domainService Registration {
        operation isHolderFree(holder: string): bool {
          return Accounts.byHolder(holder) == null
        }
      }

      // ── mutating tier ── mutates the passed-in Account args via their own ops;
      // MoveMoney loads them, this transfers, the workflow persists at exit.
      domainService Transfer {
        operation run(source: Account, dest: Account, amount: Money) {
          source.withdraw(amount)
          dest.deposit(amount)
        }
      }

      workflow RegisterAccount transactional {
        create(holder: string, balance: Money) {
          precondition Registration.isHolderFree(holder)
          let acct = Account.create({ holder: holder, balance: balance })
        }
      }

      workflow MoveMoney transactional {
        create(source: Account id, dest: Account id, amount: Money) {
          let s = Accounts.getById(source)
          let d = Accounts.getById(dest)
          // The cross-aggregate `function` call (see `tier` above).  Always
          // true — `tier` returns "gold" or "bronze" — so the precondition
          // never changes what this workflow does; the point is that the call
          // is EMITTED, and compiles.
          precondition s.tier(0.00) != ""
          Transfer.run(s, d, amount)
        }
      }
    }
  }

  api AccountsApi from Accounts
  storage primary { type: postgres }
  resource accountsState { for: Accounts, kind: state, use: primary }
  deployable d {
    platform: __PLATFORM__
    contexts: [Accounts]
    dataSources: [accountsState]
    serves: AccountsApi
    port: 4000
  }

  // api e2e — seeds an account and reads it back via the `byHolder` find the
  // reading service calls, proving the read mechanics at runtime.  (The
  // workflow→service wiring is proven by the per-PR compile gates; the e2e DSL
  // has no workflow accessor — same split as banking-reading-service.ddd.)
  test e2e "byHolder returns the account the reading service would find" against d {
    let a = api.accounts.create({ holder: "alice", balance: { amount: 100, currency: "USD" } })
    let found = api.accounts.byHolder({ holder: "alice" })
    expect(found.holder).toBe("alice")

    // The canonical `update` writes the SAME `holder` column the reading
    // service's `byHolder` query keys on, so the service's precondition
    // (`isHolderFree`) sees the moved name: the old holder stops resolving and
    // the new one starts.  The by-id read in between is the account route the
    // workflows load through, and had no caller either.
    api.accounts.update(a, { holder: "alice2", balance: { amount: 100, currency: "USD" } })
    let read = api.accounts.getById(a)
    expect(read.holder).toBe("alice2")
    let moved = api.accounts.byHolder({ holder: "alice2" })
    expect(moved.holder).toBe("alice2")

    // The two DOMAIN OPERATIONS over the HTTP routes.  Their arithmetic is
    // already gated in the pure unit test above; what had never run is the same
    // arithmetic across the WIRE, where the `Money` value object is a nested
    // JSON object on the way in and a decimal on the way back.  Deposit then
    // withdraw so the balance returns to its starting value — a coercion that
    // rounds or string-widens on one leg shows as an inequality here.
    api.accounts.deposit(a, { amount: { amount: 25, currency: "USD" } })
    let deposited = api.accounts.getById(a)
    expect(deposited.balance.amount).toBe(125)
    api.accounts.withdraw(a, { amount: { amount: 25, currency: "USD" } })
    let withdrawn = api.accounts.getById(a)
    expect(withdrawn.balance.amount).toBe(100)

    // The LIST route carries the same nested value object in bulk.
    let listed = api.accounts.all()
    expect(listed.items.length).toBe(1)
    expect(listed.total).toBe(1)

    api.accounts.destroy(a)
    expect(api.accounts.getById(a)).toThrow(404)
    expect(api.accounts.byHolder({ holder: "alice2" })).toThrow(404)
    let empty = api.accounts.all()
    expect(empty.items.length).toBe(0)
    expect(empty.total).toBe(0)
  }
}
