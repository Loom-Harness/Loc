// Named-rule validation messages + the backend message CATALOG (M-T1.11).
//
// Exercises every rule kind that can be named — an
// aggregate `invariant`, an inline field `check`, an operation `precondition`,
// and a value-object `invariant` — so each backend's wire-validator carrier AND
// its generated catalog (a `const` map on node/.NET/python, a
// `messages.properties` ResourceBundle on java, a `priv/gettext` tree on elixir)
// are compiled by the corpus gate.
//
// It also keeps a MESSAGE-LESS rule beside each named one: an unnamed
// rule must stay on its native validator chain (`z.number().min`,
// `.MinimumLength`, `Field(min_length=…)`, `validate_length`), so this fixture
// compiles both paths rather than only the new one.
system MessagedRules {
  subdomain Sales {
    context Catalog {
      valueobject Sku {
        code: string
        // Value-object invariants reach the wire through the `<Vo>Request`
        // validator, the third `available`-set shape the catalog collects over.
        invariant skuCodeNeedsAt: code.length >= 3
        invariant code.length <= 32
      }
      aggregate Product {
        // Inline field `check` with a trailing message — its key is a content
        // hash of the text (D-I18N-KEY's inline-literal rule).
        name: string check nameRequired: name.length > 0
        sku: Sku
        quantity: int
        reorderLevel: int

        // A named aggregate invariant over a create-input field.
        invariant quantityCannotNegative: quantity >= 0
        // Message-LESS, and single-field-shaped: must stay on the native chain.
        invariant reorderLevel >= 1

        create(name: string, sku: Sku, quantity: int, reorderLevel: int) {
          name := name
          sku := sku
          quantity := quantity
          reorderLevel := reorderLevel
        }

        operation restock(amount: int) {
          // A named precondition — the operation-request carrier.
          precondition restockAmountAtLeast: amount >= 1
          quantity := quantity + amount
        }

        operation ship(amount: int) {
          // Unnamed precondition beside the named one above, so both
          // arms of each backend's precondition branch are compiled.
          precondition amount >= 1
          quantity := quantity - amount
        }

        // The CODE-POINT half of `.length` (schemathesis F5 / waiver W6).  A
        // string length bound counts Unicode code points — the unit the emitted
        // JSON Schema publishes as `minLength`/`maxLength` — not the host
        // language's native string length (UTF-16 code units on JS/C#/Java).
        // Both length carriers are exercised, because they are DIFFERENT code
        // paths: the named rule rides the refine/`Must`/predicate carrier,
        // the unnamed one rides each backend's native validator chain.
        operation rename(label: string) {
          precondition labelNeedsAtLeast: label.length >= 3
          precondition label.length <= 16
          name := label
        }

        // An UNNAMED `matches` rule (#15d, ruling D10).  Its denial must
        // carry the SAME synthesized sentence node's zod chain sends ("Code is
        // not in the expected format") — python once answered pydantic's raw
        // `String should match pattern '^[A-Z]{3}$'`, leaking the regex.
        operation retag(code: string) {
          precondition code.matches("^[A-Z]{3}$")
          sku := Sku { code: code }
        }

        test "restock adds to quantity" {
          let p = Product.create(name: "Widget", sku: Sku { code: "WID" }, quantity: 2, reorderLevel: 1)
          p.restock(3)
          expect(p.quantity).toBe(5)
        }
      }
      repository Products for Product { }
      criterion ProductsByName(n: string) of Product = this.name == n
      queryHandler ListProductsByName(n: string): Product[] {
        let r = Products.all(ProductsByName(n))
        return r
      }
    }
  }
  api CatalogApi from Sales {
    route GET "/products/by_name/{n}" -> Catalog.ListProductsByName
  }
  storage primary { type: postgres }
  resource catalogState { for: Catalog, kind: state, use: primary }
  deployable d {
    platform: __PLATFORM__
    contexts: [Catalog]
    dataSources: [catalogState]
    serves: CatalogApi
    port: 4000
  }

  test e2e "a named rule answers 422 with its rule text and its stable code" against d {
    let p = api.products.create({ name: "Widget", sku: { code: "WID" }, quantity: 2, reorderLevel: 1 })
    // Every CREATE-time carrier refuses at the wire (PROMOTED from the
    // per-backend `message-clause.test.ts` / `vo-invariant-422.test.ts` string
    // copies, M-T9.42 — each pinned its emitter's carrier spelling: zod refine,
    // FluentValidation `.WithMessage`/`.WithErrorCode` + a `<Vo>RequestValidator`,
    // a Spring `Validator` + `rejectValue`, pydantic `PydanticCustomError`, an
    // Ecto `validate_invariants` residual).  The golden pins each 422 body —
    // the rule text, the stable `<Ctx>.<Owner>.rule.<name>` code and the pointer — so the
    // five carriers are compared as what they ANSWER.
    //   the named aggregate invariant.
    expect(api.products.create({ name: "Gadget", sku: { code: "GAD" }, quantity: -1, reorderLevel: 1 })).toThrow(422)
    //   the named inline `check name.length > 0`, which only "" can trip —
    //   the blank string has to reach the rule (Ecto's default cast turns it
    //   into nil and answers "can't be blank" instead).
    expect(api.products.create({ name: "", sku: { code: "GAD" }, quantity: 1, reorderLevel: 1 })).toThrow(422)
    //   the named VALUE-OBJECT invariant, its pointer the leaf `/sku/code`.
    expect(api.products.create({ name: "Gadget", sku: { code: "G" }, quantity: 1, reorderLevel: 1 })).toThrow(422)
    //   …and a BLANK leaf, which has to reach the same rule rather than be
    //   cast to nil and skipped by every length validator.
    expect(api.products.create({ name: "Gadget", sku: { code: "" }, quantity: 1, reorderLevel: 1 })).toThrow(422)
    //   the UNNAMED single-field invariant `reorderLevel >= 1` at create: it
    //   stays on each backend's native chain and must answer the same
    //   `field.min` code, bound and pointer as the named carriers' envelope.
    expect(api.products.create({ name: "Gadget", sku: { code: "GAD" }, quantity: 1, reorderLevel: 0 })).toThrow(422)
    let stillOne = api.products.all()
    expect(stillOne.total).toBe(1)
    let read = api.products.getById(p)
    expect(read.quantity).toBe(2)
    api.products.restock(p, { amount: 3 })
    let after = api.products.getById(p)
    expect(after.quantity).toBe(5)
    // The UNNAMED twin of the same rule shape: `ship`'s precondition has no
    // rule text, so its denial must keep the derived default AND contribute
    // no catalog entry — the byte-identical half of this fixture, exercised at
    // runtime rather than only in the emitted source.
    api.products.ship(p, { amount: 1 })
    let shipped = api.products.getById(p)
    expect(shipped.quantity).toBe(4)
    // The two derived reads, so the aggregate's whole route surface has a caller.
    let listed = api.products.all({ sort: "name", dir: "asc" })
    expect(listed.items.length).toBe(1)
    expect(listed.total).toBe(1)
    let byName = api.catalog.listProductsByName("Widget")
    expect(byName.length).toBe(1)
    // The named precondition rejects at the wire boundary (422).  The
    // `errors[].code` it carries is what the generated catalog is keyed by, and
    // what the server now resolves the message through.
    expect(api.products.restock(p, { amount: 0 })).toThrow(422)

    // W6 — string length is measured in CODE POINTS, on both carriers, at
    // runtime.  Deliberately last: `rename` changes the name the reads above
    // filter on.
    //
    // "😀X" is THREE UTF-16 code units and TWO code points.  A backend
    // counting code units passes it (3 >= 3) and answers 200; the code-point
    // rule denies it with its rule text — the same 422 envelope the
    // `restock` denial above already pins across all five backends.
    expect(api.products.rename(p, { label: "😀X" })).toThrow(422)
    // The other direction, on the unnamed native chain: nine astral
    // characters are EIGHTEEN UTF-16 code units but only nine code points, so
    // `label.length <= 16` must ADMIT them — a code-unit chain wrongly denies.
    // The value then has to survive the round-trip unmangled.
    api.products.rename(p, { label: "😀😀😀😀😀😀😀😀😀" })
    let renamed = api.products.getById(p)
    expect(renamed.name).toBe("😀😀😀😀😀😀😀😀😀")

    // #15d (ruling D10) — a MESSAGE-LESS single-field rule's 422 carries the
    // synthesized per-field sentence, identical across backends, never the
    // framework default (which for a regex leaks the pattern).  One numeric
    // bound (`ship`'s `amount >= 1`) and one regex (`retag`), then the
    // regex's admitting twin so the route has a passing caller too.
    expect(api.products.ship(p, { amount: 0 })).toThrow(422)
    expect(api.products.retag(p, { code: "abc" })).toThrow(422)
    api.products.retag(p, { code: "XYZ" })
  }
}
