// Simple (dev-stub) auth (auth.md): a `user` shape + `requires`-guarded
// operation without an external OIDC provider.
system SimpleAuth {
  user { id: guid  role: string }
  subdomain Support {
    context Tickets {
      aggregate Ticket with crudish {
        subject: string
        open: bool
        operation close() {
          requires currentUser.role == "agent"
          open := false
        }
        // Gate order (docs/auth.md → "Gate order"): the row-independent
        // `requires` refuses before the load, the version check and `when`, so
        // a refused caller learns nothing about the row — not that it exists,
        // its version, or its state.  Its `can_reopen` probe runs the same
        // gate.
        operation reopen() when !open {
          requires currentUser.role == "agent"
          open := true
        }
        // A gate that calls one of the aggregate's own functions reads the
        // row, whatever the function's body reads: every backend renders the
        // call on the loaded instance, so the gate runs after the load (a
        // missing id is 404, a closed ticket 403).
        // A gate that reads an operation parameter: the `can_retitle` probe
        // carries no body, so it cannot decide it and answers
        // `{ allowed: false }` on every backend, whatever the row holds.
        operation retitle(to: string) when open {
          requires to != subject
          subject := to
        }
        function isOpenNow(): bool = open
        operation archive() {
          requires isOpenNow()
          open := false
        }
      }
      repository Tickets for Ticket { }

      // The generic `update` carries a gate too: the second-identity ladder
      // (`AUTHZ_LADDERS`) must see it refused for a non-agent principal, on
      // the generic route as on the named `close()` above.  Two spellings of
      // the same gate: a hand-written header `requires`, and the
      // `crudish(requires: …)` policy.
      policy AgentOnly(): bool = currentUser.role == "agent"
      aggregate Memo {
        body: string
        operation update(body: string) requires currentUser.role == "agent" {
          body := body
        }
        create(body: string) { body := body }
      }
      repository Memos for Memo { }
      aggregate Note with crudish(requires: AgentOnly) {
        text: string
      }
      repository Notes for Note { }

      // A merge-patch `update` whose `requires` reads a parameter: the gate
      // reads the MERGED value (RS-47), so a body that omits `amount` is
      // judged on the stored amount, on every backend.
      aggregate Budget {
        label: string
        amount: int
        operation update(label: string, amount: int) {
          requires amount < 100
          label := label
          amount := amount
        }
        create(label: string, amount: int) { label := label  amount := amount }
      }
      repository Budgets for Budget { }

      // A merge-patch `update` with a `mask unless` write gate: the gate runs
      // after the SCOPED load, so a missing id and a row outside the read
      // scope (soft-deleted) answer 404 before it; a visible row answers its
      // 403.  No harness principal is an auditor.
      aggregate Vault with crudish(updateOnly: true), softDeletable, softDelete {
        label: string
        secret: string mask unless currentUser.role == "auditor"
        create(label: string, secret: string) {
          label := label
          secret := secret
        }
      }
      repository Vaults for Vault { }
    }
  }
  storage primary { type: postgres }
  resource ticketState { for: Tickets, kind: state, use: primary }
  api SupportApi from Support
  deployable d {
    platform: __PLATFORM__
    contexts: [Tickets]
    serves: SupportApi
    dataSources: [ticketState]
    port: 4000
    auth: required
  }

  // The behavioural harness authenticates as the canonical principal
  // (`role: "agent"`; see cases.mjs DEV_CLAIMS).  `close()` is guarded by
  // `requires currentUser.role == "agent"`, so it must SUCCEED for this
  // principal — a backend that fails to resolve `currentUser` from the
  // dev-stub claims (or mis-evaluates the guard) rejects the op and the
  // read still shows `open == true`.
  test e2e "requires-guarded op succeeds for the authenticated agent principal" against d {
    let t = api.tickets.create({ subject: "Broken login", open: true })
    api.tickets.close(t)
    let read = api.tickets.getById(t)
    expect(read.open).toBe(false)
    // `reopen()` is gated by the same `requires` and by `when !open`: the
    // agent may reopen the closed ticket.
    api.tickets.reopen(t)
    expect(api.tickets.getById(t).open).toBe(true)

    // The canonical `update` carries NO `requires` clause, so it proves the
    // dev-stub principal reaches an unguarded write on an `auth: required`
    // deployable — the complement of the guarded `close()` above.  A backend
    // that applied the guard aggregate-wide would 403 here.
    api.tickets.update(t, { subject: "Login restored", open: true })
    let reopened = api.tickets.getById(t)
    expect(reopened.subject).toBe("Login restored")
    expect(reopened.open).toBe(true)

    // The LIST and DELETE routes on an `auth: required` deployable.  Neither
    // carries a `requires`, so both must be reachable by the same dev-stub
    // principal — the third and fourth unguarded routes beside the guarded
    // `close()`, and the ones an aggregate-wide guard would 403.
    let listed = api.tickets.all()
    expect(listed.items.length).toBe(1)
    expect(listed.total).toBe(1)
    api.tickets.destroy(t)
    expect(api.tickets.getById(t)).toThrow(404)
    let empty = api.tickets.all()
    expect(empty.items.length).toBe(0)
    expect(empty.total).toBe(0)

    // The update gates hold for the principal that satisfies them.
    let m = api.memos.create({ body: "one" })
    api.memos.update(m, { body: "two" })
    expect(api.memos.getById(m).body).toBe("two")
    let n = api.notes.create({ text: "one" })
    api.notes.update(n, { text: "two" })
    expect(api.notes.getById(n).text).toBe("two")
    expect(api.memos.all().items.length).toBe(1)
    expect(api.notes.all().items.length).toBe(1)
    api.notes.destroy(n)
    expect(api.notes.all().items.length).toBe(0)
  }

  test e2e "a requires that calls the aggregate's own function runs against the loaded row" against d {
    let t = api.tickets.create({ subject: "Stale", open: true })
    api.tickets.archive(t)
    expect(api.tickets.getById(t).open).toBe(false)
    // The gate reads the loaded row: archived once, the ticket is refused.
    expect(api.tickets.archive(t)).toThrow(403)
    // … and an id with no row is 404 — the load runs before the gate.
    api.tickets.destroy(t)
    expect(api.tickets.archive(t)).toThrow(404)

    // A gate on an operation parameter: refused and admitted with a body.
    let r = api.tickets.create({ subject: "Old", open: true })
    expect(api.tickets.retitle(r, { to: "Old" })).toThrow(403)
    api.tickets.retitle(r, { to: "New" })
    expect(api.tickets.getById(r).subject).toBe("New")
  }

  test e2e "a merge-patch update's parameter gate reads the merged value" against d {
    let low = api.budgets.create({ label: "low", amount: 50 })
    // `amount` omitted: the gate reads the stored 50, which passes.
    api.budgets.update(low, { label: "low renamed" })
    expect(api.budgets.getById(low).label).toBe("low renamed")
    expect(api.budgets.getById(low).amount).toBe(50)
    let high = api.budgets.create({ label: "high", amount: 500 })
    // `amount` omitted: the gate reads the stored 500, which refuses.
    expect(api.budgets.update(high, { label: "high renamed" })).toThrow(403)
    expect(api.budgets.getById(high).label).toBe("high")
    // A body that carries `amount` is judged on the value it sets.
    api.budgets.update(high, { amount: 10 })
    expect(api.budgets.getById(high).amount).toBe(10)
    expect(api.budgets.update(high, { amount: 200 })).toThrow(403)
    expect(api.budgets.all().items.length).toBe(2)

    let v = api.vaults.create({ label: "box", secret: "s1" })
    // A visible row: the masked key is refused, the rest of the patch is not.
    expect(api.vaults.update(v, { secret: "s2" })).toThrow(403)
    api.vaults.update(v, { label: "box 2" })
    expect(api.vaults.getById(v).label).toBe("box 2")
    // Outside the read scope: 404 before the mask gate.
    let gone = api.vaults.create({ label: "gone", secret: "s3" })
    api.vaults.softDelete(gone)
    expect(api.vaults.update(gone, { secret: "s4" })).toThrow(404)
    expect(api.vaults.restore(gone)).toThrow(404)
    expect(api.vaults.all().items.length).toBe(1)
  }
}
