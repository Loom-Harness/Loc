// TPH (`sharedTable`) × a CAPABILITY — the crossing `tph.ddd` does not reach,
// because its concretes are plain relational aggregates with no capability and
// therefore no filter.
//
// This is a storage-layer INTERACTION, the class the pairwise inheritance axis
// was added for: each feature is correct alone, and the crossing is what breaks.
// Sharing a table is exactly what makes a SUBTYPE'S OWN columns nullable — only
// rows of that `kind` populate them — so `softDeletable`'s `is_deleted` lands on
// the shared table as a nullable column, and the `filter !this.isDeleted` the
// capability contributes now reads a column the type system calls
// `bool | None`.  That is pairwise F15: `mypy --strict` refused
// `not_(Row.is_deleted)` once per emitted read on python, and nothing in the
// curated corpus crossed capability with inheritance to say so.
//
// `dotnet` is deliberately absent from this fixture's manifest row: it REFUSES
// the crossing by name (`loom.tph-filter-unsupported`), because EF Core applies
// a query filter only to the ROOT entity type and a predicate over a non-root
// column is not expressible there.  That is an honest gate, not a gap, and the
// row returns the day it closes.
//
// STILL MISSING, and named so the next agent widens rather than re-derives: the
// sibling crossing `shape: embedded` × TPH (pairwise F13).  It belongs in this
// fixture — a TPH concrete owns no table of its own, so the jsonb containment
// column has nowhere to live and the phase-⑨ DDL emits a relational child table
// instead.  It is held back only because the drizzle repository still targets
// the concrete's own (non-existent) table on that crossing (pairwise F11, node),
// so adding the concrete here would turn `corpus-tsc-build` red on a defect this
// fixture is not about.  Add an `embedded` concrete to this hierarchy when F11
// closes; python's half is gated meanwhile by
// `test/generator/python/tph-embedded-storage.test.ts`.
system TphCrossings {
  subdomain Depot {
    context Depot {
      abstract aggregate Shipment inheritanceUsing: sharedTable {
        reference: string
      }
      // The subject: a SOFT-DELETABLE concrete of a shared table.  `is_deleted`
      // and `deleted_at` are the subtype's OWN columns, so the shared table
      // declares both nullable.
      //
      // `softDelete` owns the destroy, so `crudish` drops to `updateOnly`
      // beside it — which also suppresses the canonical create, so the create is
      // author-declared (the shape `scaffold-macros.ddd` spells out, and for the
      // same reason: without it no row can be minted through the API and the
      // lifecycle this fixture exists for never runs).
      aggregate Parcel extends Shipment with crudish(updateOnly: true), softDeletable, softDelete {
        courier: string
        create(reference: string, courier: string) {
          reference := reference
          courier := courier
        }
      }
      // The SIBLING discriminator, with no capability at all — the control that
      // says the filter stays scoped to the rows of its own `kind` rather than
      // narrowing the whole shared table.
      aggregate Crate extends Shipment with crudish {
        weightKg: int = 0
      }
      repository Parcels for Parcel {
        // A declared find, so the capability filter has to reach a read path
        // that is not `all` — and `paged`, because the carrier is where a
        // read-side concern gets dropped on the way through.
        find byCourier(c: string): Parcel paged where this.courier == c
      }
      repository Crates for Crate { }
    }
  }
  api DepotApi from Depot
  storage primary { type: postgres }
  resource depotState { for: Depot, kind: state, use: primary }
  deployable d {
    platform: __PLATFORM__
    contexts: [Depot]
    dataSources: [depotState]
    serves: DepotApi
    port: 4000
  }

  test e2e "a capability filter over a TPH-nullable column hides only its own kind's rows" against d {
    let p = api.parcels.create({ reference: "REF-1", courier: "DHL" })
    let c = api.crates.create({ reference: "REF-2", weightKg: 40 })

    // Both discriminators now have a row in the ONE shared table, and the
    // capability filter is live on only one of them.
    let listed = api.parcels.byCourier({ c: "DHL", page: 1, pageSize: 10 })
    expect(listed.total).toBe(1)
    expect(listed.items.length).toBe(1)

    // The soft delete leaves the row in place — still `kind='Parcel'`, still
    // carrying its courier — so only the filter can hide it.  A read that
    // dropped the predicate still answers 1 here; one that AND-ed it into the
    // page query but not the COUNT answers a total no caller can page to.
    api.parcels.softDelete(p)
    expect(api.parcels.getById(p)).toThrow(404)
    let after = api.parcels.byCourier({ c: "DHL", page: 1, pageSize: 10 })
    expect(after.items.length).toBe(0)
    expect(after.total).toBe(0)

    // `restore()` is dead on arrival, on every backend, for a reason that has
    // nothing to do with inheritance: it addresses a row the capability's own
    // read filter is hiding, and every backend narrows an operation's
    // load-before-write by exactly that filter.  `scaffold-macros.ddd` records
    // the full diagnosis (RS-27) and pins the same 404 there; this line pins it
    // on the TPH crossing too, so a repair has to move BOTH — and so that this
    // fixture's soft-delete half is not quietly asserting a lifecycle the
    // runtime does not have.
    expect(api.parcels.restore(p)).toThrow(404)

    // …and the sibling discriminator was never in scope of a filter that reads
    // a column only Parcel has.  A filter hoisted to the whole shared table
    // (rather than guarded by `kind`) empties this read too.
    let crates = api.crates.all()
    expect(crates.length).toBe(1)
    let readCrate = api.crates.getById(c)
    expect(readCrate.reference).toBe("REF-2")
    expect(readCrate.weightKg).toBe(40)
  }
}
