// `find … paged` over a NON-RELATIONAL carrier — ledger row `F2-CB-C1`.
//
// Pagination and the three storage shapes were each covered (`paged.ddd`,
// `document.ddd`, `event-sourcing.ddd`, `embedded.ddd`) — their CROSSING was
// not, and that is where it broke.  The route, the repository port/interface and
// the response model all derive their contract from `pagedReturn(returnType)`,
// so they declared the 5-argument `Paged<T>` shape; but the document and
// event-log repository builders — which rehydrate the whole set and filter it
// in memory — had no paged branch, and kept emitting the 1-argument unpaged
// method.  A route built for the paged contract against a repository built for
// the unpaged one:
//
//   dotnet  IOrderRepository.InRegion(string, int, int, string, string, CT)
//           vs OrderRepository.InRegion(string, CT)          → CS0535 + CS0029
//   python  `result = await repo.in_region(region, page, pageSize, sort, dir)`
//           vs `async def in_region(self, region) -> Order`  → TypeError, then
//                                                              `result.items`
//
// and NOT ONE diagnostic anywhere: `ddd parse` is clean and all five backends
// report OK.  node / java / elixir already paged both carriers correctly, which
// is the other half of why it stayed invisible — a fixture on any one of them
// would have passed.
//
// Both carriers live here, in one system, because the defect is the CROSSING and
// the two builders are separate code paths: a fixture with only one of them
// leaves the other's arm unexercised.  The `embedded` shape is deliberately
// absent — it reuses the relational row table, so its paged find was always
// correct, and `embedded.ddd` already owns that shape.
//
// The compile legs catch a port/implementation arity split.  An in-memory
// pager that slices before it filters, sorts after it slices, or counts the
// page instead of the match compiles and answers plausible JSON, so the
// `test e2e` block reads the PAGE back: the filtered items, `total` and
// `totalPages` under a narrowed `pageSize`, on both carriers.
system PagedNonRelational {
  subdomain S {
    context Ledger {

      // ── document carrier ── the whole aggregate in one jsonb column, so every
      // find rehydrates and filters in app.
      aggregate Invoice shape: document, with crudish {
        region: string
        total: int
      }
      repository Invoices for Invoice {
        find inRegion(region: string): Invoice paged where this.region == region
      }

      // ── event-log carrier ── no state columns at all; a find folds the stream
      // and filters the folded aggregates.
      aggregate Account persistedAs: eventLog {
        owner: string
        balance: int
        create(owner: string) {
          emit AccountOpened { accountRef: id, owner: owner }
        }
        apply(e: AccountOpened) {
          owner := e.owner
          balance := 0
        }
      }
      event AccountOpened { accountRef: Account id, owner: string }
      repository Accounts for Account {
        find byOwner(owner: string): Account paged where this.owner == owner
      }
    }
  }
  api LedgerApi from S
  storage primary { type: postgres }
  resource ledgerState { for: Ledger, kind: state, use: primary }
  resource ledgerLog { for: Ledger, kind: eventLog, use: primary }
  deployable d {
    platform: __PLATFORM__
    contexts: [Ledger]
    dataSources: [ledgerState, ledgerLog]
    serves: LedgerApi
    port: 4000
  }

  test e2e "a paged find over a document and an event-log carrier pages the filtered set" against d {
    let i1 = api.invoices.create({ region: "EU", total: 30 })
    api.invoices.create({ region: "EU", total: 10 })
    api.invoices.create({ region: "EU", total: 20 })
    api.invoices.create({ region: "NA", total: 5 })

    let eu = api.invoices.inRegion({ region: "EU" })
    expect(eu.items.length).toBe(3)
    expect(eu.total).toBe(3)
    // The window slices the SORTED match: page 2 of size 2 is the third row,
    // and the counts still describe the whole match, not the page.
    let second = api.invoices.inRegion({ region: "EU", page: 2, pageSize: 2, sort: "total", dir: "asc" })
    expect(second.items.length).toBe(1)
    expect(second.items.first().total).toBe(30)
    expect(second.total).toBe(3)
    expect(second.totalPages).toBe(2)
    let first = api.invoices.inRegion({ region: "EU", page: 1, pageSize: 2, sort: "total", dir: "asc" })
    expect(first.items.first().total).toBe(10)

    // The derived document routes.
    api.invoices.update(i1, { region: "NA", total: 31 })
    expect(api.invoices.getById(i1).total).toBe(31)
    expect(api.invoices.inRegion({ region: "EU" }).total).toBe(2)
    expect(api.invoices.all().length).toBe(4)
    api.invoices.destroy(i1)
    expect(api.invoices.getById(i1)).toThrow(404)

    let ada = api.accounts.create({ owner: "Ada" })
    api.accounts.create({ owner: "Bob" })
    let mine = api.accounts.byOwner({ owner: "Ada" })
    expect(mine.items.length).toBe(1)
    expect(mine.total).toBe(1)
    expect(mine.items.first().owner).toBe("Ada")
    expect(api.accounts.getById(ada).balance).toBe(0)
    expect(api.accounts.byOwner({ owner: "Cy" }).total).toBe(0)
    expect(api.accounts.all().length).toBe(2)
  }
}
