// The `envelope` generic carrier: `find … : T envelope` is a SINGLE-ROW find
// (M-T6.57, ratified) — the repository answers one `T`, the route serialises the
// BARE body, and an empty result set is the not-found rung (404).  It carries no
// distinct wire shape, so `T envelope` must emit exactly what `T` emits.
//
// The defect class this fixture exists for is a compile failure: java naming
// an undeclared `Envelope<Order>`, dotnet returning a bare `Order` from a
// `Task<Envelope<Order>>` (CS0029).  The five corpus compile legs read it
// directly.
//
// COMPILE-TIER fixture by design: no `test e2e` block (signed in
// E2E_LESS_CORPUS_FIXTURES + BEHAVIOURAL_ABSENT).  The carrier has no wire
// shape of its own — `test/generator/envelope-carrier.test.ts` asserts the
// emitted project is byte-identical to the same source with the carrier
// spelled away — so a booted block would replay a single-row find other cases
// already boot.
system EnvelopeShop {
  subdomain Sales {
    context Orders {
      aggregate Order with crudish { code: string  region: string }
      repository Orders for Order {
        // Bare carrier — the shape the audit finding reproduced.
        find audit(): Order envelope
      }
      // …and a PARAMETERISED one with a `where`, so the carrier is exercised
      // on the filtered find path too (a different emitter branch on every
      // backend than the filterless one above).
      criterion OrdersLatestInRegion(region: string) of Order = this.region == region
    }
  }
  api OrdersApi from Sales
  storage primary { type: postgres }
  resource ordersState { for: Orders, kind: state, use: primary }
  deployable d {
    platform: __PLATFORM__
    contexts: [Orders]
    dataSources: [ordersState]
    serves: OrdersApi
    port: 4000
  }
}
