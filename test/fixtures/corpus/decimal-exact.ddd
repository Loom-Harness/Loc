// shape: FLOAT-ERROR-VISIBLE `decimal` arithmetic — the witness for M-T5.22 /
// D-DECIMAL-EXACT-MOMENT (RS-37): `decimal` arithmetic is EXACT on every
// backend, on the wire and in storage.
//
// Before the ruling, node and python computed a `decimal` in binary floating
// point (a JS `number` / a Python `float`) while .NET, Java and Elixir computed
// it in a decimal type (System.Decimal / BigDecimal / Decimal).  Every value
// below is one a double gets WRONG, and every one of them was picked so the
// double answer and the exact answer differ AFTER the RS-24 narrowing to a
// float64 wire number — a value that only differs in the 20th digit would pass
// with the fix reverted, which is exactly the vacuous-gate shape
// `numeric-operands.ddd` warns about (its literals are binary-exact on purpose;
// these are binary-INEXACT on purpose):
//
//   sum      0.1 + 0.2        double 0.30000000000000004   exact 0.3
//   cube     1.1 * 1.1 * 1.1  double 1.3310000000000004    exact 1.331   (a CHAINED multiply —
//                             the intermediate must stay exact, not re-narrow per step)
//   ratio    0.3 / 0.1        double 2.9999999999999996    exact 3       (a single division
//                             whose OPERANDS are inexact in binary — "double division is
//                             correctly rounded" only holds for binary-exact inputs)
//   mixed    (0.1 + 0.2) * 3 - 0.3   double 0.6000000000000001   exact 0.6
//   rounded  1.005.round(2)   double 1 (1.005 is 1.00499… in binary)   exact 1.01 (half-up)
//   partsWeight [0.1, 0.2].sum double 0.30000000000000004   exact 0.3     (a collection fold)
//   total    0.1, then accumulate(0.2) — the value an OPERATION writes to a
//            stored column, read back from the database: 0.3, not 0.30000000000000004
//
// The `test` block is the unit-tier proof on every backend (vitest / pytest /
// xUnit / JUnit / ExUnit); the `test e2e` block is the wire + storage proof and
// mints this fixture's wire golden.
system DecimalExact {
  subdomain Lab {
    context Lab {
      aggregate Sample {
        a: decimal
        b: decimal
        c: decimal
        d: decimal
        // Not `e`: a create parameter named `e` collides with the .NET
        // factory's own `var e = new Sample()` (CS0136) — a separate .NET
        // naming defect this fixture found and hands off, not its subject.
        tie: decimal
        total: decimal
        contains parts: Part[]
        entity Part {
          weight: decimal
        }

        create(a: decimal, b: decimal, c: decimal, d: decimal, tie: decimal, total: decimal) {
          a := a
          b := b
          c := c
          d := d
          tie := tie
          total := total
        }

        derived sum: decimal = a + b
        derived cube: decimal = c * c * c
        derived ratio: decimal = d / a
        derived mixed: decimal = (a + b) * 3 - d
        derived rounded: decimal = tie.round(2)
        derived partsWeight: decimal = parts.sum(p => p.weight)

        operation accumulate(x: decimal) {
          total := total + x
        }

        operation addPart(w: decimal) {
          parts += Part { weight: w }
        }

        test "decimal arithmetic is exact, not binary floating point" {
          let s = Sample.create({ a: 0.1, b: 0.2, c: 1.1, d: 0.3, tie: 1.005, total: 0.1 })
          expect(s.sum).toBe(0.3)
          expect(s.cube).toBe(1.331)
          // `3.0`, not `3`: java's unit-test emitter renders an INT literal
          // against a decimal as `compareTo(3)`, which javac refuses (a
          // separate java test-emitter defect this fixture found and hands off).
          expect(s.ratio).toBe(3.0)
          expect(s.mixed).toBe(0.6)
          expect(s.rounded).toBe(1.01)
          s.accumulate(0.2)
          expect(s.total).toBe(0.3)
          s.addPart(0.1)
          s.addPart(0.2)
          expect(s.partsWeight).toBe(0.3)
        }
      }
      repository Samples for Sample { }
    }
  }

  api LabApi from Lab
  storage primary { type: postgres }
  resource labState { for: Lab, kind: state, use: primary }
  deployable d {
    platform: __PLATFORM__
    contexts: [Lab]
    dataSources: [labState]
    serves: LabApi
    port: 4000
  }

  test e2e "decimal arithmetic is exact on the wire and in storage" against d {
    let s = api.samples.create({ a: 0.1, b: 0.2, c: 1.1, d: 0.3, tie: 1.005, total: 0.1 })
    let read = api.samples.getById(s)
    expect(read.sum).toBe(0.3)
    expect(read.cube).toBe(1.331)
    expect(read.ratio).toBe(3)
    expect(read.mixed).toBe(0.6)
    expect(read.rounded).toBe(1.01)

    // An operation's computed value is WRITTEN to a stored column and read
    // back — the storage half of the ruling.
    api.samples.accumulate(s, { x: 0.2 })
    api.samples.addPart(s, { w: 0.1 })
    api.samples.addPart(s, { w: 0.2 })
    let after = api.samples.getById(s)
    expect(after.total).toBe(0.3)
    expect(after.partsWeight).toBe(0.3)
  }
}
