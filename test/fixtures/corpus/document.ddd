// shape: document: whole aggregate tree round-trips one jsonb column.
system DocSys {
  subdomain Cms {
    context Cms {
      // An ENUM field with a declared default, inside the jsonb document.  The
      // document stores the enum as its declared-case string, so the default
      // has to land as that string in the embed; a create that omits the field
      // gets it, on every backend.
      enum Stage { Pending, Published }
      aggregate Article shape: document, with crudish {
        title: string
        viewCount: int
        stage: Stage = Pending
        contains sections: Section[]
        entity Section { heading: string  body: string }
        operation addSection(heading: string, body: string) {
          sections += Section { heading: heading, body: body }
        }
        operation bump() { viewCount := viewCount + 1 }
      }
      repository Articles for Article { }
      criterion ArticlesPopular(min: int) of Article = this.viewCount >= min
      // PAGED: a non-relational repository serves a criterion read through the
      // synthesised paged find; an unpaged `run` has no repository method there.
      queryHandler ListArticlesPopular(min: int): Article paged {
        let r = Articles.run(ArticlesPopular(min))
        return r
      }
      // A capability `filter` on a document aggregate (PROMOTED from the
      // per-backend `*-document-capability-filter.test.ts` string copies,
      // M-T9.42).  The tree is one jsonb column, so the predicate cannot be a
      // SQL `where`: each backend evaluates it IN-APP over the rehydrated
      // instance — on the by-id read, the list, and BEFORE a custom find's own
      // predicate.  (The principal-filter arm needs an authenticated fixture,
      // whose gates belong to the authz census — not carried here.)
      aggregate Draft shape: document, with crudish {
        title: string
        archived: bool
        filter !this.archived
        operation shelve() { archived := true }
      }
      repository Drafts for Draft { }
      criterion DraftsByTitle(t: string) of Draft = this.title == t
      queryHandler ListDraftsByTitle(t: string): Draft paged {
        let r = Drafts.run(DraftsByTitle(t))
        return r
      }
    }
  }
  api CmsApi from Cms {
    route GET "/articles/popular/{min}" -> Cms.ListArticlesPopular
    route GET "/drafts/by_title/{t}" -> Cms.ListDraftsByTitle
  }
  storage primary { type: postgres }
  resource cmsState { for: Cms, kind: state, use: primary }
  deployable d {
    platform: __PLATFORM__
    contexts: [Cms]
    dataSources: [cmsState]
    serves: CmsApi
    port: 4000
  }

  test e2e "document aggregate round-trips the jsonb tree" against d {
    let a = api.articles.create({ title: "T1", viewCount: 0 })
    api.articles.addSection(a, { heading: "H", body: "B" })
    let read = api.articles.getById(a)
    expect(read.title).toBe("T1")
    expect(read.stage).toBe("Pending")

    // The canonical `update` on a `shape: document` aggregate rewrites the
    // ROOT scalars only — `sections` is a containment, not an update param —
    // yet the whole tree lives in ONE jsonb column, so the update has to
    // re-serialize the containment it never received.  A backend that rebuilt
    // the document from the update input alone loses the section here.
    // The update is full-replacement, so it carries `stage` too: a default is a
    // construction rule and relaxes no update field (RS-26).
    api.articles.update(a, { title: "T2", viewCount: 5, stage: "Published" })
    let updated = api.articles.getById(a)
    expect(updated.title).toBe("T2")
    expect(updated.stage).toBe("Published")
    expect(updated.viewCount).toBe(5)
    expect(updated.sections.length).toBe(1)

    // Free adjacents in the same scenario: the domain op that increments the
    // same column the update just set, and the declared find whose threshold
    // that column now crosses.
    api.articles.bump(a)
    let bumped = api.articles.getById(a)
    expect(bumped.viewCount).toBe(6)
    let popular = api.cms.listArticlesPopular(6)
    expect(popular.items.length).toBe(1)

    // The root LIST route.  On `shape: document` the auto-`findAll` is a BARE
    // ARRAY, not the paged envelope (there is no queryable column to page over
    // — the whole tree is one opaque jsonb blob), so this drives the array arm
    // of a derivation every other fixture exercises paged.
    let listed = api.articles.all()
    expect(listed.length).toBe(1)

    // DELETE takes the whole document — root scalars AND the contained sections
    // that live inside the same jsonb column, with no child table to cascade
    // from.  Both the by-id read and the declared find must stop answering.
    api.articles.destroy(a)
    expect(api.articles.getById(a)).toThrow(404)
    let empty = api.articles.all()
    expect(empty.length).toBe(0)
    let gone = api.cms.listArticlesPopular(0)
    expect(gone.items.length).toBe(0)

    // ── the capability filter, evaluated in-app ────────────────────────────
    // Two drafts share a title; one is shelved after creation.  Every read
    // must see only the live one — the custom find's own predicate matches
    // both, so the capability has to narrow first.
    let live = api.drafts.create({ title: "Plan", archived: false })
    let shelved = api.drafts.create({ title: "Plan", archived: false })
    api.drafts.shelve(shelved)
    expect(api.drafts.getById(live).title).toBe("Plan")
    expect(api.drafts.getById(shelved)).toThrow(404)
    expect(api.drafts.all().length).toBe(1)
    let plans = api.cms.listDraftsByTitle("Plan")
    expect(plans.items.length).toBe(1)
    expect(plans.items.first().archived).toBe(false)
    // The write routes load through the same scope.
    api.drafts.update(live, { title: "Plan v2", archived: false })
    expect(api.drafts.getById(live).title).toBe("Plan v2")
    api.drafts.destroy(live)
    expect(api.drafts.all().length).toBe(0)
  }
}
