// Exception-less operation returns: `T or Error` tagged-union result.
system RU {
  subdomain D {
    context Shop {
      // `attemptedCode` is deliberately MULTI-WORD (RS-30).  A declared error's
      // fields become RFC 7807 §3.2 extension members, and the single-word
      // `resource` cannot test their CASING — snake and camel are the same
      // string.  Elixir shipped `%{attempted_code: …}` against the other four's
      // `attemptedCode` for exactly as long as this fixture had only one-word
      // fields.  The golden below now records the camelCase key, so the rule is
      // gated at runtime on all seven behavioural legs.
      error NotFound { resource: string, attemptedCode: string }
      aggregate Order with crudish {
        code: string
        reserved: bool
        operation reject(): string or NotFound { return NotFound { resource: code, attemptedCode: code } }
        operation accept(): string or NotFound { reserved := true  return code }
        // Mutates, then fails: the error leaves no trace (D-FAILURE-MODEL).
        operation hold(): string or NotFound { reserved := true  return NotFound { resource: code, attemptedCode: code } }
      }
      repository Orders for Order { }
    }
  }
  api A from D
  storage primary { type: postgres }
  resource st { for: Shop, kind: state, use: primary }
  deployable d {
    platform: __PLATFORM__
    contexts: [Shop]
    dataSources: [st]
    serves: A
    port: 4000
  }

  // The error variants run LAST, so the read-back after them can pin that
  // they changed nothing.
  test e2e "exception-less op: reject returns the NotFound error (404)" against d {
    let o = api.orders.create({ code: "OR1", reserved: false })
    api.orders.accept(o)

    // The canonical `update` on the same aggregate — the ORDINARY (void) op
    // beside the two union-returning ones.  `accept()` already flipped
    // `reserved` through a `T or Error` route; this writes the same field
    // through the 204-no-body route, so both response shapes of one aggregate
    // are driven in one suite.
    api.orders.update(o, { code: "OR2", reserved: false })
    let read = api.orders.getById(o)
    expect(read.code).toBe("OR2")
    expect(read.reserved).toBe(false)

    // The LIST and DELETE routes.
    let second = api.orders.create({ code: "OR3", reserved: false })
    let both = api.orders.all({ sort: "code", dir: "asc" })
    expect(both.items.length).toBe(2)
    expect(both.total).toBe(2)
    api.orders.destroy(second)
    expect(api.orders.getById(second)).toThrow(404)
    let left = api.orders.all()
    expect(left.items.length).toBe(1)
    expect(left.total).toBe(1)

    // …and only THEN the error variants.  An operation that returns its
    // `error` variant leaves no trace (D-FAILURE-MODEL): `hold` sets
    // `reserved` before it fails, and the read-back finds neither the flag nor
    // a version bump — the route answers the error before it saves.
    expect(api.orders.reject(o)).toThrow(404)
    expect(api.orders.hold(o)).toThrow(404)
    let after = api.orders.getById(o)
    expect(after.reserved).toBe(false)
    expect(after.version).toBe(3)
  }
}
