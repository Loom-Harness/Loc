// shape: an operation's VALUE-OBJECT PARAM appended to a value collection —
// called over its own route and from a workflow.
//
// The param arrives as JSON: string keys, a datetime as text, an enum as a
// string.  Elixir rewrites the collection with `put_assoc`, which takes typed,
// atom-keyed rows, and handed it the raw map — `ArgumentError: field names
// given to change/put_change must be atoms`, then `Ecto.ChangeError` on the
// datetime: a 500 where every other backend answers 204.
system ValueCollectionOpParam {
  subdomain Matching {
    context Matching {
      enum Kind { Skill, Licence }

      valueobject Attribute {
        name: string
        kind: Kind
        weight: decimal
        until: datetime?
        invariant weight >= 0
      }

      aggregate Provider with crudish {
        name: string
        attributes: Attribute[]

        operation putAttribute(v: Attribute) {
          attributes += v
        }
      }
      repository Providers for Provider { }

      workflow grant {
        create(provider: Provider id, v: Attribute) {
          let p = Providers.get(provider)
          p.putAttribute(v)
        }
      }
    }
  }

  api MatchingApi from Matching
  storage primary { type: postgres }
  resource matchingState { for: Matching, kind: state, use: primary }
  deployable d {
    platform: __PLATFORM__
    contexts: [Matching]
    dataSources: [matchingState]
    serves: MatchingApi
    port: 4000
  }

  test e2e "a value-object param is cast before it joins a value collection" against d {
    let p = api.providers.create({ name: "p", attributes: [] })
    api.providers.putAttribute(p, { v: { name: "cpr", kind: "Licence", weight: 1.5, until: "2027-12-31T10:11:12Z" } })
    api.grant.run({ provider: p.id, v: { name: "triage", kind: "Skill", weight: 2 } })

    let read = api.providers.getById(p)
    expect(read.attributes.count()).toBe(2)
    let cpr = read.attributes.where(a => a.name == "cpr").first()
    expect(cpr.kind).toBe("Licence")
    expect(decimal(cpr.weight)).toBe(1.5)
    expect(cpr.until).toBe("2027-12-31T10:11:12Z")
    let triage = read.attributes.where(a => a.name == "triage").first()
    expect(triage.until).toBe(null)

  }
}
