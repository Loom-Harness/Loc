// Event-sourced workflow (workflow-and-applier.md): the saga folds its own
// emitted events into state and persists as an append-only stream.
system FulfillmentSys {
  subdomain Fulfillment {
    context Fulfillment {
      aggregate Order {
        status: string
        // An explicit create so the saga can be driven at runtime (the
        // eventSourced workflow below is triggered by OrderPlaced, which
        // `place()` emits — so an Order must first exist).
        create(status: string) { }
        operation place() {
          precondition status == "Draft"
          status := "Placed"
          emit OrderPlaced { order: id, at: now() }
        }
        operation archive() { emit OrderArchived { order: id } }
      }
      repository Orders for Order { }
      event OrderPlaced { order: Order id, at: datetime }
      event PaymentRegistered { order: Order id, amount: int }
      event FulfillmentCancelled { order: Order id }
      event OrderArchived { order: Order id }
      event ArchiveRecorded { order: Order id, count: int }
      channel Lifecycle {
        carries: OrderPlaced, PaymentRegistered, FulfillmentCancelled, OrderArchived, ArchiveRecorded
        delivery: broadcast
        retention: ephemeral
      }
      workflow OrderFulfillment eventSourced {
        orderId: Order id
        paid: int
        cancelled: bool
        create(p: OrderPlaced) by p.order {
          emit PaymentRegistered { order: p.order, amount: 0 }
        }
        on(pr: PaymentRegistered) by pr.order {
          precondition paid >= 0
          emit FulfillmentCancelled { order: pr.order }
        }
        apply(pr: PaymentRegistered) { paid := paid + pr.amount }
        apply(fc: FulfillmentCancelled) { cancelled := true }
      }
      // The STARTER GUARD (S5b; PROMOTED from the per-backend
      // `*-saga-starter-guard.test.ts` string copies, M-T9.42): `create` AND
      // `on` for the SAME event.  A new correlation must run the create only,
      // an existing one the on only — so each archive() folds exactly ONE
      // ArchiveRecorded.  An unguarded starter double-appends (2 after the
      // first archive), and a starter that runs after the reactor on a fresh
      // stream appends twice as well.
      workflow ArchiveTracker eventSourced {
        orderId: Order id
        archivedCount: int
        create(e: OrderArchived) by e.order {
          emit ArchiveRecorded { order: e.order, count: 1 }
        }
        on(e: OrderArchived) by e.order {
          emit ArchiveRecorded { order: e.order, count: 1 }
        }
        apply(r: ArchiveRecorded) { archivedCount := archivedCount + r.count }
      }
    }
  }
  api FulfillmentApi from Fulfillment
  storage pg { type: postgres }
  resource fulfillmentState { for: Fulfillment, kind: state, use: pg }
  deployable d {
    platform: __PLATFORM__
    contexts: [Fulfillment]
    serves: FulfillmentApi
    dataSources: [fulfillmentState]
    port: 4000
  }

  // Runtime validation of the self-folding saga (M-T9.12): `place()` emits
  // OrderPlaced, which starts the eventSourced workflow — its create emits
  // PaymentRegistered, apply(PaymentRegistered) folds `paid`, the on() handler
  // reads that folded `paid` in `precondition paid >= 0` and emits
  // FulfillmentCancelled, and apply(FulfillmentCancelled) folds `cancelled`.
  // Driving the cascade end to end exercises the whole emit → apply-fold →
  // precondition-reads-folded-state chain in one request (synchronous
  // in-process dispatch); a backend whose applier doesn't fold before the next
  // handler's precondition reads it throws mid-cascade and `place()` fails.
  // (Asserting the folded instance SCALARS — `paid`/`cancelled` — needs a
  // workflow-instance read verb the `test e2e` DSL doesn't have yet; tracked as
  // M-T9.12 follow-up. This asserts the observable: the order round-trips and
  // the saga ran without error.)
  test e2e "placing an order drives the self-folding fulfillment saga without error" against d {
    let o = api.orders.create({ status: "Draft" })
    api.orders.place(o)
    let read = api.orders.getById(o)
    expect(read.status).toBe("Placed")

    // The root LIST route.  `Order` here is an ORDINARY relational aggregate
    // (only the workflow is event-sourced), so `all` is the paged envelope —
    // and reading it after the saga cascade is the assertion the block's own
    // note calls for indirectly: a backend whose saga wrote a second Order row
    // (a create-handler mis-keyed to the aggregate rather than the workflow
    // instance) shows up as `total: 2` here, invisible to the by-id read.
    let listed = api.orders.all()
    expect(listed.items.length).toBe(1)
    expect(listed.total).toBe(1)

    // The saga's INSTANCE reads (PROMOTED from the per-backend
    // `*-workflow-instances.test.ts` string copies, M-T9.42).  An
    // event-sourced saga has no state table: LIST folds every stream and
    // by-key folds one, so the instance these routes answer is the fold of
    // the events the placement set off — the starter's PaymentRegistered
    // (amount 0) and the reactor's FulfillmentCancelled.
    let running = api.orderFulfillment.instances()
    expect(running.count()).toBe(1)
    let inst = api.orderFulfillment.instance(o)
    expect(inst.paid).toBe(0)
    expect(inst.cancelled).toBe(true)

    // The starter guard: the first archive() STARTS the tracker's stream, the
    // second is routed to the reactor — one fold each, never two.
    api.orders.archive(o)
    expect(api.archiveTracker.instance(o).archivedCount).toBe(1)
    api.orders.archive(o)
    expect(api.archiveTracker.instance(o).archivedCount).toBe(2)
    expect(api.archiveTracker.instances().count()).toBe(1)
  }
}
