        operation volatile(volatile: int) { tally := volatile }
        operation while(while: int) { tally := while }
        operation yield(yield: int) { tally := yield }
        operation withReservedParams(abstract: int, component: int, event: int, extern: int, filter: int, global: int, implements: int, internal: int, of: int, or: int, readonly: int, required: int, select: int, state: int, type: int, use: int) { tally := abstract }
      }

      repository KeywordsRepo for Keywords { }
      repository VerbsRepo for Verbs { }
    }
  }

  api WordsApi from Words
  storage pg { type: postgres }
  resource lexState { for: Lexicon, kind: state, use: pg }
  deployable d {
    platform: __PLATFORM__
    contexts: [Lexicon]
    dataSources: [lexState]
    serves: WordsApi
    port: 4000
  }
}
