system TargetReservedWords {
  subdomain Words {
    context Lexicon {
      enum Keyword { after, alias, and, any, arguments, assert, async, atomic, base, begin, boolean, break, byte, bytes, case, catch, char, checked, class, cls, cond, const, constraint, constructor, continue, copy, covariant, data, debugger, declare, def, default, deferred, defmodule, defp, del, delegate, delete, dict, do, done, double, downcast, downto, dynamic, eager, elif, end, eval, except, exception, exec, explicit, export, extension, external, factory, final, finally, fixed, float, fn, foreach, fun, functor, get, goto, hide, implicit, include, infer, inherit, init, inline, input, instanceof, interface, is, keyof, lambda, late, lazy, len, library, list, lock, map, member, method, mixin, module, mutable, namespace, native, never, new, nil, nonlocal, not, object, open, operator, out, override, package, parallel, params, part, pass, permits, print, process, protected, public, pure, quote, raise, rec, receive, record, ref, require, rescue, rethrow, sbyte, sealed, self, set, short, show, sizeof, stackalloc, str, strictfp, struct, super, switch, synchronized, tailcall, then, throw, throws, to, trait, transient, try, typedef, typeof, uint, ulong, unchecked, unknown, unquote, unsafe, upcast, ushort, using, val, value, var, virtual, void, volatile, while, yield }

