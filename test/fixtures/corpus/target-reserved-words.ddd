        operation library(library: int) { tally := library }
        operation list(list: int) { tally := list }
        operation lock(lock: int) { tally := lock }
        operation map(map: int) { tally := map }
        operation member(member: int) { tally := member }
        operation method(method: int) { tally := method }
        operation mixin(mixin: int) { tally := mixin }
        operation module(module: int) { tally := module }
        operation mutable(mutable: int) { tally := mutable }
        operation namespace(namespace: int) { tally := namespace }
        operation native(native: int) { tally := native }
        operation never(never: int) { tally := never }
