// shape: RIGHT-HAND money/decimal operands — the commutative shapes the
// validator admits that no fixture had ever written down.
//
// Minted by the 2026-08-23 numeric-types audit (finding F7 / M-T6.44).  The
// type system admits `money × scalar` COMMUTATIVELY (`moneyArithmetic`),
// numeric widening admits `int + decimal` in both orders, and `comparable`
// admits `int < decimal` — but the TS and Elixir binary renderers gated their
// money/decimal dispatch on `leftType` ALONE, so every shape below emitted
// native operators against a Decimal struct:
//
//   lineTotal    int * money   node: TS2363 (the generated project does not
//                              compile); elixir: runtime ArithmeticError
//   adjusted     int + decimal elixir: runtime ArithmeticError
//   underTarget  int < decimal elixir: native `<` on a %Decimal{} falls to
//                              Erlang TERM ordering (number < map ⇒ ALWAYS
//                              true) — silently wrong, no crash
//   sameAsGoal   int == decimal elixir: native `==` on int vs struct is
//                              always false — the equality twin
//
// Java carries the mirror arm already (fleet-bug-hunt A4); .NET and Python
// coerce natively (C# implicit int→decimal; Python Decimal.__rmul__) — the
// per-backend arm tests pin those not-affected claims.
//
// The decimal literals are BINARY-EXACT (`0.5`, `0.25`) on purpose: the unit
// assertions then agree on all five backends whatever the still-un-ruled
// cross-backend decimal-arithmetic representation (audit F11 / M-T5.22) says.
// The fixture rides the generation gate, the per-backend COMPILE tiers, and
// every backend's UNIT tier (the `test` block below runs as real
// ExUnit/vitest/pytest/JUnit/xUnit assertions — the Elixir run is the runtime
// proof the term-ordering comparison actually flipped).
//
// RUNTIME + COMPILE + UNIT (wave C3 packet 3a, M-T9.13).  This header used to
// withhold a `test e2e` block because "a wire golden minted here would pre-empt"
// the decimal ruling.  M-T5.22 is RULED (exact, RS-37 — wave C5 moment 5a), so
// that reason is gone.  And the unit block cannot see the half that matters
// most at runtime: it constructs the operands IN MEMORY, while a booted read
// evaluates the derived getters over values HYDRATED from `numeric` columns
// (a `%Decimal{}` from Postgrex, a `Decimal` from asyncpg, a string-parsed
// `Number` on node).  It also never asserts the TRUE arm of `sameAsGoal`, the
// one native `==` on an int and a Decimal struct always gets wrong.  So
// `Order` gained `crudish` and the block at the bottom reads all four back
// after create, after the operation, and after an update that makes the
// equality hold.
system NumericOperands {
  subdomain Sales {
    context Sales {
      aggregate Order with crudish {
        qty: int
        price: money
        count: int
        factor: decimal

        // int * money — money on the RIGHT of the commutative product.
        derived lineTotal: money = qty * price
        // int + decimal — widening with the decimal on the RIGHT.
        derived adjusted: decimal = count + factor
        // int < decimal — the silently-always-true comparison on elixir.
        derived underTarget: bool = count < factor
        // int == decimal — the always-false equality twin.
        derived sameAsGoal: bool = count == factor

        operation restock(by: int) {
          count := count + by
        }

        // Pure-domain (unit) test — runs on every backend's unit tier.  The
        // values are chosen so a term-ordering `<` (always true) and a native
        // struct `==` (always false) both FLIP an assertion: count=3 vs
        // factor=2.5 makes `underTarget` false and, after restock(-1),
        // count=2 vs 2.5 makes it true; factor=2.5 is binary-exact so
        // `adjusted` is 5.5 on every backend regardless of representation.
        test "right-hand money/decimal operands compute, compare, and equal correctly" {
          let o = Order.create({ qty: 3, price: money("2.5000"), count: 3, factor: 2.5 })
          expect(o.lineTotal == money("7.5000")).toBe(true)
          expect(o.adjusted).toBe(5.5)
          expect(o.underTarget).toBe(false)
          expect(o.sameAsGoal).toBe(false)
          o.restock(-1)
          expect(o.underTarget).toBe(true)
        }
      }

      // Auto-findAll only.  A decimal-param `find … where this.factor < limit`
      // was WRITTEN here and then removed: it exposed a PRE-EXISTING node gap
      // (drizzle types a numeric column `string`, the wire param is `number`,
      // so the emitted `lt(col, param)` is TS2769 — the generated project does
      // not compile), which belongs to the repository find builders, not to
      // the expression gates this fixture witnesses.  Recorded in the M-T6.44
      // PR body as a named finding; the Ecto-filter-path safety is pinned by
      // the filter-context cases in vanilla-render-expr.test.ts instead.
      repository Orders for Order { }
    }
  }

  api SalesApi from Sales
  storage primary { type: postgres }
  resource salesState { for: Sales, kind: state, use: primary }
  deployable d {
    platform: __PLATFORM__
    contexts: [Sales]
    dataSources: [salesState]
    serves: SalesApi
    port: 4000
  }

  test e2e "right-hand money/decimal operands evaluate over HYDRATED values" against d {
    let o = api.orders.create({ qty: 3, price: money("2.50"), count: 2, factor: 2.5 })
    let read = api.orders.getById(o)
    // int * money
    expect(decimal(read.lineTotal)).toBe(7.5)
    // int + decimal
    expect(read.adjusted).toBe(4.5)
    // int < decimal — 2 < 2.5
    expect(read.underTarget).toBe(true)
    expect(read.sameAsGoal).toBe(false)

    // Through the operation: count 2 → 3, now ABOVE the factor.
    api.orders.restock(o, { by: 1 })
    let restocked = api.orders.getById(o)
    expect(restocked.adjusted).toBe(5.5)
    expect(restocked.underTarget).toBe(false)
    expect(restocked.sameAsGoal).toBe(false)

    // int == decimal, the TRUE arm: count 3 against a factor of 3.
    api.orders.update(o, { qty: 4, price: money("0.25"), count: 3, factor: 3 })
    let equal = api.orders.getById(o)
    expect(equal.sameAsGoal).toBe(true)
    expect(equal.underTarget).toBe(false)
    expect(decimal(equal.lineTotal)).toBe(1)
    expect(equal.adjusted).toBe(6)

    expect(api.orders.all().total).toBe(1)
    api.orders.destroy(o)
    expect(api.orders.getById(o)).toThrow(404)
  }
}
