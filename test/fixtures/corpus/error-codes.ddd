// Every refusal carries the catalog `code` a client localizes it by (#4473).
//
// The other fixtures' goldens already pin most codes (field.missing, a named
// and an unnamed rule, problem.not-found, problem.state-gate, the declared
// error variants, the 500's `{ requestId }`).  This one reaches the refusals
// no other booted fixture asks for — an out-of-range money, an `extern`
// stub's 501, a still-referenced delete — so the golden shows their codes
// too.  It runs on the backends whose `error-code-rows.ts` row is `done`;
// a fan-out backend joins `backends` when it flips its row.
system ErrorCodes {
  subdomain Shop {
    context Shop {
      aggregate Category with crudish {
        name: string
      }
      aggregate Product with crudish {
        name: string
        price: money
        category: Category id
        operation ship() extern { }
      }
      repository Categories for Category { }
      repository Products for Product { }
    }
  }
  api ShopApi from Shop
  storage pg { type: postgres }
  resource shopState { for: Shop, kind: state, use: pg }
  deployable d {
    platform: __PLATFORM__
    contexts: [Shop]
    dataSources: [shopState]
    serves: ShopApi
    port: 4000
  }

  test e2e "every refusal answers its catalog code" against d {
    let tools = api.categories.create({ name: "Tools" })
    let saw = api.products.create({ name: "Saw", price: money("9.99"), category: tools.id })
    // field.money-range — a well-formed decimal too large for the column.
    expect(api.products.create({ name: "Big", price: "1234567890123456789012345678901234567890", category: tools.id })).toThrow(422)
    // problem.not-implemented — the `extern` operation's stub was never filled in.
    expect(api.products.ship(saw)).toThrow(501)
    // problem.referenced-in-use — a category a product still points at.
    expect(api.categories.destroy(tools)).toThrow(409)
    expect(api.products.getById(saw).name).toBe("Saw")
    // field.malformed-id — a reference that is not a uuid.
    expect(api.products.create({ name: "Nail", price: money("0.10"), category: "not-a-uuid" })).toThrow(422)
  }
}
