// Multi-tenancy — the REGISTRY TREE beside flat data visibility, driven at
// RUNTIME over a booted backend (docs/tenancy.md → "The registry tree" + "The
// policy {} block").  Sibling of tenancy-owned.ddd (which proves the tenant
// floor on its own); this fixture proves the tree takes no part in a data read.
//
//   - `Org implements tenantRegistry` → the registry tree (`parent` self-FK).
//     `signUpChild` is the signUp-style create factory (load the parent via
//     repo-let → create the child with its `parent` FK), compiled + exercised
//     through every backend's workflow emitter.
//   - `Account` and `Entry` carry no rule → the own-org floor (the default):
//     a parent org does NOT see its child orgs' rows, and a child does not see
//     its parent's.
//   - `Memo`    carries `policy allow local` → the same floor, spelled out.
//   - `Note`    carries `policy deny write`  → read-only (every mutation 404s).
//   - `touchAccounts` / `touchNotes` mutate every row a criterion read returns:
//     a row outside the caller's write scope (`deny write`) fails the whole
//     workflow with the op route's 404 and rolls back, whatever loaded it.
//
// The deployable platform is substituted per leg (node/python/java/dotnet/elixir).
system TenantHierarchy {
  user { id: guid  tenantId: string }

  tenancy by user.tenantId of Org

  subdomain Core {
    context Books {
      // The own-org floor (no rule) — a parent org never sees a child's rows.
      aggregate Account with tenantOwned, crudish {
        label: string
        amount: int
        operation touch() { amount := amount + 1 }
      }
      // The own-org floor (no rule).
      aggregate Entry with tenantOwned, crudish {
        label: string
      }
      // `allow local` — the floor, spelled out.
      aggregate Memo with tenantOwned, crudish {
        label: string
      }
      // deny write — readable, never mutated.
      aggregate Note with tenantOwned, crudish {
        label: string
        hits: int
        operation touch() { hits := hits + 1 }
      }
      // The tenant registry, opted into the tree: the plain create takes
      // `name` + the `parent` self-FK.
      aggregate Org with crudish {
        name: string
        implements tenantRegistry
      }
      repository Accounts for Account { }
      repository Entries for Entry { }
      repository Memos for Memo { }
      repository Notes for Note { }
      criterion AnyAccount of Account = amount >= 0
      criterion AnyNote of Note = hits >= 0
      // Bulk mutation over every row the caller can READ.
      workflow touchAccounts {
        create() {
          let rows = Accounts.all(AnyAccount, sort: [label asc], page: { offset: 0, limit: 100 })
          for a in rows { a.touch() }
        }
      }
      workflow touchNotes {
        create() {
          let rows = Notes.all(AnyNote, page: { offset: 0, limit: 100 })
          for n in rows { n.touch() }
        }
      }
      repository Orgs for Org { }
      // The child-signup create factory: load the parent via repo-let, then
      // create the child with its `parent` FK and a name derived off the
      // parent's.  Compiled + emitted on every backend (structural leg of the
      // signUp-style create factory).
      workflow signUpChild {
        create(nm: string, seg: string, par: Org id) {
          let loaded = Orgs.get(par)
          let child = Org.create(name: loaded.name + "." + seg + "." + nm, parent: par)
        }
      }
      policy {
        allow local on Memo
        deny write on Note
      }
    }
  }

  api BooksApi from Core
  storage primary { type: postgres }
  resource booksState { for: Books, kind: state, use: primary }
  deployable d {
    platform: __PLATFORM__
    contexts: [Books]
    dataSources: [booksState]
    serves: BooksApi
    port: 4000
    auth: required
  }
}
