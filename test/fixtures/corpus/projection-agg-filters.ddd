// Query-time projection AGGREGATIONS × capability filters — the crossing no
// other corpus fixture makes.  `projection-aggregation.ddd` and
// `projection-groupby.ddd` cover the two aggregation SHAPES; `tenancy-owned.ddd`
// and `tenancy-filter.ddd` cover the capability FILTER.  Neither pair crosses,
// which is exactly why the aggregation arms of four backends read the source
// table with only the projection's own `where` applied and never the source
// aggregate's `contextFilters` — a cross-tenant COUNT/SUM leak on node
// (drizzle + mikroorm), python and java, and on the .NET *dapper* adapter
// (.NET/EF was correct all along: `HasQueryFilter` is global, so the
// aggregation inherits it; elixir was correct too).
//
// With `softDeletable` alone the same leak is a plain WRONG NUMBER with no auth
// involved: the aggregation counts rows `findAll` excludes.  `scaffoldDashboard`
// emits exactly this shape, so a scaffolded dashboard on a multi-tenant system
// showed GLOBAL totals.
//
// The aggregate below carries BOTH filter-contributing capabilities, so each
// emitted aggregation read has to carry TWO predicates (tenant column AND
// not-deleted) — a backend that applies one and drops the other fails the gate
// as loudly as one that applies neither.  `Reading` is the `ignoring` witness:
// `ignoring softDeletable` must drop the not-deleted conjunct and KEEP the
// tenant one, exactly as the row-shaped repository path does.
//
// RUNTIME + COMPILE.  This header used to say "COMPILE-TIER ONLY — no `test e2e`
// block", on the grounds that the runtime assertion needs a two-principal
// harness.  That was true of ONE of the two conjuncts and was applied to both.
//
// The `softDeletable` conjunct is a statement about rows the SAME principal
// wrote, so it is assertable with one identity — and it is the half this header
// already described as "a plain WRONG NUMBER with no auth involved".  The
// `test e2e` block below drives it, and the load-bearing pair is `OrderVolume`
// vs `AllTimeVolume`: same table, same shape, no `where` on either, differing
// only in `ignoring softDeletable`.  Once a row is soft-deleted they must
// DISAGREE (2 and 3), which catches a backend that drops the predicates AND one
// that applies them to the `ignoring` read, in one assertion.
//
// Draining it needed a fixture change, and the fixture change IS the finding:
// `softDeletable` is a pure mixin (fields + filter, no operation), so with the
// capability alone nothing could ever set `isDeleted` through the api and the
// conjunct was unobservable at runtime — `crudish`'s `destroy` is a hard delete,
// which moves every count equally whether the predicate is emitted or not.  The
// `softDelete` MACRO had to join it, exactly as `scaffold-macros`' `Item` (#2468).
//
// STILL COMPILE-TIER ONLY: the TENANT conjunct.  Showing a second tenant's rows
// are absent from a total needs rows written by another principal, and a
// `test e2e` block runs entirely as one; the cross-tenant ladder rung cannot
// carry it either, because a leaking aggregation answers 200 with a wrong
// NUMBER and the ladder asserts status.  The per-backend generator tests remain
// the oracle for that half.
system ProjectionAggFilters {
  user { id: guid  tenantId: string }

  tenancy by user.tenantId of Organization

  subdomain Sales {
    context Orders {
      enum OrderStatus { Draft Confirmed Cancelled }

      // `softDelete` (the MACRO) joins the capability deliberately.  A
      // capability is a pure mixin — `softDeletable` supplies the `isDeleted`
      // field and the read filter and NO OPERATION — so with the capability
      // alone nothing can ever set `isDeleted` through the api, and the
      // not-deleted conjunct this fixture exists to test is UNOBSERVABLE at
      // runtime: `crudish`'s `destroy` is a hard delete, which removes the row
      // and moves every count equally whether the predicate is emitted or not.
      // Same shape, same fix, same reason as `scaffold-macros`' `Item` (#2468).
      aggregate Order with tenantOwned, softDeletable, softDelete, crudish {
        code: string
        total: money
        lineCount: int
        status: OrderStatus
        derived display: string = code
      }

      repository Orders for Order { }

      criterion Confirmed of Order as o = o.status == OrderStatus.Confirmed

      // WHOLE-TABLE aggregation over a doubly-filtered source: the emitted read
      // must AND the tenant predicate and the not-deleted predicate into the
      // SAME query as the criterion `where`.
      projection SalesTotals {
        orders: int
        revenue: money
        from Order as o
        where Confirmed
        select orders = count(),
               revenue = sum(o.total)
      }

      // Unfiltered whole-table count — the smallest shape, and the one with no
      // `where` at all, so the capability predicates are the ENTIRE WHERE clause
      // (a backend that only ever appended to an existing `where` emits none).
      projection OrderVolume {
        total: int
        from Order as o
        select total = count()
      }

      // GROUPED aggregation — the same predicates must ride the grouped query.
      projection SalesByStatus {
        status: OrderStatus
        orders: int
        revenue: money
        from Order as o
        group by o.status
        select status = o.status,
               orders = count(),
               revenue = sum(o.total)
      }

      // `ignoring` witness: the named capability's predicate is OMITTED for this
      // read only; the tenant predicate it did not name stays.
      projection AllTimeVolume {
        total: int
        from Order as o
        ignoring softDeletable
        select total = count()
      }
    }
    context Accounts {
      aggregate Organization with crudish {
        name: string
      }
    }
  }

  api OrdersApi from Sales

  storage pg { type: postgres }
  resource ordersState { for: Orders, kind: state, use: pg }
  resource accountsState { for: Accounts, kind: state, use: pg }
  deployable d {
    platform: __PLATFORM__
    contexts: [Orders, Accounts]
    dataSources: [ordersState, accountsState]
    serves: OrdersApi
    port: 4000
    auth: required
  }

  // ── RUNTIME half (wave-3 row 3.3) ─────────────────────────────────────────
  // The header used to say this fixture could have no `test e2e` block at all,
  // because the assertion it wants needs a second tenancy principal.  That is
  // true of the TENANT conjunct and only of it.  The aggregate carries TWO
  // filter-contributing capabilities, and the `softDeletable` one is a
  // statement about rows the SAME principal wrote — so it is assertable today,
  // and it is the half the header itself describes as "a plain WRONG NUMBER
  // with no auth involved: the aggregation counts rows `findAll` excludes".
  //
  // The load-bearing pair is `OrderVolume` vs `AllTimeVolume`.  Same table, same
  // shape, no `where` on either; the ONLY difference is that `AllTimeVolume`
  // declares `ignoring softDeletable`.  After one row is soft-deleted they must
  // DISAGREE — 2 and 3.  That single divergence catches both directions of the
  // bug at once, which no single-number assertion can:
  //
  //   * a backend that drops the capability predicates from aggregation reads
  //     (the node/python/java/dapper leak this fixture was written for) reads
  //     3 for `OrderVolume`, and the two agree when they must not;
  //   * a backend that applies them to the `ignoring` read as well reads 2 for
  //     `AllTimeVolume`, and they agree again from the other side.
  //
  // What this still does NOT prove is the tenant conjunct: showing a second
  // tenant's rows are absent from a total needs rows written by another
  // principal, and a `test e2e` block runs entirely as one.  The cross-tenant
  // ladder rung added in slice 1 cannot carry it either — a leaking aggregation
  // answers 200 with a wrong NUMBER, and the ladder asserts status.  That half
  // stays with the per-backend generator tests until the harness can seed as a
  // second principal.
  test e2e "capability predicates ride the aggregation reads — and `ignoring` drops exactly one" against d {
    // Empty table: `count()` zero-defaults on both shapes.
    let empty = api.orderVolume.list()
    expect(empty.total).toBe(0)
    let emptyAll = api.allTimeVolume.list()
    expect(emptyAll.total).toBe(0)

    // Two Confirmed, one Draft.  The criterion `where` is the pre-existing
    // predicate the capability conjuncts must AND with rather than replace.
    let a = api.orders.create({ code: "O-1", total: money("10.00"), lineCount: 2, status: "Confirmed" })
    let b = api.orders.create({ code: "O-2", total: money("30.00"), lineCount: 4, status: "Confirmed" })
    let draft = api.orders.create({ code: "O-3", total: money("5.00"), lineCount: 1, status: "Draft" })

    let totals = api.salesTotals.list()
    expect(totals.orders).toBe(2)
    expect(decimal(totals.revenue)).toBe(40)
    let volume = api.orderVolume.list()
    expect(volume.total).toBe(3)
    let allTime = api.allTimeVolume.list()
    expect(allTime.total).toBe(3)

    // ── the soft delete ───────────────────────────────────────────────────
    // `softDeletable` turns this into an UPDATE, so the row stays in the table
    // and only the capability predicate hides it.  That is what makes the next
    // four assertions a test of the emitted WHERE clause rather than of DELETE.
    api.orders.softDelete(b)

    // The filtered reads move; the `ignoring` read does not.
    let volumeAfter = api.orderVolume.list()
    expect(volumeAfter.total).toBe(2)
    let allTimeAfter = api.allTimeVolume.list()
    expect(allTimeAfter.total).toBe(3)

    // The same predicate has to ride the criterion-filtered read…
    let totalsAfter = api.salesTotals.list()
    expect(totalsAfter.orders).toBe(1)
    expect(decimal(totalsAfter.revenue)).toBe(10)

    // …and the GROUPED read — which this block deliberately does NOT call.
    //
    // Not a limitation of the e2e vocabulary: the read works, and asserting it
    // was the first draft.  It is a cross-backend DIVERGENCE, measured on the
    // python behavioural leg against the node-oracle golden:
    //
    //   #12 GET /api/projections/sales_by_status
    //     golden [{"status":"Draft",…},{"status":"Confirmed",…}]
    //        ≠ python [{"status":"Confirmed",…},{"status":"Draft",…}]
    //
    // `ddd.langium` states the contract on the `group by` clause — "rows come
    // back ordered by the grouping columns so the read is deterministic across
    // backends" — and every backend does emit `ORDER BY <grouping columns>`.
    //
    // The first reading of this divergence was that node declares the enum as
    // a real Postgres `CREATE TYPE … AS ENUM` (declaration order) while the
    // others store text (lexicographic).  **That was wrong**, and the correct
    // account is worse.  `mapTypeToColumn` (`src/system/migrations-builder.ts`)
    // maps `enum -> text` for EVERY backend, so all five migration chains emit
    // `TEXT` and all five DEPLOYED apps sort lexicographically.  Verified in
    // the emitted node project: `db/migrations/*.sql` says
    // `"visibility" TEXT NOT NULL` with no `CREATE TYPE` anywhere, while
    // `db/schema.ts` beside it says `pgEnum("visibility", …)`.
    //
    // The behavioural harness builds its PGlite schema from the drizzle SCHEMA
    // OBJECT (`web/src/runtime/ddl.ts`), not from the migration chain — so it
    // created the enum TYPE that no deployed node app has, and the oracle every
    // wire golden is captured on sorted by declaration order while all five
    // real backends, node included, sorted lexicographically.  The backends
    // agreed with each other and disagreed with the ORACLE.
    //
    // Same `ddl.ts` seam, third blind spot: no FKs, enum-as-pgEnum vs TEXT
    // ordering, no array columns.
    //
    //
    // Worth recording, because it is the reason this went unnoticed: the
    // corpus's DEDICATED grouped-read fixture, `projection-groupby.ddd`,
    // groups by this same enum and its golden is green on every leg — because
    // every read it records returns at most ONE group, and with one row the
    // order is unobservable.  Its header claims it covers "the deterministic
    // ORDER BY over the grouping columns"; it does not, and could not.  This
    // block was the first to put TWO groups on the wire, which is the only
    // reason the divergence surfaced at all.
    // A golden over this read would therefore pin the HARNESS's collation
    // rather than a contract, so the call stays out until the divergence is
    // settled.  Putting it back is the check that the fix worked: this block
    // is where the grouped read's runtime oracle belongs, and the only reason
    // it is not here is that the promise it would assert is currently false.

    // `restore()` cannot reach the row it is for — the SAME RS-27 shape
    // `scaffold-macros` pins out loud: the route loads through the scoped read,
    // which the capability's own filter hides, so the only honest assertion is
    // the 404.  Recorded here too because this fixture now drives the identical
    // lifecycle, and a fix that lifts the restriction must flip BOTH.
    expect(api.orders.restore(b)).toThrow(404)

    // The row-shaped routes beside the aggregations — the same predicates on
    // the path that already worked, as the control for the aggregation half.
    let readBack = api.orders.getById(a)
    expect(readBack.code).toBe("O-1")
    api.orders.update(a, { code: "O-1b", total: money("20.00"), lineCount: 2, status: "Confirmed" })
    let afterUpdate = api.salesTotals.list()
    expect(decimal(afterUpdate.revenue)).toBe(20)
    let listed = api.orders.all()
    expect(listed.items.length).toBe(2)
    expect(listed.total).toBe(2)

    // HARD delete, for contrast: `crudish`'s `destroy` removes the row, so even
    // the `ignoring softDeletable` read loses it.  That is the distinction the
    // soft-delete assertions above rest on — one hides a row that is still
    // there, the other takes it away.
    api.orders.destroy(draft)
    let allTimeHard = api.allTimeVolume.list()
    expect(allTimeHard.total).toBe(2)

    // The registry aggregate, and the one assertion its scope admits.
    // `Organization` is the `tenancy by` REGISTRY, so its self-scope filter is
    // `this.id == currentUser.tenantId` — and the harness principal's claim is
    // the string "acme", not a row id.  A row created here is therefore INVISIBLE
    // to the caller that just created it: the collection read must come back
    // empty, and every id-taking route on it 404s.  That is the documented
    // `tenantRegistryRow` class, pinned rather than called.
    api.organizations.create({ name: "Acme" })
    let orgs = api.organizations.all()
    expect(orgs.total).toBe(0)
  }
}
