// shape: embedded: queryable root row, containments fold into jsonb columns.
system EmbSys {
  subdomain Shop {
    context Shop {
      aggregate Order shape: embedded, with crudish {
        customer: string
        total: money
        contains lines: LineItem[]
        entity LineItem { sku: string  qty: int }
        operation addLine(sku: string, qty: int) { lines += LineItem { sku: sku, qty: qty } }
        operation retotal(amount: money) { total := amount }
      }
      repository Orders for Order { }
      criterion OrdersByCustomer(name: string) of Order = this.customer == name
      // PAGED: a non-relational repository serves a criterion read through the
      // synthesised paged find; an unpaged `run` has no repository method there.
      queryHandler ListOrdersByCustomer(name: string): Order paged {
        let r = Orders.run(OrdersByCustomer(name))
        return r
      }
    }
  }
  api ShopApi from Shop {
    route GET "/orders/by_customer/{name}" -> Shop.ListOrdersByCustomer
  }
  storage primary { type: postgres }
  resource shopState { for: Shop, kind: state, use: primary }
  deployable d {
    platform: __PLATFORM__
    contexts: [Shop]
    dataSources: [shopState]
    serves: ShopApi
    port: 4000
  }

  // An embedded aggregate keeps a queryable root row; its `lines` collection
  // containment folds into a jsonb column, and the `money` primitive rides
  // through as a decimal string.  Create, append a line via the op, then read
  // the whole tree back — asserting the containment fold (lines.length) and the
  // root scalar (customer) both round-trip across every backend.
  test e2e "embedded aggregate folds its containment collection into the jsonb row" against d {
    let o = api.orders.create({ customer: "acme", total: "99.50" })
    api.orders.addLine(o, { sku: "A1", qty: 3 })
    let read = api.orders.getById(o)
    expect(read.customer).toBe("acme")
    expect(read.lines.length).toBe(1)

    // The canonical `update` rewrites the QUERYABLE root columns (`customer`,
    // `total`) while the jsonb-folded `lines` containment — not an update
    // param — must survive untouched.  That split is the whole point of
    // `shape: embedded`, and the update route is where it can break silently:
    // a backend re-writing the row from the update input alone empties `lines`.
    api.orders.update(o, { customer: "beta", total: "125.00" })
    let updated = api.orders.getById(o)
    expect(updated.customer).toBe("beta")
    expect(updated.lines.length).toBe(1)
    // The declared find reads the root column the update just moved.
    let byCustomer = api.shop.listOrdersByCustomer("beta")
    expect(byCustomer.items.length).toBe(1)

    // The last uncalled op on this aggregate: `retotal` writes the `money`
    // root column through an OPERATION route rather than the crudish update,
    // so the decimal round-trip is proven on both write paths.
    api.orders.retotal(o, { amount: "7.25" })
    let retotalled = api.orders.getById(o)
    expect(retotalled.total).toBe("7.2500")
    expect(retotalled.lines.length).toBe(1)

    // The root LIST route — a BARE ARRAY on `shape: embedded` (the backends
    // diverge on paging its queryable root, so the derivation keeps it
    // unbounded).  This is the bulk path: `getById` rehydrates one jsonb blob,
    // `all` rehydrates every row's blob through a different loader, so a
    // containment dropped only in bulk shows here and nowhere above.
    let listed = api.orders.all()
    expect(listed.length).toBe(1)

    // DELETE — the root row and its folded `lines` go together (one row, no
    // child table), and the declared find over the root column must stop
    // answering too.
    api.orders.destroy(o)
    expect(api.orders.getById(o)).toThrow(404)
    let empty = api.orders.all()
    expect(empty.length).toBe(0)
    let gone = api.shop.listOrdersByCustomer("beta")
    expect(gone.items.length).toBe(0)
  }
}
