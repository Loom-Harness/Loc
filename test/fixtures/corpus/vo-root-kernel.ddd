// A ROOT-LEVEL (ambient / shared-kernel) value object, nested inside a
// CONTEXT-LOCAL one — `Outer.origin: UnLocode` where `UnLocode` is declared at
// file scope, outside any context.
//
// Minted by the fixture-shape audit (https://github.com/Loom-Harness/Loc/blob/cadbe3ba12fb833565704cb9d628c8f41b2090a8/docs/audits/2026-09-29-fixture-shape-coverage.md).
// A root-level VO is the documented shared kernel and the THIRD of the three
// pools an emitter resolves a VO name through (`ctx.valueObjects`, then
// `siblingValueObjects`, then `rootValueObjects` folded in at enrichment).  In
// the whole repo only FOUR models declared one — all four under
// `web/src/examples/` — and every one of them is MULTI-FILE, while
// `react-build-cases.ts` is single-file-only by construction ("the build harness
// copies one .ddd into a temp dir", so `erp/main.ddd` and
// `fulfillment-newest.ddd` "can't be built").  So no compile gate on any backend
// or any frontend had ever seen a shared kernel.  The corpus had none at all.
//
// Two nesting DIRECTIONS ride here deliberately, because they are emitted by
// different code and only one of them was ever correct:
//
//   * root VO -> AGGREGATE field (`Shipment.tag`).  The four multi-file examples
//     had this one, so the react build gate would have covered it had it been
//     able to build them.
//   * root VO -> CONTEXT-LOCAL VO field (`Outer.origin`).  NOTHING had this, and
//     it is the ordering-sensitive one: a VO that must be emitted BEFORE the
//     context-local VO that references it, from a different pool than the one
//     the emitter walks in declaration order.
//
// This is the evaluation's F-007: an emitter that walks VOs in declaration
// order emits `Outer` before the root-level `UnLocode` it references.
//
//   react/vue/svelte  `web/src/api/<agg>.ts` emits `UnLocodeSchema` ahead of
//                     `OuterSchema`.
//   node              `http/<agg>.routes.ts` and the schema builders route
//                     through `orderValueObjectsByDependency`
//                     (src/ir/util/reachable-types.ts); declaration order would
//                     read `UnLocodeSchema` in its temporal dead zone (TS2448 /
//                     TS2454) and throw at module load.
//   python            `app/domain/value_objects.py` and `app/http/wire_models.py`
//                     order their classes the same way; declaration order is
//                     ruff `F821 Undefined name 'UnLocode'`.
//   dotnet/java       free — both hoist type declarations (a C# record / Java
//                     class has no initialisation order), so nesting direction
//                     cannot matter.  Carried as the contrast.
//   elixir            free — a VO is one `:map` (jsonb) cell, no per-VO schema
//                     const is emitted at all.
//
// The compile legs gate the ordering; the `test e2e` block gates the round
// trip of a shared-kernel value through both nesting directions, and that the
// root VO's invariant is enforced at the wire boundary in both positions.

// The shared kernel: declared at FILE scope, outside every context.
valueobject UnLocode {
  value: string
  invariant value.length == 5 message "UN/LOCODE must be 5 characters"
  derived label: string = value
}

system VoRootKernel {
  subdomain Freight {
    context Routing {
      // A CONTEXT-LOCAL value object whose own fields are the ROOT-LEVEL one.
      // The emission order that matters: `UnLocode` must come first.
      valueobject Outer {
        origin: UnLocode
        destination: UnLocode
      }

      aggregate Shipment with crudish {
        reference: string
        // root VO -> context-local VO -> aggregate (the ordering-sensitive path)
        route: Outer
        // root VO -> aggregate directly (the path the examples already had)
        tag: UnLocode
        derived display: string = reference
      }

      repository Shipments for Shipment { }
    }
  }

  api FreightApi from Freight
  storage primary { type: postgres }
  resource routingState { for: Routing, kind: state, use: primary }

  deployable d {
    platform: __PLATFORM__
    contexts: [Routing]
    dataSources: [routingState]
    serves: FreightApi
    port: 4000
  }

  test e2e "a shared-kernel value object round-trips through both nesting directions" against d {
    let sh = api.shipments.create({ reference: "SH-1", route: { origin: { value: "DEHAM" }, destination: { value: "USNYC" } }, tag: { value: "NLRTM" } })
    let read = api.shipments.getById(sh)
    expect(read.route.origin.value).toBe("DEHAM")
    expect(read.route.destination.value).toBe("USNYC")
    expect(read.tag.value).toBe("NLRTM")

    api.shipments.update(sh, { reference: "SH-2", route: { origin: { value: "FRLEH" }, destination: { value: "CNSHA" } }, tag: { value: "BEANR" } })
    let updated = api.shipments.getById(sh)
    expect(updated.route.origin.value).toBe("FRLEH")
    expect(updated.tag.value).toBe("BEANR")

    // The root VO's invariant holds wherever it is nested.
    expect(api.shipments.create({ reference: "SH-3", route: { origin: { value: "DEHAM" }, destination: { value: "USNYC" } }, tag: { value: "NL" } })).toThrow(422)
    expect(api.shipments.create({ reference: "SH-4", route: { origin: { value: "DE" }, destination: { value: "USNYC" } }, tag: { value: "NLRTM" } })).toThrow(422)
    expect(api.shipments.all().items.length).toBe(1)
    api.shipments.destroy(sh)
    expect(api.shipments.getById(sh)).toThrow(404)
  }
}
