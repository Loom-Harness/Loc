// Provenanced stored fields (provenance.md): each write to a `provenanced`
// field becomes an immutable per-write-site rule snapshot.  Backend-only;
// the value and its lineage ride the wire together as ONE `Provenanced<T>`
// carrier (`{ value, lineage }`, M-T6.12) — identical on all five backends.
system OrderingSystem {
  subdomain Ordering {
    context Ordering {
      aggregate Order with crudish {
        reference: string
        quantity: int
        unitPrice: int
        discount: int
        total: int provenanced
        operation reprice(qty: int, price: int) {
          precondition qty > 0
          precondition price >= 0
          quantity := qty
          unitPrice := price
          total := qty * price - discount
        }
        operation applyDiscount(amount: int) {
          precondition amount >= 0
          discount := amount
          total := quantity * unitPrice - amount
        }
        // A SELF-REFERENTIAL write site (PROMOTED from the per-backend
        // `*-provenance.test.ts` string copies, M-T9.42): `total` is both the
        // target and a leaf, so the lineage must snapshot the leaf's value
        // BEFORE the assignment rebinds it.  A capture placed after the write
        // records the NEW total as its own input — a lineage that explains the
        // result by the result.
        operation adjust(delta: int) {
          precondition delta >= 0
          total := total + delta
        }

        // Pure-domain (unit) test — INTEGER arithmetic through an operation
        // (`total := qty * price - discount`, all `int`) gated by two
        // preconditions: a distinct cross-backend coercion surface from the
        // decimal/money arithmetic the other corpus domain tests cover.
        test "reprice recomputes the integer total" {
          let o = Order.create({ reference: "R1", quantity: 2, unitPrice: 50, discount: 10, total: 90 })
          expect(o.total).toBe(90)
          o.reprice(3, 40)
          expect(o.quantity).toBe(3)
          expect(o.total).toBe(110)
        }
      }
      repository Orders for Order {
        find byReference(reference: string): Order? where this.reference == reference
      }
    }
  }
  api OrderingApi from Ordering
  storage primary { type: postgres }
  resource orderingState { for: Ordering, kind: state, use: primary }
  deployable d {
    platform: __PLATFORM__
    contexts: [Ordering]
    dataSources: [orderingState]
    serves: OrderingApi
    port: 4000
  }

  test e2e "provenanced total updates through an operation" against d {
    let o = api.orders.create({ reference: "R1", quantity: 2, unitPrice: 50, discount: 0, total: 100 })
    api.orders.reprice(o, { qty: 3, price: 40 })
    let read = api.orders.getById(o)
    expect(read.reference).toBe("R1")
    // `total` is `provenanced`, so it ships as the `Provenanced<T>` wire carrier
    // `{ value, lineage }` (M-T6.12) — the figure is behind `.value` on every
    // backend, and the lineage travels with it instead of in a sibling key.
    expect(read.total.value).toBe(120)

    // A THIRD write site for the same `provenanced` field, reached through the
    // canonical `update` rather than through a domain operation.  `total` is an
    // ordinary update param, so the crudish path writes a provenanced field
    // DIRECTLY — the write site the provenance snapshot has to attribute to
    // `update`, and the one no test drove.
    api.orders.update(o, { reference: "R2", quantity: 4, unitPrice: 30, discount: 0, total: 120 })
    let updated = api.orders.getById(o)
    expect(updated.reference).toBe("R2")
    expect(updated.quantity).toBe(4)
    expect(updated.total.value).toBe(120)

    // Free adjacents: the second domain write site recomputes the same field
    // from the values the update just stored, and the declared find keys on the
    // column the update moved.
    api.orders.applyDiscount(o, { amount: 20 })
    let discounted = api.orders.getById(o)
    expect(discounted.total.value).toBe(100)
    let byRef = api.orders.byReference({ reference: "R2" })
    expect(byRef.total.value).toBe(100)

    // The lineage rides INSIDE the field's own carrier, and names this write
    // site's leaves with the values they held when the rule ran.  `adjust`
    // reads `total` (100) to write `total` (105): the input must say 100.
    api.orders.adjust(o, { delta: 5 })
    let adjusted = api.orders.getById(o)
    expect(adjusted.total.value).toBe(105)
    expect(adjusted.total.lineage.computedValue).toBe(105)
    expect(adjusted.total.lineage.target.field).toBe("total")
    expect(adjusted.total.lineage.inputs.where(i => i.path == "total").first().value).toBe(100)
    expect(adjusted.total.lineage.inputs.where(i => i.path == "delta").first().value).toBe(5)

    // The LIST route reads the same provenanced column in bulk — three write
    // sites have now touched `total` (a domain op, the crudish update, a second
    // op) and the collection projection has to carry the final value like every
    // other read does.
    let listed = api.orders.all()
    expect(listed.items.length).toBe(1)
    expect(listed.total).toBe(1)

    api.orders.destroy(o)
    expect(api.orders.getById(o)).toThrow(404)
    expect(api.orders.byReference({ reference: "R2" })).toThrow(404)
    let empty = api.orders.all()
    expect(empty.items.length).toBe(0)
    expect(empty.total).toBe(0)
  }
}
