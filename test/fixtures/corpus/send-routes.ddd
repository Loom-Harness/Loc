// A route `send`s the request record; the record's one handler catches it.
// Path placeholders, the query string (GET) and the JSON body bind to the
// record's fields by name, so `ShipOrder` takes `id` from the path and
// `carrier` from the body, and `GetOrderCarrier` takes `id` from the path and
// `prefix` from the query string.
system SendRoutes {
  subdomain Sales {
    context Ordering {
      aggregate Order with crudish {
        code: string
        carrier: string = ""
        paid: int = 0
        operation ship(c: string) { carrier := c }
        operation settle(): int or Unsettled {
          paid := paid + 1
          if paid > 2 {
            return Unsettled { code: code }
          }
          return paid
        }
      }
      error Unsettled { code: string }
      repository Orders for Order { }

      command ShipOrder { id: Order id  carrier: string }
      commandHandler ShipOrderHandler(cmd: ShipOrder) {
        let o = Orders.get(cmd.id)
        o.ship(cmd.carrier)
      }

      command SettleOrder { id: Order id  note: string }
      commandHandler SettleOrderHandler(cmd: SettleOrder): int or Unsettled {
        let o = Orders.get(cmd.id)
        let r = o.settle()
        match r { int v => { return v }  Unsettled v => { return v } }
      }

      query GetOrderCarrier { id: Order id  prefix: string }
      queryHandler GetOrderCarrierHandler(q: GetOrderCarrier): string {
        let o = Orders.get(q.id)
        return q.prefix + o.carrier
      }
    }
  }

  api SalesApi from Sales {
    httpStatus Unsettled -> 409
    route POST "/orders/{id}/dispatch" send Ordering.ShipOrder
    route POST "/orders/{id}/settle" send Ordering.SettleOrder
    route GET "/orders/{id}/carrier" send Ordering.GetOrderCarrier
  }
  storage pg { type: postgres }
  resource st { for: Ordering, kind: state, use: pg }

  deployable d {
    platform: __PLATFORM__
    contexts: [Ordering]
    dataSources: [st]
    serves: SalesApi
    port: 4000
  }

  test e2e "a sent record binds its path, body and query-string fields" against d {
    let o = api.orders.create({ code: "A-1" })
    api.ordering.shipOrderHandler({ id: o.id, carrier: "DHL" })
    expect(api.orders.getById(o).carrier).toBe("DHL")
    expect(api.ordering.getOrderCarrierHandler({ id: o.id, prefix: "via " })).toBe("via DHL")
    api.ordering.shipOrderHandler({ id: o.id, carrier: "UPS" })
    expect(api.ordering.getOrderCarrierHandler({ id: o.id, prefix: "by " })).toBe("by UPS")
    // An expected failure behind a sent record: the success arm answers its
    // tagged value and persists; the error arm answers its mapped status and
    // rolls the command back.
    let settled = api.ordering.settleOrderHandler({ id: o.id, note: "a" })
    expect(settled.type).toBe("int")
    expect(settled.value).toBe(1)
    expect(api.ordering.settleOrderHandler({ id: o.id, note: "b" }).value).toBe(2)
    expect(api.ordering.settleOrderHandler({ id: o.id, note: "c" })).toThrow(409)
    expect(api.orders.getById(o).paid).toBe(2)
    // The derived routes the aggregate also serves agree with the sent ones.
    api.orders.ship(o, { c: "FedEx" })
    expect(api.ordering.getOrderCarrierHandler({ id: o.id, prefix: "now " })).toBe("now FedEx")
    api.orders.update(o, { code: "A-2", carrier: "FedEx" })
    expect(api.orders.all().total).toBe(1)
    api.orders.destroy(o)
    expect(api.orders.all().total).toBe(0)
  }
}
