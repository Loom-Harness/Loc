// Can a folded projection fan out ONE event to MANY rows (one per follower)?
context Community {
  aggregate Member { displayName: string  derived display: string = displayName }
  aggregate Follow { follower: Member id  followee: Member id }
  aggregate Post { author: Member id  title: string
    operation publish() { emit PostPublished { post: id, author: author, at: now() } } }
  event PostPublished { post: Post id, author: Member id, at: datetime }
  channel Feed { carries: PostPublished, delivery: broadcast, retention: log }

  projection NotificationFeed keyed by member {
    member: Member id
    unread: int
    on(e: PostPublished) by e.author { unread := unread + 1 }
  }
  repository Members for Member { }
  repository Posts for Post { }
  repository Follows for Follow { }
}
