system R {
  user { id: string  role: string  permissions: string[]  agentId: Agent id? }
  auth { oidc { issuer: env("OIDC_ISSUER") clientId: env("OIDC_CLIENT_ID") audience: env("OIDC_AUDIENCE") } }
  subdomain S {
    context A { aggregate Agent with crudish(requires: Ok) { name: string } repository Agents for Agent { } policy Ok(): bool = currentUser.role == "x" }
    context B { event Ping { pay: Pay id }
      aggregate Pay with crudish(requires: Ok2) { amount: money } repository Pays for Pay { }
      policy Ok2(): bool = currentUser.role == "x"
      workflow Wf requires currentUser.role == "x" { k: Pay id  create(e: Ping) by e.pay { let p = Pay.create({ amount: money("1") }) } }
    }
  }
  storage primary { type: postgres }
  resource a { for: A, kind: state, use: primary }
  resource b { for: B, kind: state, use: primary }
  deployable api { platform: node, contexts: [A], dataSources: [a], auth: required, port: 3000 }
  deployable pay { platform: PLATFORM, contexts: [B], dataSources: [b], auth: required, port: 3002 }
}
