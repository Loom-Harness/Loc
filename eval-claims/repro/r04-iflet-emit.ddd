system R { subdomain S { context A {
  aggregate P with crudish { name: string }
  aggregate Q { name: string }
  repository Ps for P { }
  repository Qs for Q { }
  criterion Named(n: string) of P = name == n
  event Hit { at: datetime }
  workflow W transactional { create(n: string) {
    if let p = Ps.find(Named(n)) { emit Hit { at: now() } } else { precondition false message "nope" }
  } }
  workflow MakeQ { create(n: string) { let q = Q.create({ name: n }) } }
} }
  storage primary { type: postgres }
  resource a { for: A, kind: state, use: primary }
  deployable api { platform: PLATFORM, contexts: [A], dataSources: [a], port: 3000 }
}
