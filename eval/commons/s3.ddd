// Commons — slice 3: adds Media + scanning, notifications, GDPR erasure,
// moderation audit trail, and the auth/role surface.
system Commons {

  subdomain Social {

    permissions {
      read
      post
      moderate
      admin implies [read, post, moderate]
    }

    context Community {

      enum Visibility { Public, MembersOnly, GroupOnly }
      enum GroupRole { Owner, Moderator, Member }
      enum ReactionKind { Like, Celebrate, Insightful }
      enum MediaState { Pending, Clean, Infected }

      event PostPublished { post: Post id, author: Member id, at: datetime }
      event CommentAdded { comment: Comment id, post: Post id, author: Member id, replyTo: Member id?, at: datetime }
      event MemberErased { member: Member id, at: datetime }

      aggregate Member with auditable {
        displayName: string
        email: string secret
        phone: string? secret
        bio: string?
        erased: bool internal = false
        derived display: string = displayName
        invariant displayName.length > 0

        // GDPR erasure: scrub PII in place, keep the row so FKs survive.
        operation erase() {
          precondition !erased
          displayName := "[deleted member]"
          email := ""
          phone := null
          bio := null
          erased := true
          emit MemberErased { member: id, at: now() }
        }
      }

      aggregate Group {
        name: string
        description: string
        contains members: GroupMembership[]
        derived display: string = name
        derived memberCount: int = members.count

        operation addMember(who: Member id, role: GroupRole) {
          precondition members.all(m => m.who != who)
          members += GroupMembership { who: who, role: role, joinedAt: now() }
        }

        entity GroupMembership {
          who: Member id
          role: GroupRole
          joinedAt: datetime
        }
      }

      aggregate Follow {
        follower: Member id
        followee: Member id
        at: datetime managed
        unique (follower, followee)
      }

      aggregate Media {
        uploader: Member id
        caption: string
        derived display: string = caption
        file: File
        state: MediaState = Pending
        scannedAt: datetime?
        derived visible: bool = state == Clean

        operation markClean() {
          precondition state == Pending
          state := Clean
          scannedAt := now()
        }
        operation markInfected() {
          precondition state == Pending
          state := Infected
          scannedAt := now()
        }
      }

      aggregate Post with softDeletable {
        author: Member id
        group: Group id?
        title: string
        body: string
        visibility: Visibility
        media: Media id[]
        publishedAt: datetime managed
        derived display: string = title
        invariant title.length > 0

        operation publish() {
          emit PostPublished { post: id, author: author, at: now() }
        }
      }

      aggregate Comment with softDeletable {
        post: Post id
        parent: Comment id?
        author: Member id
        body: string
        depth: int = 0
        createdAt: datetime managed
        derived display: string = body
        invariant body.length > 0
      }

      aggregate Reaction {
        post: Post id
        who: Member id
        kind: ReactionKind
        at: datetime managed
        unique (post, who)
      }

      repository Members for Member { }
      repository Groups for Group { }
      repository Follows for Follow { }
      repository Posts for Post {
        find byAuthor(a: Member id): Post paged where this.author == a
      }
      repository Comments for Comment {
        find forPost(p: Post id): Comment paged where this.post == p
      }
      repository Reactions for Reaction { }
      repository Medias for Media { }
    }

    // Moderation lives in its own context: its decisions must SURVIVE the
    // erasure of the member they are about.
    context Moderation {

      enum ReportReason { Spam, Harassment, Illegal, Other }
      enum ModerationOutcome { Pending, Upheld, Dismissed }
      enum AppealState { None, Requested, Granted, Denied }

      aggregate Report audited {
        post: Post id?
        comment: Comment id?
        reporter: Member id
        reason: ReportReason
        detail: string
        outcome: ModerationOutcome = Pending
        decidedBy: Member id?
        decidedAt: datetime?
        createdAt: datetime managed

        function isOpen(): bool = outcome == Pending

        operation uphold(moderator: Member id, note: string) audited {
          precondition isOpen()
          outcome := Upheld
          decidedBy := moderator
          decidedAt := now()
        }

        operation dismiss(moderator: Member id, note: string) audited {
          precondition isOpen()
          outcome := Dismissed
          decidedBy := moderator
          decidedAt := now()
        }
      }

      aggregate Ban audited {
        who: Member id
        reason: string
        startedAt: datetime
        endsAt: datetime
        appeal: AppealState = None
        appealNote: string?

        derived active: bool = now() < endsAt
        invariant endsAt > startedAt

        operation requestAppeal(note: string) {
          precondition appeal == None
          appeal := Requested
          appealNote := note
        }

        operation decideAppeal(grant: bool) audited {
          precondition appeal == Requested
          appeal := grant ? Granted : Denied
        }
      }

      repository Reports for Report { }
      repository Bans for Ban { }
    }
  }

  user {
    id: string
    role: string
    sub: string
    permissions: string[]
  }

  auth {
    provider: keycloak
    oidc {
      issuer: env("OIDC_ISSUER")
      clientId: "commons-web"
      clientSecret: env("OIDC_CLIENT_SECRET")
      audience: "commons-api"
      scopes: ["openid", "profile", "email"]
    }
    sessions: cookie
    claims: {
      role: "role",
      permissions: "realm_access.roles"
    }
  }

  storage primary { type: postgres }
  storage blobs   { type: localDisk }

  resource communityState  { for: Community,  kind: state, use: primary }
  resource moderationState { for: Moderation, kind: state, use: primary }
  resource mediaStore      { for: Community,  kind: objectStore, use: blobs }

  deployable api {
    platform: node
    contexts: [Community, Moderation]
    dataSources: [communityState, moderationState, mediaStore]
    auth: required
    port: 3000
  }

  ui Web with scaffold(subdomains: [Social]) { }

  deployable web {
    platform: react
    targets: api
    ui: Web
    design: mantine
    auth: ui
    port: 3001
  }
}
