system Mv {
  subdomain S {
    context C { aggregate Thing with crudish { alpha: string?  derived display: string = "t" }  repository Things for Thing { } }
    context D { aggregate Other with crudish { z: string?  derived display: string = "o" }  repository Others for Other { } }
  }
  storage primary { type: postgres }
  resource cState { for: C, kind: state, use: primary }
  resource dState { for: D, kind: state, use: primary }
  deployable api { platform: node, contexts: [C, D], dataSources: [cState, dState], port: 3500 }
}
