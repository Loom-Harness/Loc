// 6. duplicate declaration names
system X {
  subdomain S {
    context C {
      aggregate Order with crudish { a: int  derived display: string = "x" }
      aggregate Order with crudish { b: int  derived display: string = "y" }
      repository Orders for Order { }
    }
  }
  storage p { type: postgres }
  resource r { for: C, kind: state, use: p }
  deployable api { platform: node, contexts: [C], dataSources: [r], port: 3000 }
}
