// F-006 — a query-time projection aggregating a DERIVED (non-column) field.
system ProjDerived {
  subdomain S {
    context C {
      valueobject Money { amount: money  currency: string }
      aggregate Order {
        qty: int
        unitPrice: money
        derived total: money = unitPrice * qty          // NOT a column
        derived display: string = `o {qty}`
      }
      repository Orders for Order { }
      projection OrderTotals {
        rowCount: int
        totalSum: money
        from Order as o
        select rowCount = count(), totalSum = sum(o.total)   // sum over a derived
      }
    }
  }
  storage primary { type: postgres }
  resource st { for: C, kind: state, use: primary }
  deployable api { platform: node contexts: [C] dataSources: [st] port: 3000 }
}
