// F-021 — an OPTIONAL cross-aggregate reference on a contained part renders as
// a router-link `:title` on Vue, which rejects `string | null | undefined`.
// The identical model builds on React, Angular and Svelte.
system VueOpt {
  subdomain S {
    context C {
      aggregate Tag with crudish { label: string  derived display: string = label }
      repository Tags for Tag { }
      aggregate Note with crudish {
        title: string
        derived display: string = title
        contains lines: NoteLine[]
        entity NoteLine {
          text: string
          tag: Tag id?
        }
      }
      repository Notes for Note { }
    }
  }
  ui Web with scaffold(subdomains: [S]) { framework: vue }
  storage primary { type: postgres }
  resource st { for: C, kind: state, use: primary }
  deployable api { platform: node contexts: [C] dataSources: [st] port: 3000 }
  deployable web { platform: vue targets: api ui: Web port: 3002 design: vuetify }
}
