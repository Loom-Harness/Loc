// A `let` that appears AFTER a `for` statement in a workflow body is not visible.
system X { subdomain S { context C {
  aggregate Thing { n: int  operation bump() { n := n + 1 } }
  criterion All() of Thing = this.n >= 0
  repository Things for Thing { }
  workflow before transactional {          // let BEFORE the for  → OK
    create(id0: Thing id) {
      let t = Things.getById(id0)
      let xs = Things.run(All(), page: { offset: 0, limit: 10 })
      for i in xs { i.bump() }
      t.bump()
    }
  }
} } storage p { type: postgres } resource r { for: C, kind: state, use: p }
  deployable api { platform: node, contexts: [C], dataSources: [r], port: 3000 } }
