// F-038 — switching an abstract aggregate from TPH to TPC is IMPOSSIBLE if any
// aggregate references the base by `Base id` — which is the normal way to model
// "things that hang off a claim/order/case". Flip `sharedTable` -> `ownTable`
// below and all references become hard errors with no polymorphic alternative.
system Tpc {
  subdomain S { context C {
    abstract aggregate Claim inheritanceUsing: sharedTable {
      reference: string
      derived display: string = reference
    }
    aggregate AutoClaim extends Claim with crudish { vin: string }
    aggregate PropertyClaim extends Claim with crudish { addressLine: string }

    // the thing that makes TPC unreachable:
    aggregate Payout with crudish { claim: Claim id  amount: money }
    repository Payouts for Payout { }
  } }
  storage primary { type: postgres }
  resource st { for: C, kind: state, use: primary }
  deployable api { platform: node contexts: [C] dataSources: [st] port: 3000 }
}
