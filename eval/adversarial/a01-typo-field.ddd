system A { subdomain S { context C {
  aggregate Order { total: int  derived display: string = "o"
    derived doubled: int = totl * 2 }
  repository Orders for Order { } } }
  storage p { type: postgres }  resource st { for: C, kind: state, use: p }
  deployable api { platform: node contexts: [C] dataSources: [st] port: 3000 } }
