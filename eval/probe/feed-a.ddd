// Attempt A: projection joining Post to the follow graph.
context Community {
  aggregate Member { displayName: string  derived display: string = displayName }
  aggregate Follow { follower: Member id  followee: Member id }
  aggregate Post { author: Member id  title: string  createdAt: datetime }

  projection HomeFeed {
    postId: Post id
    title: string
    from Post as p
    where f.follower == currentUser.id
    join Follow as f on p.author
    select postId = p.id, title = p.title
  }
  repository Members for Member { }
  repository Posts for Post { }
  repository Follows for Follow { }
}
