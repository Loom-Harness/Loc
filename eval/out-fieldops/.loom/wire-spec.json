        "currency": {
          "type": "string"
        },
        "scheduledAt": {
          "type": "string",
          "format": "date-time"
        },
        "startedAt": {
          "type": "string",
          "format": "date-time"
        },
        "completedAt": {
          "type": "string",
          "format": "date-time"
        },
        "resolutionNote": {
          "type": "string"
        },
        "tenantId": {
          "type": "string"
        },
        "version": {
          "type": "integer"
        },
        "lines": {
          "type": "array",
