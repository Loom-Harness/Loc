      repository Nodes14 for Node14 { }
      criterion Active14() of Node14 = active == true
      retrieval ActiveNodes14() of Node14 { where: Active14() sort: [label asc] }

      aggregate Link14 with tenantOwned, crudish {
        owner: Node14 id
        tag:  string
        derived display: string = tag
      }
      repository Links14 for Link14 { }
    }

    context Notify {
      aggregate Notification with tenantOwned, crudish {
        workOrder: WorkOrder id
        body:      string
        sentAt:    datetime
        derived display: string = body
      }
      repository Notifications for Notification { }

      workflow notifyOnCompletion {
        workOrderId: WorkOrder id

        create(e: WorkOrderCompleted) by e.workOrder {
          let n = Notification.create({
            workOrder: e.workOrder,
            body: `Work order {e.workOrder} completed`,
            sentAt: e.at
          })
        }
      }
    }

  storage primary { type: postgres }
  storage bus       { type: redis }
  storage photoBlob { type: s3,   config: { bucket: "fieldops-photos", region: "eu-central-1" } }
  storage payGw     { type: restApi, config: { baseUrl: "https://pay.example.com" } }
  storage mailGw    { type: smtp,  config: { from: "no-reply@fieldops.example" } }
  resource accountsState { for: Accounts, kind: state, use: primary }
  resource opsState      { for: Ops,      kind: state, use: primary,
                           index: [WorkOrder.assignedUserId, WorkOrder.(status, scheduledAt)] }
  resource notifyState   { for: Notify,   kind: state, use: primary }
  resource ext1State { for: Ext1, kind: state, use: primary }
  resource ext2State { for: Ext2, kind: state, use: primary }
  resource ext3State { for: Ext3, kind: state, use: primary }
  resource ext4State { for: Ext4, kind: state, use: primary }
  resource ext5State { for: Ext5, kind: state, use: primary }
  resource ext6State { for: Ext6, kind: state, use: primary }
  resource ext7State { for: Ext7, kind: state, use: primary }
  resource ext8State { for: Ext8, kind: state, use: primary }
  resource ext9State { for: Ext9, kind: state, use: primary }
  resource ext10State { for: Ext10, kind: state, use: primary }
  resource ext11State { for: Ext11, kind: state, use: primary }
  resource ext12State { for: Ext12, kind: state, use: primary }
  resource ext13State { for: Ext13, kind: state, use: primary }
  resource ext14State { for: Ext14, kind: state, use: primary }
  resource photos        { for: Ops, kind: objectStore, use: photoBlob }
  resource payments      { for: Ops, kind: api,         use: payGw }
  resource mail          { for: Ops, kind: mailer,      use: mailGw }
  channelSource lifecycleBus { for: WorkOrderLifecycle, use: bus }

  ui Web with scaffold(subdomains: [Field]) { }

  test e2e "work order lifecycle through the API" against api verifies TC-001 {
    let c = api.customers.create({ name: "Northwind", billingEmail: "ap@northwind.test" })
    let s = api.sites.create({ customer: c.id, label: "HQ", addressLine: "1 Main St" })
    let a = api.assets.create({ site: s.id, serial: "SN-1", model: "Chiller", requiredSkill: "HVAC" })
    let wo = api.workOrders.create({ asset: a.id, status: "Draft", totalAmount: "0.00" })
    api.workOrders.addLine(wo, { kind: "Labour", description: "Diagnose", qty: 2, unitPrice: { amount: "50.00", currency: "USD" } })
    let read = api.workOrders.getById(wo)
    expect(read.status).toBe("Draft")
    expect(read.lines.length).toBe(1)
  }

  test e2e "an empty-currency line is rejected" against api {
    let c = api.customers.create({ name: "Acme", billingEmail: "ap@acme.test" })
    expect(api.customers.create({ name: "", billingEmail: "x@y.test" })).toThrow(422)
  }

  test e2e "browse work orders in the UI" against web verifies TC-003 {
    let c = ui.customers.create({ name: "Contoso", billingEmail: "ap@contoso.test" })
    let read = ui.customers.getById(c)
    expect(read.name).toBe("Contoso")
  }

  deployable api {
    platform: node
    contexts: [Accounts, Ops, Ext1, Ext2, Ext3, Ext4, Ext5, Ext6, Ext7, Ext8, Ext9, Ext10, Ext11, Ext12, Ext13, Ext14]
    dataSources: [accountsState, opsState, photos, payments, mail, ext1State, ext2State, ext3State, ext4State, ext5State, ext6State, ext7State, ext8State, ext9State, ext10State, ext11State, ext12State, ext13State, ext14State]
    channels: [lifecycleBus]
    auth: required
    port: 3000
  }

  deployable notifier {
    platform: node
    contexts: [Notify]
    dataSources: [notifyState]
    channels: [lifecycleBus]
    auth: required
    port: 3002
  }

  deployable web {
    platform: react
    targets: api
    ui: Web
    auth: ui
    port: 3001
    design: mantine
  }
}
